---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { clinic } from '../data/clinic';
import '../styles/global.css';
import '../styles/calm.css';
import CalmHeader from '../components/calm/CalmHeader.astro';
import CalmFooter from '../components/calm/CalmFooter.astro';
import CalmMobileBar from '../components/calm/CalmMobileBar.astro';
const base = import.meta.env.BASE_URL;

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Calm design: own header, footer, phone bar and typeface. */
  calm?: boolean;
}

const {
  title,
  description = 'McKenzie Gyógytorna Rendelő Budapesten, a V. és a XI. kerületben. Derékfájás, nyakfájás és porckorongsérv kezelése McKenzie-módszerrel, 1-2 napon belüli időponttal.',
  ogImage = `${base}images/og-default.jpg`,
  calm = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteRoot = new URL(base, Astro.site).href;

// Only the production domains are indexable; previews (redesign subdomain, GitHub Pages) stay out of search.
const PRODUCTION_HOSTS = ['gyogytornarendelo.hu', 'www.gyogytornarendelo.hu', 'mckenzie.hu', 'www.mckenzie.hu'];
const isPreview = !PRODUCTION_HOSTS.includes(Astro.site?.hostname ?? '');

// One entity graph: the organisation, its two clinics and the lead therapist.
// No aggregateRating: Google ignores self-served review stars on a LocalBusiness and forbids
// marking up ratings collected elsewhere. The page shows the Google score and links the profiles.
const orgId = `${siteRoot}#org`;
const SERVICES = [
  'McKenzie-módszer (Mechanical Diagnosis and Therapy)', 'Manuálterápia (Maitland, Mulligan)', 'Stabilizációs tréning',
  'Schroth-terápia', 'Műtét előtti és utáni rehabilitáció', 'Tartásjavítás', 'Kineziológiai taping', 'Gyógyászati nyújtás',
  'Ízületi fájdalmak gyógytornája',
];
const pagePath = Astro.url.pathname.replace(base, '').replace(/\/$/, '');
const breadcrumb = pagePath
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Főoldal', item: siteRoot },
        { '@type': 'ListItem', position: 2, name: title.split(' | ')[0], item: canonicalURL.href },
      ],
    }
  : null;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MedicalOrganization',
      '@id': orgId,
      name: clinic.name,
      legalName: clinic.legalName,
      url: siteRoot,
      logo: `${siteRoot}images/logo.png`,
      telephone: clinic.phone,
      email: clinic.email,
      foundingDate: '1993',
      sameAs: clinic.sameAs,
      medicalSpecialty: 'https://schema.org/Physiotherapy',
      founder: { '@id': `${siteRoot}#relle-eva` },
      numberOfEmployees: { '@type': 'QuantitativeValue', value: clinic.therapists },
      subOrganization: clinic.locations.map((l) => ({ '@id': `${siteRoot}#${l.id}` })),
      makesOffer: [
        {
          '@type': 'Offer',
          name: `${clinic.prices.single.label}, ${clinic.prices.single.duration}`,
          priceSpecification: { '@type': 'PriceSpecification', minPrice: clinic.prices.single.min, maxPrice: clinic.prices.single.max, priceCurrency: 'HUF' },
          itemOffered: { '@type': 'MedicalTherapy', name: 'Egyéni gyógytorna McKenzie-módszerrel (mozgásvizsgálat, kezelés, otthoni gyakorlatsor)' },
        },
        {
          '@type': 'Offer',
          name: clinic.prices.pass.label,
          price: clinic.prices.pass.value,
          priceCurrency: 'HUF',
          itemOffered: { '@type': 'MedicalTherapy', name: '5 egyéni gyógytorna-kezelés' },
        },
      ],
    },
    ...clinic.locations.map((l) => ({
      '@type': 'MedicalClinic',
      '@id': `${siteRoot}#${l.id}`,
      name: `${clinic.name}, ${l.name}`,
      alternateName: l.googleName,
      parentOrganization: { '@id': orgId },
      url: `${siteRoot}kapcsolat#${l.id}`,
      telephone: clinic.phone,
      medicalSpecialty: 'https://schema.org/Physiotherapy',
      priceRange: `${clinic.prices.single.min}-${clinic.prices.single.max} HUF`,
      openingHours: clinic.hours.schema,
      isAcceptingNewPatients: true,
      paymentAccepted: 'Készpénz, bankkártya',
      currenciesAccepted: 'HUF',
      areaServed: { '@type': 'City', name: 'Budapest' },
      availableService: SERVICES.map((name) => ({ '@type': 'MedicalTherapy', name })),
      hasMap: l.mapsUrl,
      sameAs: [l.mapsUrl],
      geo: { '@type': 'GeoCoordinates', latitude: l.geo.lat, longitude: l.geo.lng },
      address: {
        '@type': 'PostalAddress',
        streetAddress: l.street,
        addressLocality: 'Budapest',
        postalCode: l.postalCode,
        addressCountry: 'HU',
      },
    })),
    {
      '@type': 'Person',
      '@id': `${siteRoot}#relle-eva`,
      name: 'Relle Éva',
      jobTitle: 'Alapító, vezető gyógytornász',
      worksFor: { '@id': orgId },
      knowsLanguage: ['hu', 'en', 'de'],
      hasCredential: {
        '@type': 'EducationalOccupationalCredential',
        name: 'McKenzie nemzetközi minősítővizsga (Credentialing Examination)',
        recognizedBy: { '@type': 'Organization', name: 'McKenzie Institute International', url: 'https://www.mckenzieinstitute.org' },
      },
      memberOf: { '@type': 'Organization', name: 'Magyarországi McKenzie Intézet Alapítvány', url: 'https://hu.mckenzieinstitute.org' },
      affiliation: { '@type': 'CollegeOrUniversity', name: 'Semmelweis Egyetem Egészségtudományi Kar' },
    },
    ...(breadcrumb ? [breadcrumb] : []),
  ],
};
---

<!DOCTYPE html>
<html lang="hu">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0A2118" />

  {isPreview && <meta name="robots" content="noindex, nofollow" />}

  <link rel="canonical" href={canonicalURL.href} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
  <meta property="og:locale" content="hu_HU" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />

  {calm && <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&display=swap" rel="stylesheet" />}
  <link rel="icon" type="image/png" href={`${base}images/logo.png`} />

  <title>{title}</title>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <slot name="head" />
</head>
<body class:list={calm ? ["calm"] : ["antialiased bg-[var(--color-paper)] text-[var(--color-ink)]"]}>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-white focus:px-4 focus:py-2 focus:rounded">Ugrás a tartalomra</a>
  {calm ? <CalmHeader /> : <Navbar />}
  <main id="main" class="pb-20 lg:pb-0">
    <slot />
  </main>
  {calm ? <CalmFooter /> : <Footer />}
  {calm ? <CalmMobileBar /> : <MobileCta />}
  <ScrollReveal />
</body>
</html>
