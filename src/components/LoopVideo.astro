---
// Muted ambient loop. Loads nothing until near the viewport, plays only while visible,
// and stays on the poster frame for visitors who prefer reduced motion.
interface Props { name: string; label: string; class?: string; eager?: boolean }
const { name, label, class: cls = '', eager = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<video
  class:list={['loop-video', cls]}
  src={eager ? `${base}video/${name}.mp4` : undefined}
  data-src={`${base}video/${name}.mp4`}
  poster={`${base}video/${name}.jpg`}
  muted
  loop
  playsinline
  preload={eager ? 'auto' : 'none'}
  autoplay={eager}
  aria-label={label}
></video>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) {
        if (!v.src) v.src = v.dataset.src!;
        if (!reduce) v.play().catch(() => {});
      } else {
        v.pause();
      }
    }
  }, { rootMargin: '200px 0px' });
  document.querySelectorAll<HTMLVideoElement>('video.loop-video').forEach((v) => {
    if (reduce) { v.removeAttribute('autoplay'); v.pause(); }
    io.observe(v);
  });
</script>
