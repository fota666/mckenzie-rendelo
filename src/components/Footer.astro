---
import LogoMark from './LogoMark.astro';
import { clinic } from '../data/clinic';
import { conditions } from '../data/conditions';
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const links = [
  { href: `${base}modszerek`, label: 'Módszerek' },
  { href: `${base}csapatunk`, label: 'Csapatunk' },
  { href: `${base}araink`, label: 'Árak' },
  { href: `${base}velemenyek`, label: 'Vélemények' },
  { href: `${base}gyik`, label: 'Gyakori kérdések' },
  { href: `${base}kapcsolat`, label: 'Kapcsolat' },
];
const conditionLinks = conditions.map((c) => ({ href: `${base}${c.slug}`, label: c.name }));
---

<footer class="bg-[var(--color-navy-950)] text-white/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-10">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <div class="flex items-center gap-3 text-white">
          <LogoMark class="w-10 h-10" />
          <span class="leading-tight">
            <span class="block font-heading text-[1.65rem] font-semibold">McKenzie</span>
            <span class="block font-mono text-[0.72rem] tracking-[0.18em] uppercase text-white/60">Gyógytorna Rendelő</span>
          </span>
        </div>
        <p class="mt-6 text-[15px] leading-relaxed text-white/60 max-w-xs">
          {clinic.tagline}. {clinic.therapists} gyógytornász, két rendelő, rendelés {clinic.hoursText}.
        </p>
        <a href={`tel:${clinic.phone}`} class="mt-6 inline-block font-heading text-[1.65rem] text-white hover:text-[var(--color-gold-300)]">{clinic.phoneDisplay}</a>
      </div>

      {clinic.locations.map((l) => (
        <address class="not-italic lg:col-span-4 text-[15px] space-y-1.5">
          <p class="eyebrow eyebrow-light mb-4">{l.name}</p>
          <p class="text-white">{l.postalCode} Budapest, {l.street}</p>
          <p>{l.transit}</p>
          <p>Parkolás: {l.parking}</p>
          <a href={l.mapsUrl} target="_blank" rel="noopener" class="link-arrow mt-3 text-white">Útvonal <span aria-hidden="true">&rarr;</span></a>
        </address>
      ))}

    </div>

    <nav class="mt-10 pt-8 border-t border-white/10 grid gap-x-10 gap-y-8 lg:grid-cols-12 text-[15px]" aria-label="Lábléc navigáció">
      <div class="lg:col-span-8">
        <p class="eyebrow eyebrow-light mb-4">Panaszok</p>
        <ul class="grid grid-cols-2 sm:grid-cols-3 gap-x-8 gap-y-2">
          {conditionLinks.map((l) => <li><a href={l.href} class="hover:text-white">{l.label}</a></li>)}
        </ul>
      </div>
      <div class="lg:col-span-4">
        <p class="eyebrow eyebrow-light mb-4">Oldalak</p>
        <ul class="grid grid-cols-2 gap-x-8 gap-y-2">
          {links.map((l) => <li><a href={l.href} class="hover:text-white">{l.label}</a></li>)}
        </ul>
      </div>
    </nav>

    <div class="mt-7 pt-6 border-t border-white/10 flex flex-col sm:flex-row gap-4 justify-between text-[13px] text-white/50">
      <p>&copy; {year} {clinic.legalName} &middot; {clinic.name}</p>
      <div class="flex items-center gap-6">
        <a href={`${base}adatvedelmi-tajekoztato`} class="hover:text-white">Adatvédelmi tájékoztató</a>
        <a href={clinic.sameAs[0]} target="_blank" rel="noopener" class="hover:text-white">Facebook</a>
        <a href={clinic.sameAs[1]} target="_blank" rel="noopener" class="hover:text-white">Instagram</a>
      </div>
    </div>
  </div>
</footer>
