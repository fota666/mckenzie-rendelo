---
import LogoMark from './LogoMark.astro';
import { clinic } from '../data/clinic';
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const links = [
  { href: `${base}modszerek`, label: 'Módszerek' },
  { href: `${base}csapatunk`, label: 'Csapatunk' },
  { href: `${base}araink`, label: 'Árak' },
  { href: `${base}velemenyek`, label: 'Vélemények' },
  { href: `${base}gyik`, label: 'Gyakori kérdések' },
  { href: `${base}kapcsolat`, label: 'Kapcsolat' },
];
---

<footer class="bg-[var(--color-navy-950)] text-white/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-10">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <div class="flex items-center gap-3 text-white">
          <LogoMark class="w-10 h-10" />
          <span class="leading-tight">
            <span class="block font-heading text-2xl font-semibold">McKenzie</span>
            <span class="block font-mono text-[0.62rem] tracking-[0.18em] uppercase text-white/60">Gyógytorna Rendelő</span>
          </span>
        </div>
        <p class="mt-6 text-sm leading-relaxed text-white/60 max-w-xs">
          {clinic.tagline}. {clinic.therapists} gyógytornász, két rendelő, {clinic.hours.days.toLowerCase()} {clinic.hours.open}-{clinic.hours.close}.
        </p>
        <a href={`tel:${clinic.phone}`} class="mt-6 inline-block font-heading text-3xl text-white hover:text-[var(--color-gold-300)]">{clinic.phoneDisplay}</a>
      </div>

      {clinic.locations.map((l) => (
        <address class="not-italic lg:col-span-3 text-sm space-y-1.5">
          <p class="eyebrow eyebrow-light mb-4">{l.name}</p>
          <p class="text-white">{l.postalCode} Budapest, {l.street}</p>
          <p>{l.transit}</p>
          <p>Parkolás: {l.parking}</p>
          <a href={l.mapsUrl} target="_blank" rel="noopener" class="link-arrow mt-3 text-white">Útvonal <span aria-hidden="true">&rarr;</span></a>
        </address>
      ))}

      <nav class="lg:col-span-2 text-sm" aria-label="Lábléc navigáció">
        <p class="eyebrow eyebrow-light mb-4">Oldalak</p>
        <ul class="space-y-2">
          {links.map((l) => <li><a href={l.href} class="hover:text-white">{l.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="mt-16 pt-6 border-t border-white/10 flex flex-col sm:flex-row gap-4 justify-between text-xs text-white/50">
      <p>&copy; {year} {clinic.legalName} &middot; {clinic.name}</p>
      <div class="flex items-center gap-6">
        <a href={`${base}adatvedelmi-tajekoztato`} class="hover:text-white">Adatvédelmi tájékoztató</a>
        <a href={clinic.sameAs[0]} target="_blank" rel="noopener" class="hover:text-white">Facebook</a>
        <a href={clinic.sameAs[1]} target="_blank" rel="noopener" class="hover:text-white">Instagram</a>
      </div>
    </div>
  </div>
</footer>
