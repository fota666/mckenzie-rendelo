---
// B: quote-led band. Large philosophy quote on green with a round portrait, intro and credentials below.
import { founder } from '../../data/founder';
const base = import.meta.env.BASE_URL;
---

<section class="bg-[var(--color-teal-700)] text-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 text-center">
    <img src={`${base}${founder.photo}`} alt={founder.name} class="mx-auto w-28 h-28 lg:w-36 lg:h-36 rounded-full object-cover object-top ring-4 ring-white/20" loading="lazy" />
    <blockquote class="mt-10 display text-3xl sm:text-4xl lg:text-[3.3rem]">„{founder.philosophy}”</blockquote>
    <p class="mt-8 font-mono text-xs uppercase tracking-wider text-[var(--color-teal-100)]">{founder.name} &middot; {founder.role}</p>
    <p class="mt-10 text-lg leading-relaxed text-white/80 max-w-3xl mx-auto">{founder.intro}</p>
    <ul class="mt-8 flex flex-wrap justify-center gap-2">
      {founder.credentials.map((c) => <li class="px-3 py-1.5 text-sm border border-white/25 text-white/90">{c}</li>)}
    </ul>
  </div>
</section>
