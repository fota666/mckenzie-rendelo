---
// C: story as a timeline. Short intro with a small portrait, then 1992 to today in four steps.
import { founder } from '../../data/founder';
const base = import.meta.env.BASE_URL;
---

<section class="bg-white border-b border-[var(--color-line)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20">
    <div class="grid lg:grid-cols-12 gap-8 items-end">
      <div class="lg:col-span-8 flex gap-6 items-start">
        <img src={`${base}${founder.photo}`} alt={founder.name} class="hidden sm:block w-24 h-32 object-cover object-top shrink-0" loading="lazy" />
        <div>
          <p class="eyebrow">Az alapító</p>
          <h2 class="display mt-4 text-4xl lg:text-5xl text-[var(--color-navy-900)]">{founder.headline}</h2>
        </div>
      </div>
      <p class="lg:col-span-4 text-[var(--color-ink-2)] leading-relaxed">„{founder.philosophy}”</p>
    </div>

    <ol class="mt-16 grid sm:grid-cols-2 lg:grid-cols-4 border-t-2 border-[var(--color-teal-600)]">
      {founder.timeline.map((t, i) => (
        <li class="relative pt-8 pr-6 pb-6">
          <span class="absolute -top-[7px] left-0 w-3 h-3 rounded-full bg-[var(--color-teal-600)]" aria-hidden="true"></span>
          <p class="font-heading text-5xl text-[var(--color-navy-900)]">{t.year}</p>
          <p class="mt-3 text-[var(--color-ink-2)] leading-relaxed">{t.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
