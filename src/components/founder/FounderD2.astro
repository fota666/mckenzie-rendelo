---
// D2: the card on its own band. Warm paper-2 section, white letter card with shadow, portrait right.
import { founder } from '../../data/founder';
const base = import.meta.env.BASE_URL;
---

<section class="bg-[var(--color-paper-2)] py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white shadow-[0_30px_60px_-35px_rgba(6,23,16,0.4)] grid md:grid-cols-[1fr_18rem] lg:grid-cols-[1fr_22rem]">
      <div class="p-6 lg:p-10">
        <p class="eyebrow">Bemutatkozás</p>
        <h2 class="display mt-4 text-2xl lg:text-[2.25rem] text-[var(--color-navy-900)]">{founder.headline}</h2>
        <p class="mt-6 leading-relaxed text-[var(--color-ink-2)] measure">{founder.intro}</p>
        <p class="mt-6 font-heading text-xl italic text-[var(--color-teal-700)] measure">„{founder.philosophy}”</p>
        <div class="mt-8 flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="font-heading text-2xl italic text-[var(--color-navy-800)]">{founder.name}</p>
            <p class="text-sm text-[var(--color-ink-2)]">{founder.role}</p>
          </div>
          <a href={`${base}csapatunk`} class="link-arrow text-sm text-[var(--color-navy-800)]">A csapat <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
      <div class="hidden md:block overflow-hidden bg-[var(--color-paper-2)]">
        <img src={`${base}${founder.photo}`} alt={founder.name} class="w-full h-[108%] object-cover object-top" loading="lazy" />
      </div>
    </div>
  </div>
</section>
