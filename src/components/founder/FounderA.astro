---
// A: portrait + story split, on paper. Classic and calm.
import { founder } from '../../data/founder';
const base = import.meta.env.BASE_URL;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20 grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
  <figure class="lg:col-span-5">
    <div class="aspect-[4/5] overflow-hidden bg-[var(--color-paper-2)]">
      <img src={`${base}${founder.photo}`} alt={founder.name} class="w-full h-[108%] object-cover object-top" loading="lazy" />
    </div>
  </figure>
  <div class="lg:col-span-7">
    <p class="eyebrow">Az alapító</p>
    <h2 class="display mt-5 text-3xl lg:text-[2.75rem] text-[var(--color-navy-900)]">{founder.headline}</h2>
    <p class="mt-6 text-lg leading-relaxed text-[var(--color-ink-2)] measure">{founder.intro}</p>
    <blockquote class="mt-8 pl-6 border-l-2 border-[var(--color-teal-600)] font-heading text-[1.65rem] leading-snug text-[var(--color-navy-900)] measure">„{founder.philosophy}”</blockquote>
    <ul class="mt-8 flex flex-wrap gap-2">
      {founder.credentials.map((c) => <li class="px-3 py-1.5 text-[15px] bg-[var(--color-teal-50)] text-[var(--color-teal-700)] border border-[var(--color-teal-100)]">{c}</li>)}
    </ul>
    <p class="mt-8 font-heading text-[1.65rem] italic text-[var(--color-navy-800)]">{founder.name}</p>
    <p class="text-[15px] text-[var(--color-ink-2)]">{founder.role}</p>
  </div>
</section>
