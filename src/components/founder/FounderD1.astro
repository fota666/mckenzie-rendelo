---
// D1: edge-to-edge split. Letter text on paper, portrait fills the right half to the window edge.
import { founder } from '../../data/founder';
const base = import.meta.env.BASE_URL;
---

<section class="grid lg:grid-cols-2 bg-[var(--color-paper)] border-b border-[var(--color-line)]">
  <div class="px-4 sm:px-6 lg:px-8 py-16 lg:py-20 lg:pl-[max(2rem,calc((100vw-80rem)/2+2rem))] lg:pr-16 flex flex-col justify-center">
    <p class="eyebrow">Bemutatkozás</p>
    <h2 class="display mt-4 text-3xl lg:text-[2.8rem] text-[var(--color-navy-900)]">{founder.headline}</h2>
    <p class="mt-6 leading-relaxed text-[var(--color-ink-2)] measure">{founder.intro}</p>
    <p class="mt-6 font-heading text-xl italic text-[var(--color-teal-700)] measure">„{founder.philosophy}”</p>
    <div class="mt-10 flex flex-wrap items-end justify-between gap-6 border-t border-[var(--color-line)] pt-6">
      <div>
        <p class="font-heading text-3xl italic text-[var(--color-navy-800)]">{founder.name}</p>
        <p class="text-sm text-[var(--color-ink-2)]">{founder.role}</p>
      </div>
      <a href={`${base}csapatunk`} class="link-arrow text-sm text-[var(--color-navy-800)]">A csapat <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
  <div class="relative min-h-[420px] lg:min-h-[640px] overflow-hidden bg-[var(--color-paper-2)]">
    <img src={`${base}${founder.photo}`} alt={founder.name} class="absolute inset-0 w-full h-[108%] object-cover object-top" loading="lazy" />
  </div>
</section>
