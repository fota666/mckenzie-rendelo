---
// D3: card on a soft green band, portrait left, credentials as a side column with a green top rule.
import { founder } from '../../data/founder';
const base = import.meta.env.BASE_URL;
---

<section class="bg-[var(--color-teal-50)] py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white border-t-4 border-[var(--color-teal-600)] grid md:grid-cols-[16rem_1fr] lg:grid-cols-[20rem_1fr]">
      <div class="aspect-[4/5] md:aspect-auto overflow-hidden bg-[var(--color-paper-2)]">
        <img src={`${base}${founder.photo}`} alt={founder.name} class="w-full h-[108%] object-cover object-top" loading="lazy" />
      </div>
      <div class="p-6 lg:p-10 grid lg:grid-cols-[1fr_12rem] gap-10">
        <div>
          <p class="eyebrow">Bemutatkozás</p>
          <h2 class="display mt-4 text-2xl lg:text-[2.25rem] text-[var(--color-navy-900)]">{founder.headline}</h2>
          <p class="mt-6 leading-relaxed text-[var(--color-ink-2)]">{founder.intro}</p>
          <p class="mt-6 font-heading text-xl italic text-[var(--color-teal-700)]">„{founder.philosophy}”</p>
          <p class="mt-8 font-heading text-2xl italic text-[var(--color-navy-800)]">{founder.name}</p>
          <p class="text-sm text-[var(--color-ink-2)]">{founder.role}</p>
        </div>
        <aside class="lg:border-l lg:border-[var(--color-line)] lg:pl-8">
          <p class="font-mono text-[0.7rem] uppercase tracking-wider text-[var(--color-ink-2)]">Képesítés</p>
          <ul class="mt-4 space-y-3 text-sm">
            {founder.credentials.map((c) => <li class="pb-3 border-b border-[var(--color-line)]">{c}</li>)}
          </ul>
          <a href={`${base}csapatunk`} class="link-arrow mt-6 text-sm text-[var(--color-navy-800)]">A csapat <span aria-hidden="true">&rarr;</span></a>
        </aside>
      </div>
    </div>
  </div>
</section>
