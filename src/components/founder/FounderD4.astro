---
// D4: dark band continues the hero's mood. The philosophy line sits above as a large heading,
// the paper card with portrait right sits below it, fully inside the band.
import { founder } from '../../data/founder';
const base = import.meta.env.BASE_URL;
---

<section class="bg-[var(--color-navy-900)] text-white py-16 lg:py-24 border-t border-white/10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="eyebrow eyebrow-light">A rendelő filozófiája</p>
    <p class="display mt-5 text-3xl lg:text-5xl max-w-4xl">„{founder.philosophy}”</p>

    <div class="mt-12 bg-[var(--color-paper)] text-[var(--color-ink)] grid md:grid-cols-[1fr_16rem] lg:grid-cols-[1fr_20rem]">
      <div class="p-8 lg:p-12">
        <p class="eyebrow">Bemutatkozás</p>
        <h2 class="display mt-4 text-3xl lg:text-[2.6rem] text-[var(--color-navy-900)]">{founder.headline}</h2>
        <p class="mt-6 leading-relaxed text-[var(--color-ink-2)] measure">{founder.intro}</p>
        <div class="mt-8 flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="font-heading text-3xl italic text-[var(--color-navy-800)]">{founder.name}</p>
            <p class="text-sm text-[var(--color-ink-2)]">{founder.role}</p>
          </div>
          <a href={`${base}csapatunk`} class="link-arrow text-sm text-[var(--color-navy-800)]">A csapat <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
      <div class="hidden md:block overflow-hidden bg-[var(--color-paper-2)]">
        <img src={`${base}${founder.photo}`} alt={founder.name} class="w-full h-[108%] object-cover object-top" loading="lazy" />
      </div>
    </div>
  </div>
</section>
