---
import LoopVideo from './LoopVideo.astro';
import { clinic } from '../data/clinic';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

  <!-- HERO -->
  <section class="relative isolate overflow-hidden bg-[var(--color-navy-950)] text-white">
    <LoopVideo name="hero" eager label="Gyógytornász manuális kezelést végez egy oldalt fekvő páciensen" class="absolute inset-0 -z-20 w-full h-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-[var(--color-navy-950)]/75 lg:bg-transparent lg:bg-[linear-gradient(90deg,rgba(6,23,16,0.92)_0%,rgba(6,23,16,0.7)_45%,rgba(6,23,16,0.15)_100%)]"></div>
    <div class:list={["max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-end", compact ? "pt-16 pb-16" : "pt-24 pb-20 lg:pt-36 lg:pb-28 min-h-[min(82vh,860px)]"]}>
      <div class="max-w-3xl">
        <p class="eyebrow eyebrow-light">McKenzie referenciarendelő &middot; Budapest V. és XI. kerület</p>
        <h1 class="display mt-6 text-[2.75rem] sm:text-6xl lg:text-[5.25rem]">
          <em class="text-[var(--color-gold-300)]">Derék- és nyakfájás</em> kezelése, amelyet otthon is folytathat.
        </h1>
        <p class="mt-8 text-lg text-white/75 measure leading-relaxed">
          Az első 55 perces alkalommal megvizsgáljuk, mely mozgások hatására csökken a fájdalma, és olyan gyakorlatsort kap, amelyet egyedül is végezhet. Időpont általában 1-2 napon belül.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-3">
          <a href={`tel:${clinic.phone}`} class="btn btn-copper font-mono">{clinic.phoneDisplay}</a>
          <a href={`${base}kapcsolat#visszahivas`} class="btn border border-white/30 hover:border-white">Visszahívást kérek <span aria-hidden="true">&rarr;</span></a>
        </div>
        <p class="mt-3 text-sm text-white/60">Telefonos foglalás {clinic.bookingHoursShort}, visszahívás-kérés bármikor.</p>
        <dl class="mt-8 pt-6 border-t border-white/15 grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
          <div><dt class="font-mono text-[0.7rem] uppercase tracking-wider text-[var(--color-teal-300)]">Ár</dt><dd class="mt-1 text-white/85">{clinic.prices.single.amount} / 55 perc</dd></div>
          <div><dt class="font-mono text-[0.7rem] uppercase tracking-wider text-[var(--color-teal-300)]">Rendelők</dt><dd class="mt-1 text-white/85">Sas utca (V.) &middot; Bartók Béla út (XI.)</dd></div>
          <div><dt class="font-mono text-[0.7rem] uppercase tracking-wider text-[var(--color-teal-300)]">Beutaló</dt><dd class="mt-1 text-white/85">Nem kell</dd></div>
        </dl>
      </div>
    </div>
  </section>
