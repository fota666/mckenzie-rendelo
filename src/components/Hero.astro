---
import LoopVideo from './LoopVideo.astro';
import { clinic, reviewTotalText, ratingText } from '../data/clinic';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const complaints = [
  { href: 'derekfajas', label: 'Derékfájás' },
  { href: 'nyakfajas', label: 'Nyakfájás' },
  { href: 'porckorongserv', label: 'Porckorongsérv' },
  { href: 'isiasz', label: 'Isiász' },
  { href: 'vallfajas', label: 'Váll' },
  { href: 'terdfajdalom', label: 'Térd' },
  { href: 'csipofajdalom', label: 'Csípő' },
  { href: 'muteti-rehabilitacio', label: 'Műtét előtt vagy után' },
  { href: 'gerincferdules', label: 'Gerincferdülés' },
  { href: 'ulomunka-tartashibak', label: 'Ülőmunka okozta fájdalom' },
];
---

  <!-- HERO: full-bleed loop. On large screens the clip fills the right 62% and fades into the dark copy side. -->
  <section class="relative isolate overflow-hidden bg-[var(--color-navy-950)] text-white flex flex-col">
    {compact ? (
      <>
        <LoopVideo name="hero" eager label="Gyógytornász manuális kezelést végez egy oldalt fekvő páciensen" class="absolute inset-0 -z-20 w-full h-full object-cover" />
        <div class="absolute inset-0 -z-10 bg-[var(--color-navy-950)]/75"></div>
      </>
    ) : (
      <div class="hidden lg:block absolute inset-0 -z-10 bg-[linear-gradient(90deg,#061710_0%,#061710_40%,rgba(6,23,16,0.7)_62%,rgba(6,23,16,0.08)_100%)]"></div>
    )}
    <div class:list={["w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center", compact ? "pt-16 pb-16" : "pt-12 pb-10 lg:pt-20 lg:pb-20 lg:min-h-[min(78vh,760px)]"]}>
      <div class="max-w-3xl">
        <p class="eyebrow eyebrow-light">Gyógytorna Budapesten &middot; V. és XI. kerület &middot; 1993 óta</p>
        <h1 class="display mt-4 text-[2.25rem] sm:text-5xl lg:text-[3.4rem]">
          <em class="text-[var(--color-gold-300)]">Gerinc- és ízületi fájdalom</em> kezelése McKenzie-módszerrel.
        </h1>
        <p class="mt-5 text-lg text-white/80 measure leading-relaxed">
          Először megvizsgáljuk, mitől változik a fájdalma, aztán megtanítjuk, hogyan kezelje maga. Beutaló nem kell, időpont általában 1-2 napon belül.
        </p>
        <div class="mt-7 flex flex-col sm:flex-row gap-3">
          <a href={`tel:${clinic.phone}`} class="btn btn-copper font-mono">Hívjon: {clinic.phoneDisplay}</a>
          <a href={`${base}kapcsolat#visszahivas`} class="btn border border-white/30 hover:border-white">Visszahívást kérek <span aria-hidden="true">&rarr;</span></a>
        </div>
        <p class="mt-3 text-[15px] text-white/65">Telefonon {clinic.bookingHoursShort}, a visszahívás-kérést bármikor elküldheti.</p>

        {!compact && (
          <div class="mt-8">
            <p class="font-mono text-[0.78rem] uppercase tracking-wider text-[var(--color-teal-300)]">Mi a panasza?</p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {complaints.map((c) => (
                <li><a href={`${base}${c.href}`} class="inline-block px-3.5 py-2 text-[15px] border border-white/25 bg-white/5 hover:bg-white hover:text-[var(--color-navy-900)] transition-colors">{c.label}</a></li>
              ))}
            </ul>
          </div>
        )}

        <dl class="mt-8 pt-5 border-t border-white/15 grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-4 text-[15px]">
          <div><dt class="font-mono text-[0.78rem] uppercase tracking-wider text-[var(--color-teal-300)]">Google</dt><dd class="mt-1 text-white/90">{ratingText(clinic.locations[0].rating.value)} / 5, {reviewTotalText} vélemény</dd></div>
          <div><dt class="font-mono text-[0.78rem] uppercase tracking-wider text-[var(--color-teal-300)]">Csapat</dt><dd class="mt-1 text-white/90">{clinic.therapists} gyógytornász</dd></div>
          <div><dt class="font-mono text-[0.78rem] uppercase tracking-wider text-[var(--color-teal-300)]">Ár</dt><dd class="mt-1 text-white/90">{clinic.prices.single.range}</dd></div>
          <div><dt class="font-mono text-[0.78rem] uppercase tracking-wider text-[var(--color-teal-300)]">Beutaló</dt><dd class="mt-1 text-white/90">Nem kell</dd></div>
        </dl>
      </div>
    </div>
    {!compact && (
      <div class="relative aspect-[4/3] sm:aspect-[2/1] lg:aspect-auto lg:absolute lg:inset-y-0 lg:right-0 lg:w-[62%] lg:-z-20 overflow-hidden">
        <LoopVideo name="rendelo/derekfajas-hasonfekvo-mobilizalas" eager label="Gyógytornász hasonfekvő páciens derekát kezeli a rendelőben" class="absolute inset-0 w-full h-full object-cover" />
        <div class="lg:hidden absolute inset-x-0 top-0 h-1/3 bg-gradient-to-b from-[var(--color-navy-950)] to-transparent"></div>
      </div>
    )}
  </section>
