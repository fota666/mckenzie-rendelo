---
// The booking card shared by every CTA of the old-design pages: one phone link, one set of buttons.
import { clinic } from '../data/clinic';
interface Props { label?: string; title?: string; onDark?: boolean; email?: boolean }
const { label = 'Telefonos időpontfoglalás', title, onDark = false, email = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class:list={['p-8 lg:p-10 text-[var(--color-ink)]', onDark ? 'bg-[var(--color-paper)] shadow-[0_30px_60px_-30px_rgba(0,0,0,0.55)]' : 'bg-white border border-[var(--color-line)]']}>
  <p class="text-[15px] text-[var(--color-ink-2)]">{label}</p>
  {title && <p class="mt-3 font-heading text-[1.65rem] leading-snug text-[var(--color-navy-900)]">{title}</p>}
  <a href={`tel:${clinic.phone}`} class="mt-3 block font-heading text-[2.6rem] lg:text-5xl leading-none text-[var(--color-navy-900)] hover:text-[var(--color-teal-700)]">{clinic.phoneDisplay}</a>
  <p class="mt-3 text-[15px] text-[var(--color-ink-2)]">{clinic.bookingHours}. Általában 1-2 napon belül kap időpontot.</p>
  <div class:list={["mt-7 flex flex-col gap-3", onDark && "sm:flex-row"]}>
    <a href={`tel:${clinic.phone}`} class="btn btn-copper justify-center">Hívás most</a>
    <a href={`${base}kapcsolat#visszahivas`} class="btn btn-ghost justify-center">Visszahívást kérek</a>
  </div>
  {email && <p class="mt-5 text-[15px] text-[var(--color-ink-2)]">E-mail: <a href={`mailto:${clinic.email}`} class="underline underline-offset-2 hover:text-[var(--color-teal-700)]">{clinic.email}</a></p>}
</div>
