---
// Short professional background on MDT for patients, referring doctors and answer engines.
// Only general, well-established MDT concepts; team facts come from data/team.ts.
const base = import.meta.env.BASE_URL;

const blocks = [
  {
    t: 'Mechanikai Diagnózis és Terápia',
    d: 'A McKenzie-módszer hivatalos magyar neve Mechanikai Diagnózis és Terápia (MDT). Robin McKenzie (1931-2013) új-zélandi gyógytornász dolgozta ki. Nem egy gyakorlatsor, hanem egy vizsgálati és kezelési rendszer, amely a panaszt a mozgásra adott válasz alapján osztályozza.',
  },
  {
    t: 'Ismételt mozgások és centralizáció',
    d: 'A vizsgálat során ismételt mozgások és tartott testhelyzetek alatt figyeljük, hogyan változik a tünetek helye és erőssége. Kedvező jel a centralizáció: amikor a végtagba sugárzó fájdalom bizonyos mozgásokra visszahúzódik a gerinc felé.',
  },
  {
    t: 'Osztályozás',
    d: 'A mozgásvizsgálat alapján a panaszt mechanikai csoportba soroljuk (elmozdulásos, diszfunkciós vagy tartási szindróma), vagy az egyéb kategóriába, ha nem illik ezek egyikébe sem. Ehhez igazítjuk a gyakorlatokat. Ha a vizsgálat nem talál mechanikai mintázatot, más módszert vagy orvosi kivizsgálást javaslunk.',
  },
  {
    t: 'Képzés és minősítés',
    d: 'A McKenzie Institute International több részből álló posztgraduális kurzussorozatot oktat. Ezt követi a nemzetközi minősítővizsga (Credentialing Examination), a legmagasabb szint a diploma (Dip. MDT).',
  },
];
---

<section id="szakmai-hatter" class="scroll-mt-32 border-t border-[var(--color-line)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 grid lg:grid-cols-12 gap-10">
    <div class="lg:col-span-4">
      <p class="eyebrow">Szakmai háttér</p>
      <h2 class="display mt-3 text-3xl lg:text-4xl text-[var(--color-navy-900)]">Mi a McKenzie-módszer (MDT)?</h2>
      <p class="mt-4 text-[15px] leading-relaxed text-[var(--color-ink-2)]">Röviden azoknak, akik pontosan tudni szeretnék, mi történik a vizsgálaton, és orvosoknak, akik hozzánk küldenének pácienst.</p>
      <img src={`${base}images/rendelo/mckenzie-gyakorlat.jpg`} alt="Hasra fekvő gerincnyújtó McKenzie-gyakorlat gyógytornász irányításával a rendelőben" class="mt-8 w-full aspect-[4/3] object-cover" loading="lazy" />
    </div>
    <div class="lg:col-span-8">
      <dl class="grid sm:grid-cols-2 gap-x-10 gap-y-7">
        {blocks.map((b) => (
          <div class="border-t-2 border-[var(--color-teal-600)] pt-4">
            <dt class="font-heading text-[1.5rem] text-[var(--color-navy-900)]">{b.t}</dt>
            <dd class="mt-2 text-[15px] leading-relaxed text-[var(--color-ink-2)]">{b.d}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <!-- Training of the team (qualifications per therapist are on the team page) -->
  <div class="bg-[var(--color-paper-2)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      <p class="eyebrow">Képzés</p>
      <h2 class="display mt-3 text-3xl lg:text-4xl text-[var(--color-navy-900)] max-w-3xl">Minden gyógytornászunk a Magyarországon elérhető legmagasabb szintű McKenzie képzésben részesült.</h2>
      <p class="mt-5 text-[15px] flex flex-wrap gap-x-5 gap-y-2">
        <a href={`${base}csapatunk`} class="link-arrow text-[var(--color-navy-800)]">Terapeuták és képzéseik <span aria-hidden="true">&rarr;</span></a>
        <a href="https://www.mckenzieinstitute.org" target="_blank" rel="noopener" class="link-arrow text-[var(--color-navy-800)]">McKenzie Institute International <span aria-hidden="true">&rarr;</span></a>
        <a href="https://hu.mckenzieinstitute.org" target="_blank" rel="noopener" class="link-arrow text-[var(--color-navy-800)]">Magyarországi McKenzie Intézet <span aria-hidden="true">&rarr;</span></a>
      </p>
    </div>
  </div>
</section>
