---
// B: editorial full-width rows. Each situation is one wide line: number, title, answer, link.
import { situations } from '../../data/situations';
const base = import.meta.env.BASE_URL;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
  <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
    <div>
      <p class="eyebrow">Kik jönnek hozzánk</p>
      <h2 class="display mt-5 text-4xl lg:text-6xl text-[var(--color-navy-900)]">Négy helyzet, amellyel hozzánk fordulnak.</h2>
    </div>
  </div>

  <ol class="mt-14 border-t-2 border-[var(--color-navy-900)]">
    {situations.map((s, i) => (
      <li>
        <a href={`${base}${s.link.path}`} class="group grid lg:grid-cols-12 gap-4 lg:gap-8 py-10 border-b border-[var(--color-line)] hover:bg-white transition-colors px-2 -mx-2">
          <span class="lg:col-span-1 font-heading text-5xl text-[var(--color-teal-600)] leading-none">{i + 1}</span>
          <span class="lg:col-span-5">
            <span class="block font-mono text-[0.7rem] uppercase tracking-wider text-[var(--color-ink-2)]">{s.tag}</span>
            <span class="block mt-2 font-heading text-3xl lg:text-[2.1rem] leading-tight text-[var(--color-navy-900)] group-hover:text-[var(--color-teal-700)] transition-colors">{s.title}</span>
          </span>
          <span class="lg:col-span-5 text-[var(--color-ink-2)] leading-relaxed lg:pt-6">{s.body}</span>
          <span class="lg:col-span-1 lg:pt-6 lg:text-right">
            <span class="inline-flex items-center justify-center w-11 h-11 rounded-full border border-[var(--color-line)] group-hover:bg-[var(--color-teal-700)] group-hover:border-[var(--color-teal-700)] group-hover:text-white transition-colors" aria-hidden="true">&rarr;</span>
            <span class="sr-only">{s.link.label}</span>
          </span>
        </a>
      </li>
    ))}
  </ol>
</section>
