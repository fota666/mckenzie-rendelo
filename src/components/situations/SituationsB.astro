---
// B: editorial full-width rows. Each situation: number, title, what we do, and the methods it leads to.
import { situations } from '../../data/situations';
const base = import.meta.env.BASE_URL;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
  <p class="eyebrow">Kik jönnek hozzánk</p>
  <h2 class="display mt-5 text-3xl lg:text-5xl text-[var(--color-navy-900)]">Négy helyzet, amellyel hozzánk fordulnak.</h2>

  <ol class="mt-7 border-t-2 border-[var(--color-navy-900)]">
    {situations.map((s, i) => (
      <li class="group grid lg:grid-cols-12 gap-4 lg:gap-8 py-5 border-b border-[var(--color-line)]">
        <span class="lg:col-span-1 font-heading text-4xl text-[var(--color-teal-600)] leading-none">{i + 1}</span>
        <div class="lg:col-span-5">
          <p class="font-mono text-[0.7rem] uppercase tracking-wider text-[var(--color-ink-2)]">{s.tag}</p>
          <h3 class="mt-2 font-heading text-2xl lg:text-[1.75rem] leading-tight text-[var(--color-navy-900)]">{s.title}</h3>
        </div>
        <div class="lg:col-span-6 lg:pt-6">
          <p class="text-[var(--color-ink-2)] leading-relaxed">{s.body}</p>
          <p class="mt-5 font-mono text-[0.7rem] uppercase tracking-wider text-[var(--color-ink-2)]">{s.methods.length > 1 ? 'Módszerek' : 'Módszer'}</p>
          <ul class="mt-2 flex flex-wrap gap-2">
            {s.methods.map((m) => (
              <li>
                <a href={`${base}${m.path}`} class="inline-flex items-baseline gap-1.5 px-3 py-1.5 text-sm bg-[var(--color-teal-50)] text-[var(--color-teal-700)] border border-[var(--color-teal-100)] hover:bg-[var(--color-teal-700)] hover:text-white hover:border-[var(--color-teal-700)] transition-colors">
                  {m.label}{m.when && <span class="text-xs opacity-70">({m.when})</span>} <span aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</section>
