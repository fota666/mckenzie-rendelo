---
// Closing call to action (calm design). `tone="gold"` keeps it apart from the dark footer on pages that end with it.
import { clinic, healthFundNote } from '../../data/clinic';
interface Props { eyebrow?: string; title?: string; tone?: 'pine' | 'gold' }
const {
  eyebrow = 'Időpontfoglalás',
  title = 'Hívjon, és általában 1-2 napon belül időpontot kap.',
  tone = 'pine',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section class:list={['k-sec', tone === 'gold' ? 'k-sec--gold' : 'k-sec--pine']}>
  <div class="k-wrap k-cta2">
    <div>
      <p class="k-eyebrow">{eyebrow}</p>
      <h2 class="k-h2" style="margin:14px 0 22px">{title}</h2>
      <ul class="k-checks">
        <li>Beutaló nem kell</li>
        <li>{clinic.prices.single.range} egy alkalom. {healthFundNote}.</li>
        <li>Két rendelő, {clinic.hoursText}</li>
      </ul>
    </div>
    <div class="k-cta2__card">
      <p class="k-small">Telefonos időpontfoglalás</p>
      <a href={`tel:${clinic.phone}`} class="k-cta2__tel">{clinic.phoneDisplay}</a>
      <p class="k-small">{clinic.bookingHours}</p>
      <div class="k-btns" style="margin-top:20px">
        <a href={`tel:${clinic.phone}`} class="k-btn k-btn--clay">Hívás most</a>
        <a href={`${base}kapcsolat#visszahivas`} class="k-btn k-btn--ghost">Visszahívást kérek</a>
      </div>
    </div>
  </div>
</section>
