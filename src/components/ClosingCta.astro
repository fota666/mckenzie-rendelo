---
// Closing booking band for the pages that do not end with their own booking block.
import { clinic, healthFundNote } from '../data/clinic';
import CtaCard from './CtaCard.astro';
interface Props { eyebrow?: string; title?: string; lead?: string }
const {
  eyebrow = 'Időpontfoglalás',
  title = 'Hívjon, és általában 1-2 napon belül időpontot kap.',
  lead = 'Általában 1-2 napon belül tudunk időpontot adni valamelyik rendelőnkbe.',
} = Astro.props;
const checks = [
  'Beutaló nem kell',
  `Egy alkalom ${clinic.prices.single.range}. ${healthFundNote}.`,
  `Két rendelő, ${clinic.hoursText}`,
];
---

<section class="bg-[var(--color-navy-900)] text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
    <div class="lg:col-span-7">
      <p class="eyebrow eyebrow-light">{eyebrow}</p>
      <h2 class="display mt-4 text-4xl lg:text-[3.25rem] max-w-2xl">{title}</h2>
      <p class="mt-5 text-lg text-white/75 leading-relaxed max-w-xl">{lead}</p>
      <ul class="mt-7 space-y-3 text-white/90">
        {checks.map((c) => (
          <li class="flex gap-3 items-start">
            <span class="mt-2 w-2 h-2 rounded-full bg-[var(--color-gold-400)] shrink-0" aria-hidden="true"></span>
            <span>{c}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="lg:col-span-5"><CtaCard onDark label="Telefonos időpontfoglalás" /></div>
  </div>
</section>
