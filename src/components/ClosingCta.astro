---
// The same closing band on every page that does not end with its own booking block.
import { clinic } from '../data/clinic';
interface Props { title?: string }
const { title = 'Hívjon hétköznap 9 és 17 óra között, vagy kérjen visszahívást.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section class="bg-[var(--color-navy-900)] text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 grid lg:grid-cols-12 gap-6 items-end">
    <div class="lg:col-span-8">
      <p class="eyebrow eyebrow-light">Időpontfoglalás</p>
      <h2 class="display mt-3 text-3xl lg:text-4xl">{title}</h2>
      <p class="mt-3 text-white/70">Általában 1-2 napon belül tudunk időpontot adni valamelyik rendelőnkbe.</p>
    </div>
    <div class="lg:col-span-4 flex flex-col sm:flex-row lg:justify-end gap-3">
      <a href={`tel:${clinic.phone}`} class="btn btn-copper font-mono">{clinic.phoneDisplay}</a>
      <a href={`${base}kapcsolat#visszahivas`} class="btn border border-white/30 hover:border-white">Visszahívást kérek</a>
    </div>
  </div>
</section>
