---
import LogoMark from './LogoMark.astro';
import { clinic } from '../data/clinic';
import { conditions } from '../data/conditions';
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.replace(/\/$/, '');
const navLinks = [
  { href: `${base}modszerek`, label: 'Módszerek' },
  { href: `${base}csapatunk`, label: 'Csapatunk' },
  { href: `${base}araink`, label: 'Árak' },
  { href: `${base}velemenyek`, label: 'Vélemények' },
  { href: `${base}gyik`, label: 'GYIK' },
  { href: `${base}kapcsolat`, label: 'Kapcsolat' },
];
const isActive = (href: string) => path === href.replace(/\/$/, '');
---

<header id="navbar" class="sticky top-0 z-50 bg-[var(--color-paper)]/90 backdrop-blur border-b border-[var(--color-line)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-[80px]">
      <a href={base} class="flex items-center gap-3 text-[var(--color-navy-800)]" aria-label={`${clinic.name}, főoldal`}>
        <LogoMark class="w-12 h-12" />
        <span class="leading-tight">
          <span class="block font-heading text-[1.7rem] font-semibold tracking-tight">McKenzie</span>
          <span class="block font-mono text-[0.78rem] tracking-[0.18em] uppercase text-[var(--color-ink-2)]">Gyógytorna Rendelő</span>
        </span>
      </a>

      <nav class="hidden lg:flex items-center gap-5 xl:gap-7" aria-label="Fő navigáció">
        <details class="nav-dd" data-dd>
          <summary>Panaszok</summary>
          <div class="nav-dd__panel nav-dd__panel--wide">
            {conditions.map((c) => <a href={`${base}${c.slug}`}>{c.name}</a>)}
            <a href={`${base}#panaszok`} class="nav-dd__all">Az összes panasz &rarr;</a>
          </div>
        </details>
        <a href={`${base}modszerek`} aria-current={isActive(`${base}modszerek`) ? 'page' : undefined} class="nav-link">Módszerek</a>
        <a href={`${base}csapatunk`} aria-current={isActive(`${base}csapatunk`) ? 'page' : undefined} class="nav-link">Csapatunk</a>
        <details class="nav-dd" data-dd>
          <summary>Tudnivalók</summary>
          <div class="nav-dd__panel">
            {navLinks.filter((l) => !/modszerek|csapatunk/.test(l.href)).map((l) => <a href={l.href}>{l.label}</a>)}
          </div>
        </details>
      </nav>

      <div class="hidden lg:flex items-center gap-5">
        <details class="lang-dd" data-lang-switch data-lang-dd data-notranslate>
          <summary aria-label="Language"><span data-lang-current>HU</span></summary>
          <div>
            <a href="#lang-hu" data-lang="hu" hreflang="hu" lang="hu">Magyar</a>
            <a href="#lang-en" data-lang="en" hreflang="en" lang="en">English</a>
            <a href="#lang-de" data-lang="de" hreflang="de" lang="de">Deutsch</a>
          </div>
        </details>
        <a href={`tel:${clinic.phone}`} class="btn btn-copper !py-2.5 !px-5 text-[15px] whitespace-nowrap">Hívjon: {clinic.phoneDisplay}</a>
      </div>

      <button id="mobile-menu-btn" class="lg:hidden p-2 -mr-2 text-[var(--color-ink)]" aria-label="Menü" aria-expanded="false" aria-controls="mobile-menu">
        <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="1.75" d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-[var(--color-line)] bg-[var(--color-paper)]">
    <nav class="px-4 py-4" aria-label="Mobil navigáció">
      <details class="border-b border-[var(--color-line)]">
        <summary class="flex justify-between py-3.5 text-lg font-heading cursor-pointer list-none">Panaszok<span aria-hidden="true">+</span></summary>
        <div class="pb-3 pl-3 grid">
          {conditions.map((c) => <a href={`${base}${c.slug}`} class="py-2 text-[15px] text-[var(--color-ink-2)]">{c.name}</a>)}
        </div>
      </details>
      {navLinks.map(link => (
        <a href={link.href} class="flex justify-between py-3.5 border-b border-[var(--color-line)] text-lg font-heading">
          {link.label}<span aria-hidden="true">&rarr;</span>
        </a>
      ))}
      <nav class="lang-switch lang-switch--mobile" data-lang-switch data-notranslate aria-label="Language">
        <a href="#lang-hu" data-lang="hu" hreflang="hu" lang="hu">HU</a>
        <a href="#lang-en" data-lang="en" hreflang="en" lang="en">EN</a>
        <a href="#lang-de" data-lang="de" hreflang="de" lang="de">DE</a>
      </nav>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    document.getElementById('menu-icon')?.classList.toggle('hidden', open);
    document.getElementById('close-icon')?.classList.toggle('hidden', !open);
  });
</script>

<script>
  // close the language dropdown when clicking elsewhere
  document.addEventListener('click', (e) => {
    document.querySelectorAll('details[data-lang-dd][open]').forEach((d) => { if (!d.contains(e.target as Node)) d.removeAttribute('open'); });
  });
</script>

<script>
  document.addEventListener('click', (e) => {
    document.querySelectorAll('details[data-dd][open], details[data-lang-dd][open]').forEach((d) => { if (!d.contains(e.target as Node)) d.removeAttribute('open'); });
  });
</script>
