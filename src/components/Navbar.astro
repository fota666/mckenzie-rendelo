---
import LogoMark from './LogoMark.astro';
import { clinic } from '../data/clinic';
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.replace(/\/$/, '');
const navLinks = [
  { href: `${base}modszerek`, label: 'Módszerek' },
  { href: `${base}csapatunk`, label: 'Csapatunk' },
  { href: `${base}araink`, label: 'Árak' },
  { href: `${base}velemenyek`, label: 'Vélemények' },
  { href: `${base}gyik`, label: 'GYIK' },
  { href: `${base}kapcsolat`, label: 'Kapcsolat' },
];
const isActive = (href: string) => path === href.replace(/\/$/, '');
---

<header id="navbar" class="sticky top-0 z-50 bg-[var(--color-paper)]/90 backdrop-blur border-b border-[var(--color-line)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-[72px]">
      <a href={base} class="flex items-center gap-3 text-[var(--color-navy-800)]" aria-label={`${clinic.name}, főoldal`}>
        <LogoMark class="w-9 h-9" />
        <span class="leading-tight">
          <span class="block font-heading text-[1.35rem] font-semibold tracking-tight">McKenzie</span>
          <span class="block font-mono text-[0.62rem] tracking-[0.18em] uppercase text-[var(--color-ink-2)]">Gyógytorna Rendelő</span>
        </span>
      </a>

      <nav class="hidden lg:flex items-center gap-7" aria-label="Fő navigáció">
        {navLinks.map(link => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class="text-[0.92rem] text-[var(--color-ink-2)] hover:text-[var(--color-ink)] transition-colors aria-[current=page]:text-[var(--color-ink)] aria-[current=page]:font-medium"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="hidden lg:flex items-center gap-5">
        <a href={`tel:${clinic.phone}`} class="font-mono text-sm text-[var(--color-ink)] hover:text-[var(--color-teal-700)]">{clinic.phoneDisplay}</a>
        <a href={`${base}kapcsolat#idopontfoglalas`} class="btn btn-primary !py-2.5 !px-5 text-sm">Időpontot kérek</a>
      </div>

      <button id="mobile-menu-btn" class="lg:hidden p-2 -mr-2 text-[var(--color-ink)]" aria-label="Menü" aria-expanded="false" aria-controls="mobile-menu">
        <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="1.75" d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-[var(--color-line)] bg-[var(--color-paper)]">
    <nav class="px-4 py-4" aria-label="Mobil navigáció">
      {navLinks.map(link => (
        <a href={link.href} class="flex justify-between py-3.5 border-b border-[var(--color-line)] text-lg font-heading">
          {link.label}<span aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    document.getElementById('menu-icon')?.classList.toggle('hidden', open);
    document.getElementById('close-icon')?.classList.toggle('hidden', !open);
  });
</script>
