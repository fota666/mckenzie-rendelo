---
interface Props { eyebrow?: string }
const { eyebrow } = Astro.props;
---

<section class="border-b border-[var(--color-line)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-14 lg:pt-20 lg:pb-16">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="display mt-5 text-5xl lg:text-7xl text-[var(--color-navy-900)] max-w-4xl"><slot name="title" /></h1>
    <div class="mt-6 text-lg text-[var(--color-ink-2)] measure leading-relaxed"><slot /></div>
  </div>
</section>
