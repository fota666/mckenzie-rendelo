---
import BaseLayout from '../layouts/BaseLayout.astro';
import LoopVideo from '../components/LoopVideo.astro';
import { clinic, reviewTotal } from '../data/clinic';
const base = import.meta.env.BASE_URL;

const facts = [
  { value: '1993', label: 'óta vezeti Relle Éva a hazai McKenzie Intézetet' },
  { value: String(clinic.therapists), label: 'gyógytornász két rendelőben' },
  { value: '1-2', label: 'nap várakozás időpontra' },
  { value: '4,9 / 5,0', label: `Google-értékelés, ${reviewTotal} vélemény` },
];

// Entry points by situation, not by method name: patients search for their pain, not for "MDT".
const situations = [
  {
    tag: 'Most fáj',
    title: 'Napok óta fáj a dereka vagy a nyaka, és nem múlik.',
    body: 'Az első alkalommal ismételt mozgásokkal kiderítjük, melyik irány csökkenti a fájdalmat. Már erről az alkalomról hazavisz egy gyakorlatot, amit otthon is végezhet.',
    link: { href: `${base}modszerek#mckenzie`, label: 'McKenzie-módszer' },
  },
  {
    tag: 'Évek óta visszatér',
    title: 'A fájdalom újra és újra előjön, a gyógyszer csak tompítja.',
    body: 'Megkeressük, mi váltja ki a visszaesést, és megtanítjuk, hogyan kezelje a következő rohamot maga. Ehhez stabilizációs tréninget és tartásjavítást kapcsolunk.',
    link: { href: `${base}modszerek#stabilizacio`, label: 'Stabilizációs tréning' },
  },
  {
    tag: 'Porckorongsérv',
    title: 'MRI-n sérvet találtak, és most a műtét kérdése van az asztalon.',
    body: 'A sérv nem jelent automatikusan műtétet. Megnézzük, javul-e az állapota konzervatív kezelésre, és ha műtét lesz, felkészítjük rá, utána pedig rehabilitáljuk.',
    link: { href: `${base}modszerek#mutet-utani`, label: 'Műtét előtti és utáni rehabilitáció' },
  },
  {
    tag: 'Gerincferdülés',
    title: 'Gyermeknél vagy felnőttnél scoliosist, Scheuermann-betegséget állapítottak meg.',
    body: 'Háromdimenziós Schroth-gyakorlatokkal és légzéstechnikával dolgozunk a görbület és a bordapúp ellen, otthon is végezhető programmal.',
    link: { href: `${base}modszerek#schroth`, label: 'Schroth-terápia' },
  },
];

const firstVisit = [
  { min: '0-10', video: null, title: 'Kikérdezés', body: 'Mikor kezdődött, mitől rosszabb, mitől jobb. Ha vannak leletei (MRI, röntgen), hozza magával.' },
  { min: '10-30', video: 'vizsgalat', title: 'Mozgásvizsgálat', body: 'Ismételt mozgások és testhelyzetek, miközben figyeljük, hogyan változik a fájdalom helye és erőssége.' },
  { min: '30-45', video: 'kezeles', title: 'Kezelés', body: 'A vizsgálat alapján McKenzie-gyakorlatok, szükség esetén manuális technikák.' },
  { min: '45-55', video: 'otthon', title: 'Otthoni program', body: 'Írásban vagy videón megkapja a gyakorlatokat, és megbeszéljük, mikor jöjjön vissza.' },
];

const methods = [
  { id: 'mckenzie', name: 'McKenzie-módszer (MDT)', for: 'derékfájás, nyakfájás, isiász, porckorongsérv' },
  { id: 'manualterapia', name: 'Manuálterápia (Maitland, Mulligan)', for: 'ízületi mozgásbeszűkülés, váll, csípő, térd' },
  { id: 'stabilizacio', name: 'Stabilizációs tréning', for: 'instabil vagy túlterhelt gerinc, lumbágó' },
  { id: 'schroth', name: 'Schroth-terápia', for: 'scoliosis, Scheuermann-betegség' },
  { id: 'mutet-utani', name: 'Műtét utáni rehabilitáció', for: 'gerinc-, csípő-, térdműtét, szalagszakadás' },
  { id: 'tartasjavitas', name: 'Tartásjavítás', for: 'ülőmunka, gyermekkori tartáshiba' },
  { id: 'taping', name: 'Kineziológiai taping', for: 'sportsérülés, ficam, tenisz- és golfkönyök' },
  { id: 'stretching', name: 'Gyógyászati nyújtás', for: 'izomfeszülés, merevség' },
  { id: 'izuleti-fajdalmak', name: 'Ízületi fájdalmak gyógytornája', for: 'térd, váll, csípő, boka, csukló' },
];

const team = [
  { name: 'Lipták Noémi', img: 'liptak_noemi.jpg' },
  { name: 'Vágó Eszter', img: 'vago_eszter.jpg' },
  { name: 'Cseh Ágnes', img: 'cseh_agnes.jpg' },
  { name: 'Takács Dóra', img: 'takacs_dora.jpg' },
  { name: 'Kókai Zsuzsa', img: 'kokai_zsuzsa.jpg' },
];

const reviews = [
  { text: 'Nincs gerincsérvből eredő kilátástalanság. A McKenzie-módszerrel gyakorlatilag visszakaptam az életem.', name: 'Kulcsár Krisztián', role: 'világbajnok vívó' },
  { text: 'Két kezelés után már éreztem a javulást, az otthoni gyakorlatok rendszeres végzésével azóta is panaszmentes vagyok.', name: 'S. Attila', role: 'páciens' },
  { text: 'Mostanában semmi bajom. Mégis jövök. Kelleni kell valakinek. Testileg is, lelkileg is.', name: 'Havas Henrik', role: 'újságíró' },
];

// Answer-first wording: each answer opens with the direct fact so answer engines can quote it.
const faqs = [
  { q: 'Kell beutaló a McKenzie gyógytornához?', a: 'Nem kell beutaló, magánrendelésről van szó. Ha van korábbi MRI- vagy röntgenlelete, hozza magával az első alkalomra.' },
  { q: 'Mennyibe kerül egy kezelés?', a: `Egy 55 perces egyéni kezelés ${clinic.prices.single.amount}. Az 5 alkalmas bérlet ${clinic.prices.pass.amount}, ez ${clinic.prices.pass.perVisit}. A társadalombiztosítás nem fedezi, egészségpénztárra számlát adunk.` },
  { q: 'Hány alkalom kell, hogy javuljon a derékfájásom?', a: 'A legtöbb páciens 1-2 alkalom után érez javulást. Egy teljes kezelési sor általában 4-6 alkalom, az állapot súlyosságától függően.' },
  { q: 'Mennyit kell várni időpontra?', a: 'Általában 1-2 napon belül tudunk időpontot adni, hétköznap 8 és 20 óra között, a V. és a XI. kerületi rendelőben.' },
  { q: 'Porckorongsérvvel is lehet gyógytornára jönni?', a: 'Igen. A porckorongsérv nagy része konzervatív kezelésre javul, ezért műtét előtt érdemes kipróbálni a McKenzie-módszert. Erős zsibbadás, gyengeség vagy vizelettartási zavar esetén előbb orvoshoz kell fordulni.' },
  { q: 'Mi a különbség a McKenzie-módszer és a hagyományos gyógytorna között?', a: 'A McKenzie-módszer egy vizsgálati eljárással kezdődik, amely megmutatja, melyik mozgásirány csökkenti a fájdalmat. A kezelés célja, hogy a páciens maga tudja kezelni a panaszát, ne a terapeutától függjön.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout title="McKenzie Gyógytorna Rendelő Budapest | Derék- és nyakfájás kezelése">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- HERO -->
  <section class="relative isolate overflow-hidden bg-[var(--color-navy-950)] text-white">
    <LoopVideo name="hero" eager label="Gyógytornász manuális kezelést végez egy oldalt fekvő páciensen" class="absolute inset-0 -z-20 w-full h-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-[var(--color-navy-950)]/75 lg:bg-transparent lg:bg-[linear-gradient(90deg,rgba(6,23,16,0.92)_0%,rgba(6,23,16,0.7)_45%,rgba(6,23,16,0.15)_100%)]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-20 lg:pt-36 lg:pb-28 min-h-[min(82vh,860px)] flex items-end">
      <div class="max-w-3xl">
        <p class="eyebrow eyebrow-light">McKenzie referenciarendelő &middot; Budapest V. és XI. kerület</p>
        <h1 class="display mt-6 text-[2.75rem] sm:text-6xl lg:text-[5.25rem]">
          <em class="text-[var(--color-gold-300)]">Derék- és nyakfájás</em> kezelése, amit otthon is folytatni tud.
        </h1>
        <p class="mt-8 text-lg text-white/75 measure leading-relaxed">
          Az első 55 perces alkalommal megvizsgáljuk, mely mozgásokra csökken a fájdalma, és olyan gyakorlatsort kap, amit egyedül is végez. Időpont általában 1-2 napon belül.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-3">
          <a href={`${base}kapcsolat#idopontfoglalas`} class="btn btn-copper">Időpontot kérek <span aria-hidden="true">&rarr;</span></a>
          <a href={`tel:${clinic.phone}`} class="btn border border-white/30 hover:border-white font-mono">{clinic.phoneDisplay}</a>
        </div>
        <p class="mt-6 text-sm text-white/55">Beutaló nem kell. {clinic.hours.days} {clinic.hours.open}-{clinic.hours.close}.</p>
      </div>
    </div>
  </section>

  <!-- FACTS -->
  <section class="border-y border-[var(--color-line)] bg-white">
    <dl class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 lg:grid-cols-4 divide-x divide-[var(--color-line)]">
      {facts.map((f, i) => (
        <div class={`py-8 lg:py-10 ${i % 2 === 0 ? 'pr-4' : 'pl-6'} lg:px-8 ${i === 0 ? 'lg:pl-0' : ''} ${i > 1 ? 'border-t lg:border-t-0 border-[var(--color-line)]' : ''}`}>
          <dt class="sr-only">{f.label}</dt>
          <dd class="font-heading text-4xl sm:text-5xl lg:text-6xl whitespace-nowrap text-[var(--color-navy-900)]">{f.value}</dd>
          <dd class="mt-2 font-mono text-[0.72rem] tracking-wider uppercase text-[var(--color-ink-2)]">{f.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- PRESS -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 flex flex-wrap items-baseline gap-x-8 gap-y-2">
    <p class="font-mono text-[0.7rem] uppercase tracking-wider text-[var(--color-ink-2)]">Írtak rólunk</p>
    {['Nők Lapja Egészség', 'Elixír Magazin', 'Sikeres Nők', 'Phoenix Pharma', 'Pályacsúcs Magazin'].map((m) => (
      <a href={`${base}velemenyek`} class="font-heading text-xl text-[var(--color-ink-2)] hover:text-[var(--color-teal-700)]">{m}</a>
    ))}
  </section>

  <!-- SITUATIONS -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-24 lg:pt-24 lg:pb-32">
    <div class="grid lg:grid-cols-12 gap-8">
      <div class="lg:col-span-4">
        <p class="eyebrow">Kik jönnek hozzánk</p>
        <h2 class="display mt-5 text-4xl lg:text-5xl text-[var(--color-navy-900)]">Négy helyzet, amivel hozzánk fordulnak.</h2>
      </div>
      <div class="lg:col-span-8 grid sm:grid-cols-2 gap-px bg-[var(--color-line)] border border-[var(--color-line)]">
        {situations.map((s) => (
          <article class="bg-[var(--color-paper)] p-7 lg:p-9 flex flex-col border-t-2 border-transparent hover:border-[var(--color-teal-600)] transition-colors">
            <p class="font-mono text-[0.7rem] tracking-wider uppercase text-[var(--color-teal-700)]">{s.tag}</p>
            <h3 class="mt-4 font-heading text-2xl leading-snug text-[var(--color-navy-900)]">{s.title}</h3>
            <p class="mt-4 text-[0.95rem] leading-relaxed text-[var(--color-ink-2)] flex-1">{s.body}</p>
            <a href={s.link.href} class="link-arrow mt-6 self-start text-sm text-[var(--color-navy-800)]">{s.link.label} <span aria-hidden="true">&rarr;</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FIRST VISIT -->
  <section class="bg-[var(--color-navy-900)] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <div class="grid lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow eyebrow-light">Az első alkalom</p>
          <h2 class="display mt-5 text-4xl lg:text-5xl">55 perc, és hazaviszi a saját gyakorlatsorát.</h2>
        </div>
        <p class="lg:col-span-5 text-white/70 leading-relaxed">Kényelmes, mozgásra alkalmas ruhát hozzon. Öltöző és mosdó mindkét rendelőben van.</p>
      </div>
      <ol class="mt-16 grid sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-12">
        {firstVisit.map((step, i) => (
          <li>
            <div class="aspect-[4/5] overflow-hidden bg-[var(--color-navy-800)]">
              {step.video ? (
                <LoopVideo name={step.video} label={step.title} class="w-full h-full object-cover" />
              ) : (
                <div class="h-full p-6 flex flex-col justify-end">
                  <p class="font-heading text-3xl leading-tight">Hozza magával a leleteit.</p>
                  <p class="mt-3 text-sm text-white/60">MRI, röntgen, korábbi zárójelentés, ha van.</p>
                </div>
              )}
            </div>
            <p class="mt-6 font-mono text-xs tracking-wider text-[var(--color-teal-300)]">{String(i + 1).padStart(2, '0')} &middot; {step.min}. perc</p>
            <h3 class="mt-3 font-heading text-2xl">{step.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/65">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- METHODS -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
    <div class="grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5">
        <p class="eyebrow">Kezelési módszerek</p>
        <h2 class="display mt-5 text-4xl lg:text-5xl text-[var(--color-navy-900)]">A McKenzie-módszer a fő szakterületünk, mellette nyolc másik eljárás.</h2>
        <p class="mt-6 text-[var(--color-ink-2)] leading-relaxed measure">Nem kell előre eldöntenie, melyikre van szüksége. Az első vizsgálat után a terapeuta javasolja a kombinációt.</p>
        <div class="mt-10 aspect-[4/5] max-w-md overflow-hidden bg-[var(--color-paper-2)]">
          <LoopVideo name="stabilizacio" label="Vállstabilizáló gyakorlat gumiszalaggal, gyógytornász felügyeletével" class="w-full h-full object-cover" />
        </div>
      </div>
      <ul class="lg:col-span-7 border-t border-[var(--color-line)]">
        {methods.map((m, i) => (
          <li class="border-b border-[var(--color-line)]">
            <a href={`${base}modszerek#${m.id}`} class="group grid grid-cols-[2.5rem_1fr_auto] items-baseline gap-4 py-6 hover:bg-white transition-colors px-2 -mx-2">
              <span class="font-mono text-xs text-[var(--color-teal-600)]">{String(i + 1).padStart(2, '0')}</span>
              <span>
                <span class="block font-heading text-2xl text-[var(--color-navy-900)]">{m.name}</span>
                <span class="block mt-1 text-sm text-[var(--color-ink-2)]">{m.for}</span>
              </span>
              <span aria-hidden="true" class="text-[var(--color-ink-2)] group-hover:text-[var(--color-navy-900)] group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- TEAM -->
  <section class="bg-[var(--color-paper-2)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-28 grid lg:grid-cols-12 gap-12">
      <figure class="lg:col-span-5">
        <div class="aspect-[4/5] overflow-hidden bg-white">
          <img src={`${base}images/relle_eva.jpg`} alt="Relle Éva, a rendelő vezető gyógytornásza" class="w-full h-[108%] object-cover object-top" width="683" height="1024" loading="lazy" />
        </div>
        <figcaption class="mt-4 flex justify-between gap-4 text-sm">
          <span><span class="font-heading text-xl text-[var(--color-navy-900)]">Relle Éva</span><br/><span class="text-[var(--color-ink-2)]">Vezető gyógytornász, a Magyarországi McKenzie Intézet vezetője</span></span>
          <span class="font-mono text-[0.7rem] tracking-wider uppercase text-[var(--color-gold-600)] text-right">HU &middot; EN &middot; DE</span>
        </figcaption>
      </figure>
      <div class="lg:col-span-7 lg:pl-8 flex flex-col">
        <p class="eyebrow">Csapatunk</p>
        <h2 class="display mt-5 text-4xl lg:text-5xl text-[var(--color-navy-900)]">{clinic.therapists} gyógytornász Relle Éva vezetésével.</h2>
        <p class="mt-6 text-[var(--color-ink-2)] leading-relaxed measure">Relle Éva 1992 óta gyógytornász, 1993 óta vezeti a Magyarországi McKenzie Intézetet, és letette a McKenzie nemzetközi minősítő vizsgát. Minden terapeutánk McKenzie-képzéssel dolgozik.</p>
        <ul class="mt-10 grid grid-cols-3 gap-3">
          {team.map((t) => (
            <li>
              <div class="aspect-[3/4] overflow-hidden bg-white">
                <img src={`${base}images/${t.img}`} alt={t.name} class="w-full h-full object-cover" loading="lazy" />
              </div>
              <p class="mt-2 text-xs text-[var(--color-ink-2)]">{t.name}</p>
            </li>
          ))}
          <li>
            <a href={`${base}csapatunk`} class="aspect-[3/4] flex flex-col justify-end p-4 bg-[var(--color-teal-700)] text-white hover:bg-[var(--color-teal-600)] transition-colors">
              <span class="font-heading text-4xl">+{clinic.therapists - team.length - 1}</span>
              <span class="text-xs text-white/70">további terapeuta</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="bg-[var(--color-teal-50)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
      <div>
        <p class="eyebrow">Vélemények</p>
        <h2 class="display mt-5 text-4xl lg:text-5xl text-[var(--color-navy-900)]">{reviewTotal} Google-értékelés a két rendelőről.</h2>
      </div>
      <div class="flex gap-8 font-mono text-sm">
        {clinic.locations.map((l) => (
          <p><span class="font-heading text-3xl text-[var(--color-navy-900)]">{l.rating.value.toFixed(1).replace('.', ',')}</span><br/><span class="text-xs uppercase tracking-wider text-[var(--color-ink-2)]">{l.name.split(' ')[0]} &middot; {l.rating.count} db</span></p>
        ))}
      </div>
    </div>
    <div class="mt-14 grid md:grid-cols-3 gap-px bg-[var(--color-teal-100)] border border-[var(--color-teal-100)]">
      {reviews.map((r) => (
        <figure class="bg-white p-8 lg:p-10 flex flex-col">
          <blockquote class="font-heading text-[1.6rem] leading-snug text-[var(--color-navy-900)] flex-1">„{r.text}”</blockquote>
          <figcaption class="mt-8 text-sm"><span class="font-medium">{r.name}</span> <span class="text-[var(--color-ink-2)]">&middot; {r.role}</span></figcaption>
        </figure>
      ))}
    </div>
    <a href={`${base}velemenyek`} class="link-arrow mt-10 text-[var(--color-navy-800)]">Összes vélemény <span aria-hidden="true">&rarr;</span></a>
  </div>
  </section>

  <!-- PRICES -->
  <section class="bg-white border-y border-[var(--color-line)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-4">
        <p class="eyebrow">Árak</p>
        <h2 class="display mt-5 text-4xl lg:text-5xl text-[var(--color-navy-900)]">Két díjtétel, rejtett költség nélkül.</h2>
      </div>
      <div class="lg:col-span-8 grid sm:grid-cols-2 gap-6">
        <div class="border border-[var(--color-line)] p-8">
          <p class="font-mono text-xs uppercase tracking-wider text-[var(--color-ink-2)]">{clinic.prices.single.label} &middot; {clinic.prices.single.duration}</p>
          <p class="mt-4 font-heading text-5xl text-[var(--color-navy-900)]">{clinic.prices.single.amount}</p>
          <p class="mt-4 text-sm text-[var(--color-ink-2)]">Mozgásvizsgálat, kezelés és otthoni gyakorlatsor.</p>
        </div>
        <div class="border-2 border-[var(--color-teal-600)] p-8 bg-[var(--color-teal-50)]">
          <p class="font-mono text-xs uppercase tracking-wider text-[var(--color-teal-700)]">{clinic.prices.pass.label}</p>
          <p class="mt-4 font-heading text-5xl text-[var(--color-navy-900)]">{clinic.prices.pass.amount}</p>
          <p class="mt-4 text-sm text-[var(--color-ink-2)]">{clinic.prices.pass.perVisit}. Egészségpénztárra számlát adunk.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32 grid lg:grid-cols-12 gap-12">
    <div class="lg:col-span-4">
      <p class="eyebrow">Gyakori kérdések</p>
      <h2 class="display mt-5 text-4xl lg:text-5xl text-[var(--color-navy-900)]">Amit az első hívás előtt kérdezni szoktak.</h2>
      <a href={`${base}gyik`} class="link-arrow mt-8 text-[var(--color-navy-800)]">További kérdések <span aria-hidden="true">&rarr;</span></a>
    </div>
    <div class="lg:col-span-8 border-t border-[var(--color-line)]">
      {faqs.map((f, i) => (
        <details class="faq border-b border-[var(--color-line)]" open={i === 0}>
          <summary class="flex justify-between gap-6 py-6">
            <h3 class="font-heading text-xl lg:text-2xl text-[var(--color-navy-900)]">{f.q}</h3>
            <span class="plus text-2xl leading-none text-[var(--color-teal-600)]" aria-hidden="true">+</span>
          </summary>
          <p class="pb-7 -mt-1 text-[var(--color-ink-2)] leading-relaxed measure">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA (addresses live in the footer right below) -->
  <section class="bg-[var(--color-navy-900)] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <p class="eyebrow eyebrow-light">Időpontfoglalás</p>
      <h2 class="display mt-5 text-4xl lg:text-6xl max-w-3xl">Hívjon, és általában 1-2 napon belül tudunk időpontot adni.</h2>
      <div class="mt-10 flex flex-col sm:flex-row gap-3">
        <a href={`tel:${clinic.phone}`} class="btn btn-copper font-mono text-base">{clinic.phoneDisplay}</a>
        <a href={`${base}kapcsolat#idopontfoglalas`} class="btn border border-white/25 hover:border-white text-white">Rendelők és megközelítés</a>
      </div>
    </div>
  </section>
</BaseLayout>
