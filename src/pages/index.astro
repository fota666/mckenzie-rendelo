---
// Homepage (calm design): hero, complaint tiles, problem/solution rows, first visit, founder,
// team, proof and price, locations, closing call to action, questions.
import CalmLayout from '../layouts/CalmLayout.astro';
import LoopVideo from '../components/LoopVideo.astro';
import CalmCta from '../components/calm/CalmCta.astro';
import { clinic, reviewTotalText, moreThan, ratingText } from '../data/clinic';
import { situations } from '../data/situations';
import { firstVisit } from '../data/firstVisit';
import { founder } from '../data/founder';
import { terapeutak, clinicLabel, credentialed } from '../data/team';
import { homeFaqs } from '../data/homeFaq';
import { chooser } from '../data/chooser';
const base = import.meta.env.BASE_URL;

const people = terapeutak
  .filter((t) => !t.status && t.name !== founder.name)
  .map((t) => ({ name: t.name, role: t.title.split(',')[0], src: t.photo, loc: clinicLabel(t.name) }));

const reviews = [
  { text: 'Nincs gerincsérvből eredő kilátástalanság. A McKenzie-módszerrel gyakorlatilag visszakaptam az életem.', name: 'Kulcsár Krisztián', role: 'világbajnok vívó' },
  { text: 'A fájdalommentes életet jelenti az itt kapott kezelés. Professzionális ellátás, barátságos légkör, rendkívül hozzáértő gyógytornász!', name: 'Dr. Utassyné Kormos Zsuzsa', role: 'páciens' },
];
const half = Math.ceil(homeFaqs.length / 2);
// FAQ answers are plain text (they feed the schema elsewhere); the phone number becomes a call link when rendered.
const withPhoneLink = (t: string) => t.split(clinic.phoneDisplay).join(`<a href="tel:${clinic.phone}" class="k-link" style="white-space:nowrap">${clinic.phoneDisplay}</a>`);
const initials = (n: string) => { const w = n.replace(/^Dr\.\s*/, '').split(' '); return w[0][0] + w[w.length - 1][0]; };
type Loc = (typeof clinic.locations)[number];
// Directions to the exact coordinates of the Google profile, so the destination cannot be mistaken for a similar address.
const routeUrl = (l: Loc) => `https://www.google.com/maps/dir/?api=1&destination=${l.geo.lat},${l.geo.lng}`;
const mapSrc = (l: Loc) => `https://www.google.com/maps?q=${encodeURIComponent(`${l.googleName}, ${l.postalCode} Budapest`)}&ll=${l.geo.lat},${l.geo.lng}&z=16&output=embed`;
---

<CalmLayout title="McKenzie Gyógytorna Rendelő Budapest | Derék- és nyakfájás kezelése">
  <!-- Hero: light, the clip fades into the paper -->
  <section class="k-hero">
    <div class="k-wrap">
      <div class="k-hero__copy">
        <p class="k-eyebrow">Gyógytorna Budapesten &middot; V. és XI. kerület &middot; 1993 óta</p>
        <h1 class="k-h1">Gerinc- és ízületi fájdalom kezelése McKenzie-módszerrel.</h1>
        <p class="k-lead">Először megvizsgáljuk, mely mozgások enyhítik vagy erősítik a fájdalmát, majd megmutatjuk, milyen gyakorlatokkal segítheti Ön is a javulását. Beutaló nem kell, időpont általában 1-2 napon belül.</p>
        <div class="k-btns">
          <a href={`tel:${clinic.phone}`} class="k-btn k-btn--clay">Hívjon: {clinic.phoneDisplay}</a>
          <a href={`${base}kapcsolat#visszahivas`} class="k-btn k-btn--ghost">Visszahívást kérek</a>
        </div>
        <p class="k-small">Telefonon {clinic.bookingHoursShort}, a visszahívás-kérést bármikor elküldheti.</p>
        <div class="k-trust">
          <span><b>{ratingText(clinic.locations[0].rating.value)} / 5</b>{reviewTotalText} Google-vélemény</span>
          <span><b>{clinic.therapists} gyógytornász</b>két rendelőben</span>
          <span><b>{clinic.prices.single.range}</b>egy alkalom</span>
          <a href="#alapito"><b>Relle Éva alapította</b>1993-ban, McKenzie nemzetközi minősítővizsgával</a>
        </div>
      </div>
    </div>
    <div class="k-hero__media">
      <LoopVideo name="rendelo/hero-derekfajas" eager label="Gyógytornász hasonfekvő páciens derekát kezeli a rendelőben" />
    </div>
  </section>

  <!-- Chooser -->
  <section class="k-sec k-sec--sage">
    <div class="k-wrap">
      <div class="k-head">
        <p class="k-eyebrow">Mi a panasza?</p>
        <h2 class="k-h2">Válassza ki, mi fáj, és megmutatjuk, hogyan kezdünk hozzá.</h2>
      </div>
      <div class="k-vb">
        {chooser.map((c) => (
          <a href={`${base}${c.slug}`} class="k-vb__t">
            <img src={`${base}video/rendelo/${c.poster}.jpg`} alt="" loading="lazy" />
            <span class="k-vb__s"></span>
            <span class="k-vb__x"><strong>{c.name}</strong><small>{c.note}</small></span>
          </a>
        ))}
      </div>
      <div class="k-help">
        <div>
          <h3 class="k-h3">Nem biztos benne, melyik az Öné?</h3>
          <p class="k-small">Hívjon, és a panasza alapján segítünk kiválasztani a megfelelő terapeutát. Telefonon {clinic.bookingHoursShort}.</p>
        </div>
        <a href={`tel:${clinic.phone}`} class="k-btn k-btn--clay">{clinic.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <!-- Situations -->
  <section class="k-sec">
    <div class="k-wrap">
      <div class="k-head">
        <p class="k-eyebrow">Kik jönnek hozzánk</p>
        <h2 class="k-h2">Négy gyakori helyzet, amikor hozzánk fordulnak.</h2>
      </div>
      <ol class="k-rows">
        {situations.map((s) => (
          <li class="k-row">
            <h3 class="k-row__q">{s.title}</h3>
            <div class="k-row__a">
              <p>{s.body}</p>
              <p class="k-row__m">
                {s.methods.map((m, j) => <>{j > 0 && ' · '}<a href={`${base}${m.path}`} class="k-link">{m.label}</a>{m.when && <span class="k-small"> ({m.when})</span>}</>)}
              </p>
              {s.pages && (
                <p class="k-row__m k-small">Bővebben: {s.pages.map((pg, k) => <>{k > 0 && ' · '}<a href={`${base}${pg.path}`} class="k-link">{pg.label}</a></>)}</p>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- First visit -->
  <section class="k-sec k-sec--white">
    <div class="k-wrap">
      <div class="k-head">
        <p class="k-eyebrow">Az első alkalom</p>
        <h2 class="k-h2">50-55 perc: kikérdezés, vizsgálat, kezelés és saját gyakorlatsor.</h2>
      </div>
      <div class="k-visit">
        <div>
        <ol class="k-steps">
          {firstVisit.map((s, i) => (
            <li class="k-step">
              <span class="k-step__n">{i + 1}</span>
              <div>
                <p class="k-step__t">kb. {s.min} perc</p>
                <h3 class="k-h3">{s.title}</h3>
                <p class="k-small" style="margin-top:6px;font-size:1rem">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
          <p class="k-note">Az időbeosztás tájékoztató jellegű, az alkalom menete a panaszától függ. A vizsgálat alapján más kezelést, szükség esetén orvosi vizsgálatot is javasolhatunk.</p>
        </div>
        <aside>
          <div class="k-clip">
            <LoopVideo name="rendelo/csipo-mobilizalas-hanyatt" label="A gyógytornász a hanyatt fekvő páciens csípőjét és lábát mozgatja a rendelőben" />
          </div>
          <p class="k-cap">Kezelés a rendelőben. A módszert a vizsgálat dönti el.</p>
          <p style="margin-top:14px"><a href={`${base}modszerek`} class="k-link">Mind a 9 módszer és a szakmai háttér</a></p>
        </aside>
      </div>
    </div>
  </section>

  <!-- Founder: the philosophy is her own sentence, portrait beside it -->
  <section id="alapito" class="k-sec k-sec--pine">
    <div class="k-wrap k-fq">
      <div class="k-fq__photo">
        <img src={`${base}${founder.photo}`} alt={founder.name} loading="lazy" />
      </div>
      <div class="k-fq__txt">
        <p class="k-eyebrow">A rendelő filozófiája</p>
        <blockquote class="k-fq__quote">„{founder.philosophy}”</blockquote>
        <p class="k-fq__cite"><strong>{founder.name}</strong> <span>{founder.role}</span></p>
        <p class="k-fq__intro">{founder.intro}</p>
        <p><a href={`${base}csapatunk`} class="k-link" style="color:#fff;text-decoration-color:rgba(255,255,255,0.4)">A csapat</a></p>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="k-sec">
    <div class="k-wrap">
      <div class="k-head">
        <p class="k-eyebrow">Csapatunk</p>
        <h2 class="k-h2">{clinic.therapists - 1} gyógytornász Relle Éva mellett, két rendelőben.</h2>
        <p class="k-lead">Minden terapeutánk elvégezte a McKenzie-kurzusok legalább első három részét, a nemzetközi minősítővizsgát {credentialed.length} terapeutánk tette le. Telefonon a panasza alapján ajánlunk Önnek valakit.</p>
      </div>
      <img src={`${base}images/csapat/csapat-csoportkep.jpg`} alt="A McKenzie Gyógytorna Rendelő teljes gyógytornász csapata" class="k-group" width="2000" height="1336" loading="lazy" />
      <ul class="k-scroll">
        {people.map((p) => (
          <li class="k-person"><img src={p.src} alt={p.name} loading="lazy" /><strong>{p.name}</strong><span>{p.role}</span><em class="k-loc-tag">{p.loc}</em></li>
        ))}
      </ul>
      <p style="margin-top:14px"><a href={`${base}csapatunk`} class="k-link">Terapeuták rendelő, szakterület és ár szerint</a></p>
    </div>
  </section>

  <!-- Proof and price -->
  <section class="k-sec k-sec--sage">
    <div class="k-wrap">
      <div class="k-head">
        <p class="k-eyebrow">Vélemények és árak</p>
        <h2 class="k-h2">Mit mondanak a betegek, és mennyibe kerül az első alkalom.</h2>
      </div>
      <div class="k-statband">
        <div><b>{ratingText(clinic.locations[0].rating.value)}</b><i class="k-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</i><span>átlag a Google-on</span></div>
        <div><b>{reviewTotalText}</b><span>Google-vélemény a két rendelőről</span></div>
        <div><b>{clinic.therapists}</b><span>gyógytornász</span></div>
        <div><b>1993</b><span>óta működik a rendelő</span></div>
      </div>
      <div class="k-proof">
        <div class="k-quotes">
          {reviews.map((r) => (
            <figure class="k-qcard">
              <blockquote class="k-quote">{r.text}</blockquote>
              <figcaption><span class="k-av">{initials(r.name)}</span><span><strong>{r.name}</strong><small>{r.role}</small></span></figcaption>
            </figure>
          ))}
          <a href={`${base}velemenyek`} class="k-btn k-btn--ghost" style="justify-self:start">További vélemények, sajtó és TV <span aria-hidden="true">&rarr;</span></a>
        </div>
        <aside class="k-price k-price--dark">
          <p class="k-eyebrow">Árak</p>
          <ul>
            <li>
              <div><h3 class="k-h3">{clinic.prices.single.label}</h3><p class="k-small">{clinic.prices.single.duration}, {clinic.prices.single.note}</p></div>
              <b>{clinic.prices.single.range}</b>
            </li>
            <li>
              <div><h3 class="k-h3">{clinic.prices.pass.label}</h3><p class="k-small">{clinic.prices.pass.perVisit}, {clinic.prices.pass.saving}</p></div>
              <b>{clinic.prices.pass.amount}</b>
            </li>
          </ul>
          <p class="k-small" style="margin-top:16px">Az első alkalomra, a vizsgálatra is ugyanez az ár vonatkozik. Beutaló nem kell, egészségpénztárra számlát adunk.</p>
          <p style="margin-top:14px;font-size:0.95rem"><a href={`${base}araink`} class="k-link">Árak és tudnivalók</a> &nbsp;&middot;&nbsp; <a href={`${base}velemenyek`} class="k-link">Összes vélemény</a></p>
        </aside>
      </div>
    </div>
  </section>

  <!-- Locations -->
  <section class="k-sec">
    <div class="k-wrap">
      <div class="k-head">
        <p class="k-eyebrow">Rendelőink</p>
        <h2 class="k-h2">Két rendelő, a Bazilikánál és a Móricz Zsigmond körtérnél.</h2>
        <p class="k-lead">Mindkét rendelőben {clinic.hoursText} rendelünk, előzetes bejelentkezéssel.</p>
      </div>
      <div class="k-locs">
        {clinic.locations.map((l) => (
          <article class="k-loc">
            <div class="k-loc__map">
              <iframe src={mapSrc(l)} loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={`${l.name} térkép`}></iframe>
            </div>
            <div class="k-loc__body">
              <div class="k-loc__top">
                <span class="k-loc__d">{l.district.split('.')[0]}.</span>
                <div>
                  <h3 class="k-h3" style="font-size:1.45rem">{l.name}</h3>
                  <p class="k-small">{l.area}</p>
                </div>
              </div>
              <p class="k-loc__addr">{l.postalCode} Budapest,<br />{l.street}{l.bell && <>, {l.bell}</>}</p>
              <ul class="k-loc__list">
                {[l.transit, l.transitMore].map((t) => (
                  <li>
                    {(t.match(/M\d/g) ?? []).map((m) => <b class={`k-line k-line--${m.toLowerCase()}`}>{m}</b>)}
                    <span>{t.replace(/\s?M\d(, )?/g, ' ').replace(/\s+,/g, ',').replace(/\s{2,}/g, ' ').trim()}</span>
                  </li>
                ))}
                <li><b class="k-line k-line--p">P</b><span>Parkolás: {l.parking}</span></li>
              </ul>
              <div class="k-loc__foot">
                <a href={routeUrl(l)} target="_blank" rel="noopener" class="k-btn k-btn--clay">Útvonaltervezés</a>
                <a href={l.mapsUrl} target="_blank" rel="noopener" class="k-btn k-btn--ghost">Google-profil: {moreThan(l.rating.count)} vélemény, {ratingText(l.rating.value)} csillag</a>
              </div>
              <p class="k-small">{clinic.hoursText}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CalmCta />

  <!-- FAQ -->
  <section class="k-sec k-sec--sage">
    <div class="k-wrap">
      <div class="k-head">
        <p class="k-eyebrow">Kérdések</p>
        <h2 class="k-h2">Amit a betegek leggyakrabban kérdeznek.</h2>
      </div>
      <div class="k-faq">
        {[homeFaqs.slice(0, half), homeFaqs.slice(half)].map((col, c) => (
          <div>
            {col.map((f, i) => (
              <details open={c === 0 && i === 0}>
                <summary>{f.q}</summary>
                <p set:html={withPhoneLink(f.a)} />
              </details>
            ))}
          </div>
        ))}
      </div>
      <p style="margin-top:22px"><a href={`${base}gyik`} class="k-link">További kérdések</a></p>
    </div>
  </section>
</CalmLayout>
