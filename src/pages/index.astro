---
import BaseLayout from '../layouts/BaseLayout.astro';
import LoopVideo from '../components/LoopVideo.astro';
import Hero from '../components/Hero.astro';
import FounderD4 from '../components/founder/FounderD4.astro';
import SituationsB from '../components/situations/SituationsB.astro';
import { clinic, reviewTotal, ratingText } from '../data/clinic';
import { firstVisit } from '../data/firstVisit';
const base = import.meta.env.BASE_URL;

const facts = [
  { value: '1993', label: 'óta működik a rendelő' },
  { value: String(clinic.therapists), label: 'gyógytornász két rendelőben' },
  { value: '1-2', label: 'napos várakozási idő' },
  { value: ratingText(clinic.locations[0].rating.value), label: `átlag a Google-on, ${reviewTotal} vélemény` },
];



const methods = [
  { id: 'mckenzie', name: 'McKenzie-módszer (MDT)', for: 'derékfájás, nyakfájás, isiász, porckorongsérv' },
  { id: 'manualterapia', name: 'Manuálterápia (Maitland, Mulligan)', for: 'ízületi mozgásbeszűkülés, váll, csípő, térd' },
  { id: 'stabilizacio', name: 'Stabilizációs tréning', for: 'instabil vagy túlterhelt gerinc, lumbágó' },
  { id: 'schroth', name: 'Schroth-terápia', for: 'scoliosis, Scheuermann-betegség' },
  { id: 'mutet-utani', name: 'Műtét utáni rehabilitáció', for: 'gerinc-, csípő-, térdműtét, szalagszakadás' },
];

const team = [
  { name: 'Lipták Noémi', img: 'liptak_noemi.jpg' },
  { name: 'Vágó Eszter', img: 'vago_eszter.jpg' },
  { name: 'Cseh Ágnes', img: 'cseh_agnes.jpg' },
  { name: 'Takács Dóra', img: 'takacs_dora.jpg' },
  { name: 'Kókai Zsuzsa', img: 'kokai_zsuzsa.jpg' },
];

const reviews = [
  { text: 'Nincs gerincsérvből eredő kilátástalanság. A McKenzie-módszerrel gyakorlatilag visszakaptam az életem.', name: 'Kulcsár Krisztián', role: 'világbajnok vívó' },
  { text: 'A fájdalommentes életet jelenti az itt kapott kezelés. Professzionális ellátás, barátságos légkör, rendkívül hozzáértő gyógytornász!', name: 'Dr. Utassyné Kormos Zsuzsa', role: 'páciens' },
  { text: 'Mostanában semmi bajom. Mégis jövök. Kelleni kell valakinek. Testileg is, lelkileg is.', name: 'Havas Henrik', role: 'újságíró' },
];

// Answer-first wording. The FAQPage markup lives on /gyik only, so the two pages do not compete.
const faqs = [
  { q: 'Kell beutaló a McKenzie gyógytornához?', a: 'Nem kell beutaló, magánrendelésről van szó. Ha van korábbi MRI- vagy röntgenlelete, hozza magával az első alkalomra.' },
  { q: 'Mennyibe kerül egy kezelés?', a: `Egy 55 perces egyéni kezelés ${clinic.prices.single.amount}, ${clinic.prices.single.note}. Az 5 alkalmas bérlet ${clinic.prices.pass.amount}, ez ${clinic.prices.pass.perVisit}. A társadalombiztosítás nem fedezi a kezelés költségét, egészségpénztári elszámolásra alkalmas számlát adunk.` },
  { q: 'Hogyan foglalhatok időpontot, és mennyit kell várni?', a: `Telefonon foglalhat a ${clinic.phoneDisplay} számon, hétköznap 9 és 17 óra között, vagy kérhet visszahívást a weboldalon. Általában 1-2 napon belül tudunk időpontot adni. A kezelések hétköznap 8 és 20 óra között vannak, a V. és a XI. kerületi rendelőben.` },
  { q: 'Porckorongsérvvel is lehet gyógytornára jönni?', a: 'Igen. A porckorongsérv nagy része konzervatív kezelésre javul, ezért műtét előtt érdemes kipróbálni a McKenzie-módszert. Ha vizelet- vagy székletürítési zavar, gáttáji zsibbadás vagy gyorsan erősödő izomgyengeség jelentkezik, ne gyógytornára jöjjön, hanem azonnal forduljon orvoshoz.' },
];

---

<BaseLayout title="McKenzie Gyógytorna Rendelő Budapest | Derék- és nyakfájás kezelése">
  <Hero />

  <!-- SITUATIONS -->
  <SituationsB />

  <FounderD4 />

  <!-- FACTS -->
  <section class="border-y border-[var(--color-line)]">
    <dl class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 lg:grid-cols-4 divide-x divide-[var(--color-line)]">
      {facts.map((f, i) => (
        <div class={`py-8 lg:py-10 ${i % 2 === 0 ? 'pr-4' : 'pl-6'} lg:px-8 ${i === 0 ? 'lg:pl-0' : ''} ${i > 1 ? 'border-t lg:border-t-0 border-[var(--color-line)]' : ''}`}>
          <dd class="font-heading text-3xl sm:text-4xl lg:text-5xl whitespace-nowrap text-[var(--color-navy-900)]">{f.value}</dd>
          <dt class="mt-2 font-mono text-[0.82rem] tracking-wider uppercase text-[var(--color-ink-2)]">{f.label}</dt>
        </div>
      ))}
    </dl>
  </section>

  <!-- FIRST VISIT -->
  <section class="bg-[var(--color-navy-900)] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      <div class="grid lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow eyebrow-light">Az első alkalom</p>
          <h2 class="display mt-5 text-3xl lg:text-4xl">55 perc, és hazaviszi a saját gyakorlatsorát.</h2>
        </div>
        <p class="lg:col-span-5 text-white/70 leading-relaxed">Kényelmes, mozgásra alkalmas ruhát hozzon. Öltöző és mosdó mindkét rendelőben van.</p>
      </div>
      <ol class="mt-8 sm:mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-6 sm:gap-y-8">
        {firstVisit.map((step, i) => (
          <li>
            <div class="hidden sm:block aspect-[4/3] overflow-hidden bg-[var(--color-navy-800)]">
              {step.video ? (
                <LoopVideo name={step.video} label={step.title} class="w-full h-full object-cover" />
              ) : (
                <div class="h-full p-5 flex flex-col justify-end">
                  <p class="font-heading text-[1.35rem] leading-tight">Hozza magával a leleteit.</p>
                  <p class="mt-3 text-[15px] text-white/60">MRI-leletet, röntgenleletet és korábbi zárójelentést, ha van.</p>
                </div>
              )}
            </div>
            <p class="sm:mt-6 font-mono text-[13px] tracking-wider text-[var(--color-teal-300)]">{String(i + 1).padStart(2, '0')} &middot; {step.min}. perc</p>
            <h3 class="mt-3 font-heading text-[1.65rem]">{step.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-white/65">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- METHODS -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5">
        <p class="eyebrow">Kezelési módszerek</p>
        <h2 class="display mt-5 text-3xl lg:text-4xl text-[var(--color-navy-900)]">A McKenzie-módszer a fő szakterületünk, emellett nyolc másik eljárást is alkalmazunk.</h2>
        <p class="mt-6 text-[var(--color-ink-2)] leading-relaxed measure">Nem kell előre eldöntenie, melyik módszerre van szüksége. Az első vizsgálat után a terapeuta javaslatot tesz a megfelelő módszerek kombinációjára.</p>
        <div class="hidden sm:block mt-7 aspect-[4/3] max-w-md overflow-hidden bg-[var(--color-paper-2)]">
          <LoopVideo name="stabilizacio" label="Vállstabilizáló gyakorlat gumiszalaggal, gyógytornász felügyeletével" class="w-full h-full object-cover" />
        </div>
      </div>
      <ul class="lg:col-span-7 border-t border-[var(--color-line)]">
        {methods.map((m, i) => (
          <li class="border-b border-[var(--color-line)]">
            <a href={`${base}modszerek#${m.id}`} class="group grid grid-cols-[2.5rem_1fr_auto] items-baseline gap-4 py-4 hover:bg-white transition-colors px-2 -mx-2">
              <span class="font-mono text-[13px] text-[var(--color-teal-600)]">{String(i + 1).padStart(2, '0')}</span>
              <span>
                <span class="block font-heading text-[1.65rem] text-[var(--color-navy-900)]">{m.name}</span>
                <span class="block mt-1 text-[15px] text-[var(--color-ink-2)]">{m.for}</span>
              </span>
              <span aria-hidden="true" class="text-[var(--color-ink-2)] group-hover:text-[var(--color-navy-900)] group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
          </li>
        ))}
        <li class="pt-5">
          <a href={`${base}modszerek`} class="link-arrow text-[var(--color-navy-800)]">Mind a 9 módszer és a szakmai háttér <span aria-hidden="true">&rarr;</span></a>
        </li>
      </ul>
    </div>
  </section>

  <!-- TEAM -->
  <section class="bg-[var(--color-paper-2)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-5">
        <p class="eyebrow">Csapatunk</p>
        <h2 class="display mt-5 text-3xl lg:text-4xl text-[var(--color-navy-900)]">{clinic.therapists} gyógytornász Relle Éva vezetésével.</h2>
        <p class="mt-6 text-[var(--color-ink-2)] leading-relaxed measure">Minden terapeutánk McKenzie-képzésben részesült. Mindkét rendelőben egyformán képzett gyógytornászok dolgoznak, a terapeuták képesítéseit és nyelveit a csapat oldalán találja.</p>
        <a href={`${base}csapatunk`} class="link-arrow mt-8 text-[var(--color-navy-800)]">A teljes csapat <span aria-hidden="true">&rarr;</span></a>
      </div>
      <ul class="lg:col-span-7 grid grid-cols-3 gap-3">
        {team.map((t) => (
          <li>
            <div class="aspect-[3/4] overflow-hidden bg-white">
              <img src={`${base}images/${t.img}`} alt={t.name} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <p class="mt-2 text-[13px] text-[var(--color-ink-2)]">{t.name}</p>
          </li>
        ))}
        <li>
          <a href={`${base}csapatunk`} class="aspect-[3/4] flex flex-col justify-end p-4 bg-[var(--color-teal-700)] text-white hover:bg-[var(--color-teal-600)] transition-colors">
            <span class="font-heading text-3xl">+{clinic.therapists - team.length - 1}</span>
            <span class="text-[13px] text-white/70">további terapeuta</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="bg-[var(--color-paper-2)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
      <div>
        <p class="eyebrow">Vélemények</p>
        <h2 class="display mt-5 text-3xl lg:text-4xl text-[var(--color-navy-900)]">{reviewTotal} Google-értékelés a két rendelőről.</h2>
      </div>
      <div class="flex gap-8 font-mono text-[15px]">
        {clinic.locations.map((l) => (
          <a href={l.mapsUrl} target="_blank" rel="noopener" class="group">
            <span class="font-heading text-[1.65rem] text-[var(--color-navy-900)]">{ratingText(l.rating.value)}</span><br/>
            <span class="text-[13px] uppercase tracking-wider text-[var(--color-ink-2)] group-hover:text-[var(--color-teal-700)]">{l.name.split(' ')[0]} &middot; {l.rating.count} vélemény &rarr;</span>
          </a>
        ))}
      </div>
    </div>
    <div class="mt-7 grid md:grid-cols-3 gap-px bg-[var(--color-line)] border border-[var(--color-line)]">
      {reviews.map((r, i) => (
        <figure class:list={[i === 2 && "max-md:hidden", "bg-white p-5 lg:p-7 flex flex-col"]}>
          <blockquote class="font-heading text-[1.5rem] leading-snug text-[var(--color-navy-900)] flex-1">„{r.text}”</blockquote>
          <figcaption class="mt-8 text-[15px]"><span class="font-medium">{r.name}</span> <span class="text-[var(--color-ink-2)]">&middot; {r.role}</span></figcaption>
        </figure>
      ))}
    </div>
    <div class="mt-7 flex flex-wrap gap-x-8 gap-y-3 text-[15px]">
      <a href={`${base}velemenyek`} class="link-arrow text-[var(--color-navy-800)]">Összes vélemény <span aria-hidden="true">&rarr;</span></a>
      {clinic.locations.map((l) => <a href={l.mapsUrl} target="_blank" rel="noopener" class="link-arrow text-[var(--color-navy-800)]">{l.name} a Google-on <span aria-hidden="true">&rarr;</span></a>)}
    </div>
  </div>
  </section>

  <!-- PRICES -->
  <section class="border-y border-[var(--color-line)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-4">
        <p class="eyebrow">Árak</p>
        <h2 class="display mt-5 text-3xl lg:text-4xl text-[var(--color-navy-900)]">Átlátható árak, rejtett költség nélkül.</h2>
      </div>
      <div class="lg:col-span-8 grid sm:grid-cols-2 gap-6">
        <div class="border border-[var(--color-line)] p-5">
          <p class="font-mono text-[13px] uppercase tracking-wider text-[var(--color-ink-2)]">{clinic.prices.single.label} &middot; {clinic.prices.single.duration}</p>
          <p class="mt-4 font-heading text-3xl lg:text-4xl whitespace-nowrap text-[var(--color-navy-900)]">{clinic.prices.single.range}</p>
          <p class="mt-4 text-[15px] text-[var(--color-ink-2)]">Alkalmanként, {clinic.prices.single.note}. Mozgásvizsgálat, kezelés és otthoni gyakorlatsor.</p>
        </div>
        <div class="border-2 border-[var(--color-teal-600)] p-5 bg-[var(--color-teal-50)]">
          <p class="font-mono text-[13px] uppercase tracking-wider text-[var(--color-teal-700)]">{clinic.prices.pass.label}</p>
          <p class="mt-4 font-heading text-3xl lg:text-4xl whitespace-nowrap text-[var(--color-navy-900)]">{clinic.prices.pass.amount}</p>
          <p class="mt-4 text-[15px] text-[var(--color-ink-2)]">{clinic.prices.pass.perVisit}, {clinic.prices.pass.saving}. Egészségpénztárra számlát adunk.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 grid lg:grid-cols-12 gap-10">
    <div class="lg:col-span-4">
      <p class="eyebrow">Gyakori kérdések</p>
      <h2 class="display mt-5 text-3xl lg:text-4xl text-[var(--color-navy-900)]">Amit az első hívás előtt kérdezni szoktak.</h2>
      <a href={`${base}gyik`} class="link-arrow mt-8 text-[var(--color-navy-800)]">További kérdések <span aria-hidden="true">&rarr;</span></a>
    </div>
    <div class="lg:col-span-8 border-t border-[var(--color-line)]">
      {faqs.map((f, i) => (
        <details class="faq border-b border-[var(--color-line)]" open={i === 0}>
          <summary class="flex justify-between gap-6 py-4">
            <h3 class="font-heading text-[1.35rem] lg:text-[1.75rem] text-[var(--color-navy-900)]">{f.q}</h3>
            <span class="plus text-[1.65rem] leading-none text-[var(--color-teal-600)]" aria-hidden="true">+</span>
          </summary>
          <p class="pb-7 -mt-1 text-[var(--color-ink-2)] leading-relaxed measure">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA (addresses live in the footer right below) -->
  <section class="bg-[var(--color-navy-900)] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      <p class="eyebrow eyebrow-light">Időpontfoglalás</p>
      <h2 class="display mt-5 text-3xl lg:text-5xl max-w-3xl">Hívjon hétköznap 9 és 17 óra között, vagy kérjen visszahívást.</h2>
      <p class="mt-6 text-white/70 measure">Általában 1-2 napon belül tudunk időpontot adni valamelyik rendelőnkbe.</p>
      <div class="mt-7 flex flex-col sm:flex-row gap-3">
        <a href={`tel:${clinic.phone}`} class="btn btn-copper font-mono text-base">{clinic.phoneDisplay}</a>
        <a href={`${base}kapcsolat#visszahivas`} class="btn border border-white/25 hover:border-white text-white">Visszahívást kérek</a>
      </div>
    </div>
  </section>
</BaseLayout>
