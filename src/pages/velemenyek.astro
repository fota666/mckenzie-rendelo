---
// Reviews page (calm design): rating cards, two featured voices,
// a wall of patient reviews, press and TV, closing call to action.
import CalmLayout from '../layouts/CalmLayout.astro';
import CalmCta from '../components/calm/CalmCta.astro';
import { clinic, reviewTotalText, moreThan, ratingText } from '../data/clinic';

const featured = [
  {
    text: 'Nincs gerincsérvből eredő kilátástalanság. A McKenzie-módszerrel gyakorlatilag visszakaptam az életem. Tiszta szívből ajánlom mindenkinek, aki hasonló problémával küzd!',
    name: 'Kulcsár Krisztián', role: 'világbajnok vívó', initials: 'KK',
  },
];

const reviews = [
  { text: 'A fájdalommentes életet jelenti az itt kapott kezelés. Professzionális ellátás, barátságos légkör, rendkívül hozzáértő gyógytornász!', name: 'Dr. Utassyné Kormos Zsuzsa', role: 'páciens', initials: 'UK' },
  { text: 'Az izmokat újra feléleszteni segített, és a baleset előtti szintre hozni. Két kezelés után már éreztem a javulást, az otthoni gyakorlatok rendszeres végzésével azóta is panaszmentes vagyok.', name: 'S. Attila', role: 'páciens, 2009', initials: 'SA' },
  { text: 'Eszterrel élmény a gyógytorna is! Nagyon alapos és felkészült szakember. Először sport okozta deréksérüléssel kerestem fel. A közös munka lényegretörő és következetes volt, néhány hónapon belül érezhető volt a javulás. És a legfontosabb, hogy torna közben a nevetés sem marad el!', name: 'Izsák Eszter', role: 'páciens', initials: 'IE' },
  { text: 'Eszterhez egy évtizedes gerincfájdalom miatt jártam. Nagy körültekintéssel segített megtalálni a forrásokat, és olyan gyakorlatokkal és tanácsokkal látott el, amiket a mai napig használok, és működnek. Szívből ajánlom!', name: 'Kele Zsolt', role: 'páciens', initials: 'KZ' },
  { text: 'Deréktáji és vállpanaszokkal kerestem fel a rendelőt. Eszter professzionális felkészültségének és empatikus hozzáállásának köszönhetően rengeteg gyakorlatot tanultam. A gyakorlatsor a visszajelzéseim alapján minden alkalommal aktualizálva lett.', name: 'Szabó Péter', role: 'páciens', initials: 'SP' },
  { text: 'Hihetetlenül hálás vagyok, nagyon sokat segítettek az eredeti problémámon. Eszter mély tudással rendelkezik, nagyon profi. Mindent elmagyaráz a „miértről" a „hogyanig". Inspirál, támogat, buzdít. Nagyon jó érzés ilyen jó kezekben lenni!', name: 'Audrey', role: 'páciens', initials: 'A' },
  { text: 'Eszti szuper szaktudással rendelkezik. Két hét alatt járóképessé varázsolt két kiszakadt porckorong sérvvel. Már három éve járok hozzá karbantartásra. Összeállította az otthoni gyakorlataimat, figyelembe véve az állapotom változásait.', name: 'Balla Zoltán', role: 'páciens', initials: 'BZ' },
  { text: 'Magas színvonalú szolgáltatást kapok elérhető áron. Csak ajánlani és dicsérni tudom a rendelőt és az összes gyógytornászt!', name: 'Anonim páciens', role: 'visszajelző kérdőív', initials: '★' },
  { text: 'Vágó Eszternél volt a lányom. Alapos, jó szakember és nagyon kedves.', name: 'Füzesi Katalin', role: 'páciens', initials: 'FK' },
];
// Mix the voices: reviews about one therapist go last so the page does not read as her advertisement.
const wallMixed = [...reviews].sort((a, b) => Number(/Eszt/.test(a.text)) - Number(/Eszt/.test(b.text)));

// Public Google reviews of both clinics, copied word for word (full reviews only, no cut-off ones). Names shortened to surname and initial.
const googleReviews = [
  { text: 'Hozzáértő, rátermett gyógytornász szakemberek. Támogató légkör, kedves, gondos, személyre szabott törődés a páciensekkel. Kiváló lokáció, tiszta, korrekt, jól felszerelt rendelő.', name: 'Halasi Á.' },
  { text: 'Profi csapat, nagy empátiával és szaktudással rendelkeznek. Többször visszatértem különböző mozgásszervi problémákkal, és mindig tökéletesen "összeraktak". Hálás vagyok nekik, nem mennék máshova :-)', name: 'Román M.' },
  { text: 'Várkövi Évához járok már 5. éve. Szakmailag kimagasló, empatikus, segítőkész. A problémához igazodó, az egész testet átmozgató gyakorlatai változatosak.', name: 'Biczó I.' },
  { text: 'Empatikus, kedves, lelkiismeretes gyógytornász Takács Dóra. Több éve hozzájárok és nagyon sokat segít az állapotom szinten tartásában. A rendelőben az ott dolgozók mindegyike barátságos, udvarias. Szeretek oda járni. Szívből ajánlom mindenkinek.', name: 'Hanker K.' },
  { text: 'Szakmailag és emberileg is szuper hely, maximális elkötelezettséggel végzi Judit a munkáját, jó szívvel tudom ajánlani.', name: 'Kunné Porkoláb A.' },
  { text: 'Porckorongsérvvel fordultam a rendelőhöz. A bejelentkezés egyszerűen és gyorsan ment. A rendelő tiszta, a gyógytornász pedig időben fogadott. Már pár alkalom után nagy javulást érzek. Köszönöm a segítséget!', name: 'Nyerges B.' },
  { text: 'Nagyon felkészült és tapasztalt szakemberek, nyugodt környezet jellemzi. A kislányunk Ágihoz jár, nyugodt szívvel ajánljuk és köszönjük folyamatos segítséget!', name: 'Guzmics K.' },
  { text: 'Nagyon profi a támogatás, itt lehet gyógyulni! Az udvariasság, a nyugalom, a szakszerűség lengi be a helyet, jól érzi magát az ember.', name: 'Kun T.' },
  { text: 'Kétszer jártam náluk, mindkétszer megoldották a problámat. Felkészültek, kedvesek, hatékonyak - csak ajánlani tudom őket! Köszönöm', name: 'Csepregi M.' },
  { text: 'Több, mint egy éve járok rendszeresen órákra, maximálisan elégedett vagyok, sokat tanultam magamról és a mozgásról, fizikai állapotom gyorsan javulásnak indult.', name: 'Ober Gy.' },
  { text: 'Egyértelműen csakis csillagos ötös. Kedvesség, szakszerű segítség, külön figyelem minden egyes pácienshez és az állapotához. Csak ajánlani tudom.', name: 'Tkacsuk A.' },
  { text: 'Kiváló szakemberek, nagy fokú segítségnyújtás és problémamegoldás, remek hangulatú kezelések! Szívből ajánlom!', name: 'Blaskó T.' },
  { text: 'Nagyon sok gyógytornásznál voltam sport sérülések miatt, rengeteg negatív tapasztalat után kerültem ide. De ezen a helyen a tökéletes szakértelem és a kedvesség teljesen megváltoztatta a negatív tapasztalataimat. Csak ajánlani tudom a helyet.', name: 'Michl G.' },
  { text: 'A mckenzie gerinctorna mesterei. Évek óta lumbagós vagyok, amint kiújul mindig elmegyek a Bartók Béla úti rendelőbe egy kis utókezelésre. Szakszerű és kedves gyógytornászok, csak ajánlani tudom.', name: 'Bölcső G.' },
  { text: 'Évek óta ide járok, bármilyen sérülésem is van. Mindig van megoldás és érthető magyarázatot is kapok. Csak ajánlani tudom!', name: 'Hofmann-Kováts Á.' },
  { text: 'Nagyon kedves, jó ellátást kaptam Sylviától, minden porcikámmal foglalkozott rendkívüli odafigyeléssel és szakértelemmel. Köszönöm a gondoskodást.', name: 'Káldi K.' },
  { text: 'Akut probléma kezelésére, vagy megelőző terápiára is kiváló ez a rendelő. Kellemes, jól felszerelt környezetben profi, figyelmes gyógytornász segítette a műtét utáni rehabilitációmat, azóta pedig a prevenciós tornámat. A családom is ide jár, ha panasza van.', name: 'Pados G.' },
  { text: 'A helyet nagyon szeretem, a szakszerűség, sok figyelem, precizitás és nagyon pozitív hozzáállás illtve légkör miatt.', name: 'Nyéki A.' },
  { text: 'Kulturált rendelő a belvárosban, komoly felkészültséggel bíró gyógytornászokkal. Csak ajánlani tudom!', name: 'Bors G.' },
  { text: 'Vágó Eszter kiváló munkát végzett a fájó nyakammal. Csak ajánlani tudom!', name: 'Buza Zs.' },
  { text: 'Igényes környezet . Szakértelem ,hozzáértés , precizitás , alaposság , tökéletes gyakorlatok. Köszönöm!', name: 'Dósa L.' },
].map((r) => {
  const w = r.name.replace('.', '').split(' ');
  return { ...r, role: 'Google-vélemény', initials: w[0][0] + w[w.length - 1][0], verbatim: true };
});
const TOPICS = [
  { id: 'gerinc', label: 'Derék és gerinc', re: /derék|gerinc|sérv|lumbag|ülőmunka|csigolya/i },
  { id: 'nyak', label: 'Nyak és váll', re: /nyak|váll/i },
  { id: 'mutet', label: 'Műtét után, sérülés után', re: /műtét|keresztszalag|gipsz|rehabilit|baleset|sérülés/i },
  { id: 'gyerek', label: 'Gyerekek', re: /gyerek|lány|kislány|fiam|gyermek/i },
];
const wall = [...wallMixed.map((r) => ({ ...r, verbatim: false })), ...googleReviews].map((r) => ({
  ...r,
  tags: TOPICS.filter((t) => t.re.test(r.text)).map((t) => t.id).join(' '),
}));
const topicCount = (id: string) => wall.filter((r) => r.tags.split(' ').includes(id)).length;
const FIRST = 9;

const press = [
  { title: 'McKenzie módszer a gerincproblémák gyógyítására', source: 'Sikeres Nők', issue: 'XI. évf. 2008. április, 123. szám', quote: 'Ha időben lépünk, elkerülhetjük a bajt, megelőzhetjük a kiújuló fájdalmakat.', desc: 'Interjú Relle Évával a McKenzie-módszerről, a gerincproblémák mozgásalapú kezeléséről.' },
  { title: 'Gyakorlatok derékfájás ellen', source: 'Nők Lapja Egészség', issue: 'V. évf. 4-5-6. szám, 2011', quote: 'Az esetek 80%-ában a derékfájás kiújuló jellegű betegség.', desc: 'A cikk egyéni mozgásvizsgálatra épülő megelőző gyakorlatokat mutat be, például ülőmunkát végzőknek.' },
  { title: 'Derék dolog hátfájásra', source: 'Elixír Magazin', issue: '2011. szeptember', quote: 'A McKenzie-módszer a gerincproblémák speciális vizsgálati és kezelési rendszere.', desc: 'A McKenzie-módszer bemutatása Relle Éva nyilatkozatával. A módszert Robin McKenzie új-zélandi gyógytornász dolgozta ki.' },
  { title: 'McKenzie-módszer: Egyszerű mozdulatokkal a fájdalommentes életért', source: 'Phoenix Pharma', issue: '2010. május', quote: '', desc: 'Kérdések és válaszok Relle Évával arról, hogyan enyhíthető a hát- és derékfájás egyszerű mozdulatokkal.' },
  { title: 'Az irodai munka veszélyei', source: 'Pályacsúcs Magazin', issue: '2010. február', quote: '', desc: 'Az irodai munkához kapcsolódó egészségi problémák és megelőzésük.' },
];
const year = (s: string) => s.match(/(20\d\d)/)?.[1] ?? '';

const tv = [
  { title: 'RTL+: A McKenzie-módszerről', date: '2026. június', note: '3 perces összeállítás, a rendelőben forgatva', featured: true },
  { title: 'Esésmegelőzés', date: '2014. november 10.', note: 'MTV1 Családbarát: hogyan segíthet a gyógytorna az esések megelőzésében' },
  { title: 'Csontritkulás', date: '2015. január 15.', note: 'MTV1 Családbarát: a csontritkulással kapcsolatos gyógytorna teendők' },
  { title: 'Térdsérülések', date: '2015. október 13.', note: 'MTV1 Családbarát: a térdsérülések gyógytornája' },
];
---

<CalmLayout
  title="Vélemények és sajtó | McKenzie Gyógytorna Rendelő Budapest"
  description={`${reviewTotalText} Google-értékelés a két rendelőről, páciensvélemények, sajtómegjelenések és TV-szereplések.`}
>
  <!-- Rating cards -->
  <section class="k-sec k-sec--pine" style="padding-bottom:clamp(48px,6vw,80px)">
    <div class="k-wrap k-rhero">
      <div>
        <p class="k-eyebrow">Vélemények</p>
        <h1 class="k-h1" style="color:#fff;margin:14px 0 20px">Így írnak rólunk a betegeink.</h1>
        <p class="k-lead">{reviewTotalText} Google-értékelés a két rendelőről, {ratingText(clinic.locations[0].rating.value)} átlaggal, és a páciensek saját szavai alább.</p>
        <p class="k-small" style="margin-top:18px">A pontszámok a Google-profilokról származnak, utoljára 2026. októberben ellenőrizve.</p>
      </div>
      <div class="k-rcards">
        {clinic.locations.map((l) => (
          <a href={l.mapsUrl} target="_blank" rel="noopener" class="k-rcard">
            <span class="k-rcard__n">{ratingText(l.rating.value)}</span>
            <span class="k-rcard__m">
              <i class="k-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</i>
              <strong>{l.name}</strong>
              <small>{moreThan(l.rating.count)} Google-vélemény</small>
            </span>
            <span class="k-rcard__go" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Two featured voices -->
  <section class="k-sec">
    <div class="k-wrap k-voices">
      {featured.map((r) => (
        <figure class="k-voice">
          <blockquote>{r.text}</blockquote>
          <figcaption><span class="k-av k-av--lg">{r.initials}</span><span><strong>{r.name}</strong><small>{r.role}</small></span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- Wall of reviews: topic filter, first nine, then "show more" -->
  <section class="k-sec k-sec--sage" id="velemenyek-lista">
    <div class="k-wrap" data-wall>
      <div class="k-head">
        <p class="k-eyebrow">Páciensvélemények</p>
        <h2 class="k-h2">Mit írnak a pácienseink?</h2>
      </div>
      <div class="k-fchips" role="group" aria-label="Szűrés témára">
        <button type="button" data-topic="all" aria-pressed="true">Mind <span>{wall.length}</span></button>
        {TOPICS.map((t) => <button type="button" data-topic={t.id} aria-pressed="false">{t.label} <span>{topicCount(t.id)}</span></button>)}
      </div>
      <div class="k-wall">
        {wall.map((r, i) => (
          <figure class="k-qcard" data-tags={r.tags} data-i={i}>
            <blockquote class="k-quote">{r.text}</blockquote>
            <figcaption><span class="k-av" data-notranslate>{r.initials}</span><span><strong data-notranslate>{r.name}</strong><small>{r.role}</small></span></figcaption>
          </figure>
        ))}
      </div>
      <div class="k-more">
        <button type="button" class="k-btn k-btn--ghost" data-more>Továbbiak megjelenítése</button>
        {clinic.locations.map((l) => <a href={l.mapsUrl} target="_blank" rel="noopener" class="k-link">{l.name}: összes Google-vélemény</a>)}
      </div>
    </div>
  </section>

  <!-- Press and TV -->
  <section class="k-sec k-sec--white">
    <div class="k-wrap k-pressgrid">
      <div class="k-pressgrid__head">
        <p class="k-eyebrow">Sajtó és TV</p>
        <h2 class="k-h2" style="margin-top:14px">Korábbi sajtó- és televíziós megjelenések</h2>
        <p class="k-lead" style="margin-top:14px">Magazincikkek és tévéműsorok 2008-tól 2026-ig.</p>
      </div>
      <div>
        <ul class="k-press">
          {press.map((p) => (
            <li>
              <span class="k-press__y">{year(p.issue)}</span>
              <div>
                <p class="k-press__s">{p.source} <span>&middot; {p.issue}</span></p>
                <h3 class="k-h3" style="font-size:1.3rem">{p.title}</h3>
                {p.desc && <p class="k-press__d">{p.desc}</p>}
                {p.quote && <p class="k-press__q">„{p.quote}”</p>}
              </div>
            </li>
          ))}
        </ul>
        <ul class="k-tv">
          {tv.map((t) => (
            <li class:list={[t.featured && 'k-tv--feat']}><b>TV</b><span><strong>{t.title}</strong>{t.note && <em>{t.note}</em>}<small>{t.date}</small></span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <CalmCta tone="gold" title="Szeretne segítséget kapni a panaszaira? Kérjen időpontot!" />
</CalmLayout>

<script define:vars={{ FIRST }}>
  document.querySelectorAll('[data-wall]').forEach((root) => {
    const cards = [...root.querySelectorAll('.k-qcard')];
    const btns = [...root.querySelectorAll('[data-topic]')];
    const more = root.querySelector('[data-more]');
    let topic = 'all';
    let shown = FIRST;
    const render = () => {
      const match = cards.filter((c) => topic === 'all' || (c.dataset.tags || '').split(' ').includes(topic));
      cards.forEach((c) => { c.hidden = true; });
      match.slice(0, shown).forEach((c) => { c.hidden = false; });
      more.hidden = match.length <= shown;
    };
    btns.forEach((b) => b.addEventListener('click', () => {
      topic = b.dataset.topic; shown = FIRST;
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      render();
    }));
    more.addEventListener('click', () => { shown += 9; render(); });
    render();
  });
</script>
