---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { clinic, reviewTotal, ratingText } from '../data/clinic';
const base = import.meta.env.BASE_URL;

const starSvg = '<svg class="w-5 h-5 text-gold-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>';

const featured = [
  {
    text: 'Mostanában semmi bajom. Mégis jövök. Miért? Kelleni kell valakinek. Testileg is, lelkileg is. Relle Éva az, aki mindkettőt adja. Náluk megkapom a testileg és lelkileg egyaránt szükséges törődést.',
    name: 'Havas Henrik',
    role: 'újságíró',
    initials: 'HH',
    color: 'navy',
  },
  {
    text: 'Nincs gerincsérvből eredő kilátástalanság. A McKenzie-módszerrel gyakorlatilag visszakaptam az életem. Tiszta szívből ajánlom mindenkinek, aki hasonló problémával küzd!',
    name: 'Kulcsár Krisztián',
    role: 'világbajnok vívó',
    initials: 'KK',
    color: 'teal',
  },
];

const reviews = [
  {
    text: 'A fájdalommentes életet jelenti az itt kapott kezelés. Professzionális ellátás, barátságos légkör, rendkívül hozzáértő gyógytornász!',
    name: 'Dr. Utassyné Kormos Zsuzsa',
    role: 'páciens',
    initials: 'UK',
  },
  {
    text: 'Az izmokat újra feléleszteni segített, és a baleset előtti szintre hozni. Két kezelés után már éreztem a javulást, az otthoni gyakorlatok rendszeres végzésével azóta is panaszmentes vagyok.',
    name: 'S. Attila',
    role: 'páciens, 2009',
    initials: 'SA',
  },
  {
    text: 'Eszterrel élmény a gyógytorna is! Nagyon alapos és felkészült szakember. Először sport okozta deréksérüléssel kerestem fel. A közös munka lényegretörő és következetes volt, néhány hónapon belül érezhető volt a javulás. És a legfontosabb, hogy torna közben a nevetés sem marad el!',
    name: 'Izsák Eszter',
    role: 'páciens',
    initials: 'IE',
  },
  {
    text: 'Eszterhez egy évtizedes gerincfájdalom miatt jártam. Nagy körültekintéssel segített megtalálni a forrásokat, és olyan gyakorlatokkal és tanácsokkal látott el, amiket a mai napig használok, és működnek. Szívből ajánlom!',
    name: 'Kele Zsolt',
    role: 'páciens',
    initials: 'KZ',
  },
  {
    text: 'Deréktáji és vállpanaszokkal kerestem fel a rendelőt. Eszter professzionális felkészültségének és empatikus hozzáállásának köszönhetően rengeteg gyakorlatot tanultam. A gyakorlatsor a visszajelzéseim alapján minden alkalommal aktualizálva lett.',
    name: 'Szabó Péter',
    role: 'páciens',
    initials: 'SZP',
  },
  {
    text: 'Hihetetlenül hálás vagyok, nagyon sokat segítettek az eredeti problémámon. Eszter mély tudással rendelkezik, nagyon profi. Mindent elmagyaráz a „miértről" a „hogyanig". Inspirál, támogat, buzdít. Nagyon jó érzés ilyen jó kezekben lenni!',
    name: 'Audrey',
    role: 'páciens',
    initials: 'A',
  },
  {
    text: 'Eszti szuper szaktudással rendelkezik. Két hét alatt járóképessé varázsolt két kiszakadt porckorong sérvvel. Már három éve járok hozzá karbantartásra. Összeállította az otthoni gyakorlataimat, figyelembe véve az állapotom változásait.',
    name: 'Balla Zoltán',
    role: 'páciens',
    initials: 'BZ',
  },
  {
    text: 'Magas színvonalú szolgáltatást kapok elérhető áron. Csak ajánlani és dicsérni tudom a rendelőt és az összes gyógytornászt!',
    name: 'Anonim páciens',
    role: 'visszajelző kérdőív',
    initials: '★',
  },
  {
    text: 'Vágó Eszternél volt a lányom. Alapos, jó szakember és nagyon kedves.',
    name: 'Füzesi Katalin',
    role: 'páciens',
    initials: 'FK',
  },
];

const press = [
  {
    title: 'McKenzie módszer a gerincproblémák gyógyítására',
    source: 'Sikeres Nők',
    issue: 'XI. évf. 2008. április, 123. szám',
    quote: 'Ha időben lépünk, elkerülhetjük a bajt, megelőzhetjük a kiújuló fájdalmakat.',
  },
  {
    title: 'Gyakorlatok derékfájás ellen',
    source: 'Nők Lapja Egészség',
    issue: 'V. évf. 4-5-6. szám, 2011',
    quote: 'Az esetek 80%-ában a derékfájás kiújuló jellegű betegség.',
  },
  {
    title: 'Derék dolog hátfájásra',
    source: 'Elixír Magazin',
    issue: '2011. szeptember',
    quote: 'A McKenzie-módszer a gerincproblémák speciális vizsgálati és kezelési rendszere.',
  },
  {
    title: 'McKenzie-módszer: Egyszerű mozdulatokkal a fájdalommentes életért',
    source: 'Phoenix Pharma',
    issue: '2010. május',
    quote: '',
  },
  {
    title: 'Az irodai munka veszélyei',
    source: 'Pályacsúcs Magazin',
    issue: '2010. február',
    quote: '',
  },
];

const tv = [
  { title: 'Esésmegelőzés', date: '2014. november 10.' },
  { title: 'Csontrikula', date: '2015. január 15.' },
  { title: 'Térdsérülések', date: '2015. október 13.' },
];
---

<BaseLayout
  title="Vélemények és sajtó | McKenzie Gyógytorna Rendelő Budapest"
  description={`${reviewTotal} Google-értékelés a két rendelőről, páciensvélemények, sajtómegjelenések és TV-szereplések.`}
>
  <PageHeader eyebrow="Vélemények">
    <Fragment slot="title">{reviewTotal} Google-értékelés és a páciensek írásos véleményei.</Fragment>
    {clinic.locations.map((l, i) => <>{i > 0 && ', '}<a href={l.mapsUrl} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-[var(--color-teal-700)]">{l.name}: {ratingText(l.rating.value)} ({l.rating.count} vélemény)</a></>)}. A pontszámok a Google-profilokról származnak, utoljára 2026. októberben ellenőrizve.
  </PageHeader>

  <section class="bg-[var(--color-teal-50)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20 grid lg:grid-cols-2 gap-px bg-[var(--color-teal-100)] border border-[var(--color-teal-100)]">
      {featured.map((r) => (
        <figure class="bg-white p-10 lg:p-10 flex flex-col">
          <blockquote class="font-heading text-[1.65rem] lg:text-[1.9rem] leading-snug text-[var(--color-navy-900)] flex-1">„{r.text}”</blockquote>
          <figcaption class="mt-10 text-[15px]"><span class="font-medium">{r.name}</span> <span class="text-[var(--color-ink-2)]">&middot; {r.role}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20">
    <h2 class="display text-3xl lg:text-4xl text-[var(--color-navy-900)]">Pácienseink mondják</h2>
    <div class="mt-8 columns-1 md:columns-2 lg:columns-3 gap-6 [column-fill:_balance]">
      {reviews.map((r) => (
        <figure class="break-inside-avoid mb-6 bg-white border border-[var(--color-line)] p-7">
          <blockquote class="leading-relaxed text-[var(--color-ink)]">„{r.text}”</blockquote>
          <figcaption class="mt-5 pt-4 border-t border-[var(--color-line)] text-[15px]"><span class="font-medium">{r.name}</span> <span class="text-[var(--color-ink-2)]">&middot; {r.role}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="bg-[var(--color-paper-2)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20 grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-4">
        <p class="eyebrow">Sajtó és TV</p>
        <h2 class="display mt-5 text-3xl lg:text-4xl text-[var(--color-navy-900)]">Ahol a McKenzie-módszerről beszéltünk.</h2>
      </div>
      <div class="lg:col-span-8">
        <ul class="border-t border-[var(--color-line)]">
          {press.map((p) => (
            <li class="py-6 border-b border-[var(--color-line)] grid sm:grid-cols-[12rem_1fr] gap-2 sm:gap-6">
              <p class="font-mono text-[13px] uppercase tracking-wider text-[var(--color-teal-700)] pt-1.5">{p.source}<br /><span class="text-[var(--color-ink-2)] normal-case tracking-normal">{p.issue}</span></p>
              <div>
                <h3 class="font-heading text-[1.65rem] text-[var(--color-navy-900)]">{p.title}</h3>
                {p.quote && <p class="mt-2 text-[var(--color-ink-2)] italic">„{p.quote}”</p>}
              </div>
            </li>
          ))}
        </ul>
        <h3 class="mt-10 font-mono text-[13px] uppercase tracking-wider text-[var(--color-ink-2)]">TV-szereplések</h3>
        <ul class="mt-4 grid sm:grid-cols-3 gap-4">
          {tv.map((t) => (
            <li class="bg-white border border-[var(--color-line)] p-5">
              <p class="font-heading text-[1.35rem] text-[var(--color-navy-900)]">{t.title}</p>
              <p class="mt-1 text-[15px] text-[var(--color-ink-2)]">{t.date}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-navy-900)] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 grid lg:grid-cols-12 gap-8 items-end">
      <h2 class="lg:col-span-8 display text-3xl lg:text-4xl">Időpontot általában 1-2 napon belül tudunk adni.</h2>
      <div class="lg:col-span-4 lg:text-right">
        <a href={`tel:${clinic.phone}`} class="btn btn-copper font-mono">{clinic.phoneDisplay}</a>
      </div>
    </div>
  </section>
</BaseLayout>
