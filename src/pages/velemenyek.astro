---
// Reviews page (calm design): rating cards, two featured voices, phrases from the reviews,
// a wall of patient reviews, press and TV, closing call to action.
import CalmLayout from '../layouts/CalmLayout.astro';
import CalmCta from '../components/calm/CalmCta.astro';
import { clinic, reviewTotalText, moreThan, ratingText } from '../data/clinic';

const featured = [
  {
    text: 'Mostanában semmi bajom. Mégis jövök. Miért? Kelleni kell valakinek. Testileg is, lelkileg is. Relle Éva az, aki mindkettőt adja. Náluk megkapom a testileg és lelkileg egyaránt szükséges törődést.',
    name: 'Havas Henrik', role: 'újságíró', initials: 'HH',
  },
  {
    text: 'Nincs gerincsérvből eredő kilátástalanság. A McKenzie-módszerrel gyakorlatilag visszakaptam az életem. Tiszta szívből ajánlom mindenkinek, aki hasonló problémával küzd!',
    name: 'Kulcsár Krisztián', role: 'világbajnok vívó', initials: 'KK',
  },
];

// Short phrases, each copied from one of the reviews on this page.
const phrases = [
  'gyakorlatilag visszakaptam az életem',
  'Professzionális ellátás, barátságos légkör',
  'Két hét alatt járóképessé varázsolt',
  'Eszterrel élmény a gyógytorna is!',
  'Inspirál, támogat, buzdít',
  'Magas színvonalú szolgáltatást kapok elérhető áron',
  'Szívből ajánlom!',
  'olyan gyakorlatokkal és tanácsokkal látott el, amiket a mai napig használok',
];

const reviews = [
  { text: 'A fájdalommentes életet jelenti az itt kapott kezelés. Professzionális ellátás, barátságos légkör, rendkívül hozzáértő gyógytornász!', name: 'Dr. Utassyné Kormos Zsuzsa', role: 'páciens', initials: 'UK' },
  { text: 'Az izmokat újra feléleszteni segített, és a baleset előtti szintre hozni. Két kezelés után már éreztem a javulást, az otthoni gyakorlatok rendszeres végzésével azóta is panaszmentes vagyok.', name: 'S. Attila', role: 'páciens, 2009', initials: 'SA' },
  { text: 'Eszterrel élmény a gyógytorna is! Nagyon alapos és felkészült szakember. Először sport okozta deréksérüléssel kerestem fel. A közös munka lényegretörő és következetes volt, néhány hónapon belül érezhető volt a javulás. És a legfontosabb, hogy torna közben a nevetés sem marad el!', name: 'Izsák Eszter', role: 'páciens', initials: 'IE' },
  { text: 'Eszterhez egy évtizedes gerincfájdalom miatt jártam. Nagy körültekintéssel segített megtalálni a forrásokat, és olyan gyakorlatokkal és tanácsokkal látott el, amiket a mai napig használok, és működnek. Szívből ajánlom!', name: 'Kele Zsolt', role: 'páciens', initials: 'KZ' },
  { text: 'Deréktáji és vállpanaszokkal kerestem fel a rendelőt. Eszter professzionális felkészültségének és empatikus hozzáállásának köszönhetően rengeteg gyakorlatot tanultam. A gyakorlatsor a visszajelzéseim alapján minden alkalommal aktualizálva lett.', name: 'Szabó Péter', role: 'páciens', initials: 'SP' },
  { text: 'Hihetetlenül hálás vagyok, nagyon sokat segítettek az eredeti problémámon. Eszter mély tudással rendelkezik, nagyon profi. Mindent elmagyaráz a „miértről" a „hogyanig". Inspirál, támogat, buzdít. Nagyon jó érzés ilyen jó kezekben lenni!', name: 'Audrey', role: 'páciens', initials: 'A' },
  { text: 'Eszti szuper szaktudással rendelkezik. Két hét alatt járóképessé varázsolt két kiszakadt porckorong sérvvel. Már három éve járok hozzá karbantartásra. Összeállította az otthoni gyakorlataimat, figyelembe véve az állapotom változásait.', name: 'Balla Zoltán', role: 'páciens', initials: 'BZ' },
  { text: 'Magas színvonalú szolgáltatást kapok elérhető áron. Csak ajánlani és dicsérni tudom a rendelőt és az összes gyógytornászt!', name: 'Anonim páciens', role: 'visszajelző kérdőív', initials: '★' },
  { text: 'Vágó Eszternél volt a lányom. Alapos, jó szakember és nagyon kedves.', name: 'Füzesi Katalin', role: 'páciens', initials: 'FK' },
];
// Mix the voices: reviews about one therapist go last so the page does not read as her advertisement.
const wall = [...reviews].sort((a, b) => Number(/Eszt/.test(a.text)) - Number(/Eszt/.test(b.text)));

const press = [
  { title: 'McKenzie módszer a gerincproblémák gyógyítására', source: 'Sikeres Nők', issue: 'XI. évf. 2008. április, 123. szám', quote: 'Ha időben lépünk, elkerülhetjük a bajt, megelőzhetjük a kiújuló fájdalmakat.' },
  { title: 'Gyakorlatok derékfájás ellen', source: 'Nők Lapja Egészség', issue: 'V. évf. 4-5-6. szám, 2011', quote: 'Az esetek 80%-ában a derékfájás kiújuló jellegű betegség.' },
  { title: 'Derék dolog hátfájásra', source: 'Elixír Magazin', issue: '2011. szeptember', quote: 'A McKenzie-módszer a gerincproblémák speciális vizsgálati és kezelési rendszere.' },
  { title: 'McKenzie-módszer: Egyszerű mozdulatokkal a fájdalommentes életért', source: 'Phoenix Pharma', issue: '2010. május', quote: '' },
  { title: 'Az irodai munka veszélyei', source: 'Pályacsúcs Magazin', issue: '2010. február', quote: '' },
];
const year = (s: string) => s.match(/(20\d\d)/)?.[1] ?? '';

const tv = [
  { title: 'Esésmegelőzés', date: '2014. november 10.' },
  { title: 'Csontrikula', date: '2015. január 15.' },
  { title: 'Térdsérülések', date: '2015. október 13.' },
];
---

<CalmLayout
  title="Vélemények és sajtó | McKenzie Gyógytorna Rendelő Budapest"
  description={`${reviewTotalText} Google-értékelés a két rendelőről, páciensvélemények, sajtómegjelenések és TV-szereplések.`}
>
  <!-- Rating cards -->
  <section class="k-sec k-sec--pine" style="padding-bottom:clamp(48px,6vw,80px)">
    <div class="k-wrap k-rhero">
      <div>
        <p class="k-eyebrow">Vélemények</p>
        <h1 class="k-h1" style="color:#fff;margin:14px 0 20px">Így írnak rólunk a betegeink.</h1>
        <p class="k-lead">{reviewTotalText} Google-értékelés a két rendelőről, {ratingText(clinic.locations[0].rating.value)} átlaggal, és a páciensek saját szavai alább.</p>
        <p class="k-small" style="margin-top:18px">A pontszámok a Google-profilokról származnak, utoljára 2026. októberben ellenőrizve.</p>
      </div>
      <div class="k-rcards">
        {clinic.locations.map((l) => (
          <a href={l.mapsUrl} target="_blank" rel="noopener" class="k-rcard">
            <span class="k-rcard__n">{ratingText(l.rating.value)}</span>
            <span class="k-rcard__m">
              <i class="k-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</i>
              <strong>{l.name}</strong>
              <small>{moreThan(l.rating.count)} Google-vélemény</small>
            </span>
            <span class="k-rcard__go" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Two featured voices -->
  <section class="k-sec">
    <div class="k-wrap k-voices">
      {featured.map((r) => (
        <figure class="k-voice">
          <blockquote>{r.text}</blockquote>
          <figcaption><span class="k-av k-av--lg">{r.initials}</span><span><strong>{r.name}</strong><small>{r.role}</small></span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- Phrases -->
  <section class="k-sec k-sec--sage" style="padding-bottom:0">
    <div class="k-wrap">
      <div class="k-head">
        <p class="k-eyebrow">Mondatok a véleményekből</p>
        <h2 class="k-h2">Amit a legtöbbször leírnak.</h2>
      </div>
      <ul class="k-phr">
        {phrases.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- Wall of reviews -->
  <section class="k-sec k-sec--sage" style="padding-top:clamp(32px,4vw,48px)">
    <div class="k-wrap">
      <div class="k-wall">
        {wall.map((r) => (
          <figure class="k-qcard">
            <blockquote class="k-quote">{r.text}</blockquote>
            <figcaption><span class="k-av">{r.initials}</span><span><strong>{r.name}</strong><small>{r.role}</small></span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Press and TV -->
  <section class="k-sec k-sec--white">
    <div class="k-wrap k-pressgrid">
      <div class="k-pressgrid__head">
        <p class="k-eyebrow">Sajtó és TV</p>
        <h2 class="k-h2" style="margin-top:14px">Ahol a McKenzie-módszerről beszéltünk.</h2>
        <p class="k-lead" style="margin-top:14px">Magazinok és televíziós megjelenések 2008 és 2015 között.</p>
      </div>
      <div>
        <ul class="k-press">
          {press.map((p) => (
            <li>
              <span class="k-press__y">{year(p.issue)}</span>
              <div>
                <p class="k-press__s">{p.source} <span>&middot; {p.issue}</span></p>
                <h3 class="k-h3" style="font-size:1.3rem">{p.title}</h3>
                {p.quote && <p class="k-press__q">„{p.quote}”</p>}
              </div>
            </li>
          ))}
        </ul>
        <ul class="k-tv">
          {tv.map((t) => (
            <li><b>TV</b><span><strong>{t.title}</strong><small>{t.date}</small></span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <CalmCta tone="gold" title="Szeretne Ön is így beszélni a gyógytornáról? Hívjon." />
</CalmLayout>
