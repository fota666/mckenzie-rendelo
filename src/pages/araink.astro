---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { clinic } from '../data/clinic';

const plans = [
  {
    ...clinic.prices.single,
    note: 'alkalmanként, terapeutától függően',
    items: ['55 perces egyéni kezelés', 'Mozgásvizsgálat az első alkalommal', 'Személyre szabott gyakorlatsor', 'Otthoni gyakorlatok írásban', 'Szükség szerinti kontrollvizsgálat'],
    featured: false,
  },
  {
    ...clinic.prices.pass,
    note: clinic.prices.pass.perVisit,
    items: ['Ugyanaz, mint az egyéni kezelés', '10 000 Ft megtakarítás az 5 alkalmon', 'Rugalmasan felhasználható', 'Mindkét rendelőben érvényes'],
    featured: true,
  },
];

const notes = [
  { t: 'Társadalombiztosítás', d: 'A TB jelenleg nem fedezi a kezelés költségét. Magánbiztosítónál érdemes előre érdeklődni.' },
  { t: 'Egészségpénztár', d: 'Számlát adunk, amit az egészségpénztárnál visszatérítésre be lehet nyújtani.' },
  { t: 'Fizetés', d: 'Készpénzzel és bankkártyával is fizethet.' },
  { t: 'Lemondás', d: 'Kérjük, az időpontot legalább 24 órával korábban mondja le telefonon.' },
];
---

<BaseLayout
  title="Gyógytorna árak 2026 | McKenzie Gyógytorna Rendelő Budapest"
  description={`Egyéni gyógytorna ${clinic.prices.single.amount} / 55 perc, 5 alkalmas bérlet ${clinic.prices.pass.amount}. Egészségpénztárra számlát adunk, beutaló nem kell.`}
>
  <PageHeader eyebrow="Árak">
    <Fragment slot="title">Két díjtétel, rejtett költség nélkül.</Fragment>
    Az árak tartalmazzák a mozgásvizsgálatot, a kezelést és az otthoni gyakorlatsort. Beutaló nem kell, egészségpénztárra számlát adunk.
  </PageHeader>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 grid md:grid-cols-2 gap-6">
    {plans.map((p) => (
      <div class={`p-8 lg:p-12 flex flex-col ${p.featured ? 'bg-[var(--color-teal-50)] border-2 border-[var(--color-teal-600)]' : 'bg-white border border-[var(--color-line)]'}`}>
        <p class={`font-mono text-xs uppercase tracking-wider ${p.featured ? 'text-[var(--color-teal-700)]' : 'text-[var(--color-ink-2)]'}`}>{p.label}{p.featured && ' · kedvezményes'}</p>
        <p class="mt-6 font-heading text-6xl lg:text-7xl text-[var(--color-navy-900)]">{p.amount}</p>
        <p class="mt-2 text-sm text-[var(--color-ink-2)]">{p.note}</p>
        <ul class="mt-10 border-t border-[var(--color-line)] flex-1">
          {p.items.map((it) => (
            <li class="py-3 border-b border-[var(--color-line)] flex gap-3">
              <span class="text-[var(--color-teal-600)]" aria-hidden="true">&#10003;</span>{it}
            </li>
          ))}
        </ul>
        <a href={`tel:${clinic.phone}`} class={`btn mt-10 self-start ${p.featured ? 'btn-primary' : 'btn-ghost'}`}>{p.featured ? 'Bérletet kérek' : 'Időpontot kérek'} <span class="font-mono">{clinic.phoneDisplay}</span></a>
      </div>
    ))}
  </section>

  <section class="border-t border-[var(--color-line)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 grid lg:grid-cols-12 gap-10">
      <h2 class="lg:col-span-4 display text-4xl text-[var(--color-navy-900)]">Tudnivalók</h2>
      <dl class="lg:col-span-8 grid sm:grid-cols-2 gap-x-10 gap-y-8">
        {notes.map((n) => (
          <div class="border-t-2 border-[var(--color-teal-600)] pt-4">
            <dt class="font-heading text-2xl text-[var(--color-navy-900)]">{n.t}</dt>
            <dd class="mt-2 text-[var(--color-ink-2)] leading-relaxed">{n.d}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>
