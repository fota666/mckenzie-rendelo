---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaCard from '../components/CtaCard.astro';
import { clinic, healthFundNote } from '../data/clinic';
const base = import.meta.env.BASE_URL;

// A clinic price list, not a SaaS pricing table: two lines, what is included, practical notes.
const rows = [
  {
    name: clinic.prices.single.label,
    meta: clinic.prices.single.duration,
    detail: 'Mozgásvizsgálat, kezelés és személyre szabott otthoni gyakorlatsor.',
    price: clinic.prices.single.range,
    priceNote: clinic.prices.single.note,
    link: { href: `${base}csapatunk`, label: 'Árak terapeutánként' },
  },
  {
    name: clinic.prices.pass.label,
    meta: 'kedvezményes',
    detail: `${clinic.prices.pass.perVisit}, ${clinic.prices.pass.saving}. A bérlet felhasználásának feltételeiről telefonon tájékoztatunk.`,
    price: clinic.prices.pass.amount,
    priceNote: '5 egyéni kezelés',
    link: null,
  },
];

const notes = [
  { t: 'Beutaló', d: 'Nem kell, magánrendelésről van szó.' },
  { t: 'Társadalombiztosítás', d: 'A TB nem fedezi. Magánbiztosítónál érdemes előre érdeklődni.' },
  { t: 'Egészségpénztár', d: `${healthFundNote}, a feltételekről előzetesen érdemes egyeztetni a pénztárral.` },
  { t: 'Fizetés', d: 'Készpénzzel és bankkártyával.' },
  { t: 'Lemondás', d: 'Legalább 24 órával korábban, telefonon.' },
];
---

<BaseLayout
  title="Gyógytorna árak 2026 | McKenzie Gyógytorna Rendelő Budapest"
  description={`Egyéni gyógytorna ${clinic.prices.single.amount} / 50-55 perc, 5 alkalmas bérlet ${clinic.prices.pass.amount}. ${healthFundNote}, beutaló nem kell.`}
>
  <PageHeader eyebrow="Árak">
    <Fragment slot="title">Átlátható árak, rejtett költség nélkül.</Fragment>
    Egyéni kezelés vagy kedvezményes bérlet. Az alkalom díja a kikérdezést, a mozgásvizsgálatot, a kezelést és az otthoni gyakorlatok betanítását foglalja magában. Az első alkalomra is ugyanez az ár vonatkozik.
  </PageHeader>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14 lg:pb-20 grid lg:grid-cols-12 gap-10 lg:gap-14 items-start">
    <div class="lg:col-span-7">
      <h2 class="font-mono text-[13px] uppercase tracking-wider text-[var(--color-ink-2)]">Árlista</h2>
      <ul class="mt-3 border-t-2 border-[var(--color-navy-900)]">
        {rows.map((r) => (
          <li class="py-7 border-b border-[var(--color-line)] grid sm:grid-cols-[1fr_auto] gap-x-8 gap-y-3">
            <div>
              <p class="font-heading text-[1.65rem] lg:text-3xl text-[var(--color-navy-900)]">{r.name} <span class="font-mono text-[13px] uppercase tracking-wider text-[var(--color-teal-700)] align-middle">{r.meta}</span></p>
              <p class="mt-2 text-[var(--color-ink-2)] leading-relaxed max-w-md">{r.detail}</p>
              {r.link && <a href={r.link.href} class="link-arrow mt-3 text-[15px] text-[var(--color-navy-800)]">{r.link.label} <span aria-hidden="true">&rarr;</span></a>}
            </div>
            <div class="sm:text-right">
              <p class="font-heading text-[1.65rem] lg:text-3xl whitespace-nowrap text-[var(--color-navy-900)]">{r.price}</p>
              <p class="text-[15px] text-[var(--color-ink-2)]">{r.priceNote}</p>
            </div>
          </li>
        ))}
      </ul>

      <h2 class="mt-10 font-mono text-[13px] uppercase tracking-wider text-[var(--color-ink-2)]">Tudnivalók</h2>
      <dl class="mt-3 border-t border-[var(--color-line)]">
        {notes.map((n) => (
          <div class="py-4 border-b border-[var(--color-line)] grid grid-cols-[10rem_1fr] sm:grid-cols-[12rem_1fr] gap-4">
            <dt class="font-medium text-[var(--color-ink)]">{n.t}</dt>
            <dd class="text-[var(--color-ink-2)]">{n.d}</dd>
          </div>
        ))}
      </dl>
    </div>

    <aside class="lg:col-span-5 lg:sticky lg:top-28 self-start"><CtaCard label="Időpontfoglalás" /></aside>
  </section>
</BaseLayout>
