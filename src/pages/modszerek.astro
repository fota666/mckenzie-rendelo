---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import LoopVideo from '../components/LoopVideo.astro';
import ExpertBackground from '../components/ExpertBackground.astro';
import ClosingCta from '../components/ClosingCta.astro';
const base = import.meta.env.BASE_URL;

const methods = [
  {
    id: 'mckenzie',
    clip: { name: 'derekfajas-hasonfekvo-mobilizalas', label: 'Hasonfekvő extenziós gyakorlat a gyógytornász irányításával' },
    title: 'McKenzie-módszer (Mechanikai Diagnózis és Terápia, MDT)',
    subtitle: 'Fő szakterületünk',
    image: `${base}images/modszerek/mckenzie.png`,
    featured: true,
    description: 'A McKenzie-módszer részletes mozgásvizsgálatra épülő egyéni mozgásprogram, amelyet elsősorban gerinceredetű panaszoknál, például derékfájásnál, nyakfájásnál és porckorongsérvnél alkalmazunk.',
    details: 'A módszert Robin McKenzie új-zélandi gyógytornász fejlesztette ki, ma a McKenzie Institute International oktatja szerte a világon. Lényege, hogy a páciens aktív résztvevője saját gyógyulásának: a cél, hogy célzott gyakorlatokkal és önkezelési stratégiákkal maga is kezelni tudja a panaszát.',
    howItWorks: [
      'Alapos mozgásvizsgálat: ismételt speciális mozgások és testhelyzetek, miközben figyeljük a fájdalomra adott reakciót',
      'Egyénre szabott gyakorlatsor összeállítása',
      'Önkezelési stratégia megtanítása: a páciens képessé válik saját panaszai kezelésére',
      'Rendszeres kontroll és a program finomhangolása',
    ],
    conditions: ['Derékfájás (lumbágó)', 'Nyaki fájdalom', 'Porckorongsérv', 'Isiász', 'Végtagba sugárzó fájdalom', 'Gerinceredetű fejfájás'],
  },
  {
    id: 'manualterapia',
    clip: { name: 'vall-manualis-kezeles', label: 'Váll manuális kezelése a rendelőben' },
    title: 'Manuálterápia',
    image: `${base}images/modszerek/manual.png`,
    description: 'Kézzel végzett diagnosztikai és terápiás fogások összessége, amelyek a mozgásszervrendszer működési zavarainak felismerésére és kezelésére irányulnak.',
    details: 'Sérülések, gyulladások, degeneratív betegségek és az életkorral járó változások esetén alkalmazzuk. A vizsgálat során felmérjük az ízületek mozgását, az izmok működését és a szövetek állapotát.',
    subtypes: [
      { name: 'Maitland manuálterápia', desc: 'Páciensközpontú módszer, amely az idegrendszer, az izomzat és az ízületek vizsgálatára épül. A tesztek segítenek eldönteni, mely mozgások és kezelések illenek a panaszhoz.' },
      { name: 'Mulligan manuálterápia', desc: 'Az ízületek helyzeti eltéréseire épül. A terapeuta egy adott helyzetben tartja az ízületet, miközben a páciens aktívan mozog. A kivitelezés során a fájdalommentességre törekszünk.' },
    ],
    conditions: ['Derékfájás', 'Nyaki és háti fájdalom', 'Vállpanaszok', 'Csípő-, térd-, bokafájdalom', 'Tenisz- és golfkönyök', 'Fagyott váll'],
  },
  {
    id: 'stabilizacio',
    clip: { name: 'stabilizacio-labdan-negykezlabon', label: 'Stabilizáló gyakorlat labdán, terapeuta irányításával' },
    title: 'Stabilizációs tréning',
    image: `${base}images/modszerek/stabilizacio.png`,
    description: 'Célzott gyakorlatokkal erősítjük a gerincet és a törzset támasztó mély izmokat, és megtanítjuk a helyes mozgásmintákat.',
    details: 'A gyakorlatokat a terapeuta mutatja meg és ellenőrzi, majd otthoni programként is folytatható. A rendszeres erősítés segíthet csökkenteni a panaszok visszatérésének esélyét.',
    conditions: ['Porckorongsérv utáni állapot', 'Lumbágó, visszatérő derékfájás', 'A gerinc terhelhetőségének javítása', 'Csigolyacsúszás (spondylolisthesis)'],
  },
  {
    id: 'stretching',
    clip: { name: 'mellkasi-nyujtas-hengerrel', label: 'Mellkasi nyújtás habhengeren' },
    title: 'Gyógyászati nyújtás (stretching)',
    image: `${base}images/modszerek/stretching.png`,
    description: 'Nyújtással és lazítással segítünk az izomfeszülés oldásában és a mozgásterjedelem növelésében.',
    details: 'A nyújtást a terapeuta a panaszhoz igazítja, és megtanítja azokat a gyakorlatokat, amelyeket otthon is végezhet. Gyakran más kezelésekkel együtt alkalmazzuk.',
    conditions: ['Izomgörcsök, izomfeszülés', 'Csökkent ízületi mozgásterjedelem', 'Izommerevség'],
  },
  {
    id: 'taping',
    clip: { name: 'kinesio-taping-derek', label: 'Kineziológiai tape felhelyezése a derékra', wide: true },
    title: 'Kineziológiai taping',
    image: `${base}images/modszerek/taping.png`,
    description: 'Rugalmas, gyógyszert nem tartalmazó ragasztószalag, amelyet kiegészítő kezelésként alkalmazunk a gyakorlatok és a manuális kezelés mellett. A szalag általában néhány napig, legfeljebb 5-7 napig viselhető.',
    details: 'A kineziológiai tapinget Kenzo Kase fejlesztette ki Japánban. A hatásmechanizmusáról a szakirodalom nem egységes, ezért nem önálló kezelésként, hanem a mozgás- és gyakorlatterápia kiegészítőjeként használjuk. Egyes pácienseknek a mozgás közbeni biztonságérzetet és a testtudatot segítheti. A felhelyezéséhez képzett szakember szükséges.',
    conditions: ['Sportsérülések', 'Ficamok, rándulások', 'Tenisz- és golfkönyök', 'Tartáshibák', 'Ízületi mozgásproblémák', 'Achilles-ín rehabilitáció'],
  },
  {
    id: 'mutet-utani',
    clip: { name: 'gluteus-gumiszalag-terd', label: 'Gumiszalagos erősítő gyakorlat a terapeuta mellett' },
    title: 'Műtét előtti és utáni rehabilitáció',
    image: `${base}images/modszerek/mutet_utani_rehab.png`,
    description: 'A cél a mozgásképesség és az erő fokozatos visszanyerése a műtétet végző orvos előírásainak megfelelően. Ha a páciens sportol, a terhelést fokozatosan emeljük.',
    details: 'A műtét előtti terápia felkészítheti az ízületeket és az izmokat. A műtét utáni terápiát az orvosi előírásokhoz igazítjuk, és a felépülés üteme egyénenként eltér. Célunk, hogy a lehető legjobb állapotot érje el, teljes felépülést azonban nem ígérhetünk.',
    conditions: ['Gerinc-, csípő-, térdműtét utáni rehabilitáció', 'Szalagszakadás műtéti ellátása után', 'Csonttörés műtéti ellátása után', 'Bütyök, kalapácsujj műtét után', 'Alagút-szindróma műtét után'],
  },
  {
    id: 'izuleti-fajdalmak',
    clip: { name: 'csipo-mobilizalas-ovvel', label: 'Csípő mobilizálása övvel' },
    title: 'Ízületi fájdalmak gyógytornája',
    image: `${base}images/modszerek/izuleti_fajdalmak.png`,
    description: 'A fájdalom okainak és eredetének feltárása után egyéni mozgásterápia segítségével javítjuk az ízület mozgását és funkcióját, valamint csökkentjük az ízületi fájdalmat.',
    details: 'Akut sportsérülések és a tartósan helytelen mozgás következményeinek kezelése. Passzív mozgatás, aktív erősítés és nyújtás kombinálása. Kiemelt figyelmet fordítunk az újrasérülés megelőzésére is.',
    conditions: ['Térdfájdalom', 'Vállfájdalom', 'Csípőfájdalom', 'Bokafájdalom', 'Csuklófájdalom', 'Gerinceredetű ízületi panaszok'],
  },
  {
    id: 'tartasjavitas',
    clip: { name: 'ulomunka-tartaskorrekcio', label: 'Tartáskorrekció íróasztali munka közben' },
    title: 'Tartásjavítás',
    image: `${base}images/modszerek/tartasjavitas.png`,
    description: 'A gerinc melletti izomzat erősítésével, tudatosítással és ergonómiai tanácsokkal érünk el jobb testtartást.',
    details: 'A helytelen testtartás és az egyoldalú terhelés csökkenti a teherbíró képességet. Az ülőmunka, telefon- és laptophasználat okozta tartásproblémák korrekciója gyermekkorban is fontos.',
    conditions: ['Irodai ülőmunka okozta panaszok', 'Váll- és nyakfájdalom', 'Derékfájás', 'Gyermekkori tartáshibák', 'Ergonómiai tanácsadás', 'Munkahelyi gyakorlatok'],
  },
  {
    id: 'schroth',
    clip: { name: 'labdan-ules-szalaghuzas', label: 'Ülő gyakorlat labdán, szalaggal, a bordásfal mellett' },
    title: 'Schroth-terápia',
    image: `${base}images/modszerek/schroth.png`,
    description: 'Gerincferdülés (scoliosis), Scheuermann-betegség és egyes tartáshibák esetén alkalmazott gyakorlatterápia, amely a testtartás és a törzs aszimmetriájának javítását segíti, és beilleszthető a mindennapi mozgásba.',
    details: 'A Katharina Schroth által kifejlesztett háromdimenziós gerincferdülés-terápia (3DST). Aszimmetrikus testhelyzetekkel és háromdimenziós légzéssel dolgozik, hogy javuljon a törzs tartása és szimmetriája, és a páciens önállóan is megtanulja a gyakorlatokat. A görbület alakulását orvosi kontroll követi, az eredmény egyénenként eltér.',
    conditions: ['Gerincferdülés (scoliosis)', 'Scheuermann-betegség', 'Tartáshibák', 'A törzs aszimmetriája, bordapúp'],
  },
];
---

<BaseLayout
  title="Kezelési módszereink | McKenzie Gyógytorna Rendelő Budapest"
  description="9 kezelési módszer: McKenzie-módszer, manuálterápia, stabilizációs tréning, Schroth-terápia, kineziológiai taping és műtét utáni rehabilitáció. Mikor melyiket ajánljuk."
>
  <PageHeader eyebrow="Kezelési módszerek">
    <Fragment slot="title">Kilenc kezelési módszer, amelyek közül a vizsgálat alapján választunk.</Fragment>
    Nem kell előre eldöntenie, melyikre van szüksége: az első alkalmon a terapeuta megvizsgálja, és azt javasolja, ami a panaszához illik. A fő szakterületünk a McKenzie-módszer. Ha a vizsgálat alapján más kezelés vagy orvosi kivizsgálás indokolt, azt is megmondjuk.
  </PageHeader>

  <!-- In-page index -->
  <nav class="sticky top-[80px] z-20 bg-[var(--color-paper)]/95 backdrop-blur border-b border-[var(--color-line)]" aria-label="Módszerek">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex gap-6 overflow-x-auto py-3 text-[15px] whitespace-nowrap no-scrollbar [mask-image:linear-gradient(90deg,#000_92%,transparent)]">
      {methods.map((m, i) => (
        <a href={`#${m.id}`} class="text-[var(--color-ink-2)] hover:text-[var(--color-teal-700)]">
          <span class="font-mono text-[0.78rem] text-[var(--color-teal-600)] mr-1.5">{String(i + 1).padStart(2, '0')}</span>{m.title.split('(')[0].trim()}
        </a>
      ))}
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {methods.map((m, i) => (
      <article id={m.id} class="scroll-mt-36 py-14 lg:py-20 border-b border-[var(--color-line)] grid lg:grid-cols-12 gap-10 lg:gap-12">
        <div class={`lg:col-span-5 ${i % 2 ? 'lg:order-2' : ''}`}>
          <div class:list={['relative overflow-hidden bg-white lg:sticky lg:top-40', m.clip?.wide ? 'aspect-[4/3]' : m.clip ? 'aspect-[3/4] max-w-xs lg:max-w-none' : 'aspect-[4/3]']}>
            {m.clip ? (
              <LoopVideo name={`rendelo/${m.clip.name}`} label={m.clip.label} class="absolute inset-0 w-full h-full object-cover" />
            ) : m.featured ? (
              <img src={`${base}images/rendelo/mckenzie-gyakorlat.jpg`} alt="Hasra fekvő gerincnyújtó McKenzie-gyakorlat gyógytornász irányításával a rendelőben" class="w-full h-full object-cover" loading="eager" />
            ) : (
              <img src={m.image} alt={m.title} class="w-full h-full object-cover" loading={i < 2 ? 'eager' : 'lazy'} />
            )}
          </div>
        </div>
        <div class={`lg:col-span-7 ${i % 2 ? 'lg:order-1' : ''}`}>
          <p class="eyebrow">{String(i + 1).padStart(2, '0')} &middot; {m.featured ? m.subtitle : 'Módszer'}</p>
          <h2 class="display mt-4 text-3xl lg:text-4xl text-[var(--color-navy-900)]">{m.title}</h2>
          <p class="mt-6 text-lg leading-relaxed text-[var(--color-ink)] measure">{m.description}</p>
          <p class="mt-4 leading-relaxed text-[var(--color-ink-2)] measure">{m.details}</p>

          {m.howItWorks && (
            <ol class="mt-10 border-t border-[var(--color-line)]">
              {m.howItWorks.map((step, j) => (
                <li class="grid grid-cols-[2.5rem_1fr] gap-3 py-4 border-b border-[var(--color-line)]">
                  <span class="font-mono text-[13px] text-[var(--color-teal-600)] pt-1">{String(j + 1).padStart(2, '0')}</span>
                  <span class="text-[var(--color-ink)]">{step}</span>
                </li>
              ))}
            </ol>
          )}

          {m.subtypes && (
            <div class="mt-10 grid sm:grid-cols-2 gap-6">
              {m.subtypes.map((sub) => (
                <div class="border-t-2 border-[var(--color-teal-600)] pt-4">
                  <h3 class="font-heading text-[1.35rem] text-[var(--color-navy-900)]">{sub.name}</h3>
                  <p class="mt-2 text-[15px] leading-relaxed text-[var(--color-ink-2)]">{sub.desc}</p>
                </div>
              ))}
            </div>
          )}

          <h3 class="mt-10 font-mono text-[0.8rem] tracking-wider uppercase text-[var(--color-ink-2)]">Mikor jöhet szóba</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {m.conditions.map((c) => (
              <li class="px-3 py-1.5 text-[15px] bg-[var(--color-teal-50)] text-[var(--color-teal-700)] border border-[var(--color-teal-100)]">{c}</li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>

  <ExpertBackground />

  <ClosingCta
    eyebrow="Kezelési terv"
    title="Az első vizsgálat után a terapeuta állítja össze a kezelési tervet."
    lead="Nem kell előre kiválasztania a módszert: a vizsgálat mutatja meg, melyik kezelés illik a panaszához, és hogy kell-e kombinálni őket. Az első alkalom 55 perc, a végén megkapja az otthoni gyakorlatsort."
  />
</BaseLayout>
