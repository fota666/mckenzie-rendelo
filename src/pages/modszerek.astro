---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import LoopVideo from '../components/LoopVideo.astro';
import ExpertBackground from '../components/ExpertBackground.astro';
const base = import.meta.env.BASE_URL;

const methods = [
  {
    id: 'mckenzie',
    title: 'McKenzie-módszer (MDT)',
    subtitle: 'Fő szakterületünk',
    image: `${base}images/modszerek/mckenzie.png`,
    featured: true,
    description: 'A McKenzie-módszer részletes mozgásvizsgálatra épülő egyéni mozgásprogram, amelyet elsősorban gerinceredetű panaszoknál, például derékfájásnál, nyakfájásnál és porckorongsérvnél alkalmazunk.',
    details: 'A módszert Robin McKenzie új-zélandi gyógytornász fejlesztette ki, ma a McKenzie Institute International oktatja szerte a világon. Lényege, hogy a páciens aktív résztvevője saját gyógyulásának: a cél, hogy célzott gyakorlatokkal és önkezelési stratégiákkal maga is kezelni tudja a panaszát.',
    howItWorks: [
      'Alapos mozgásvizsgálat: ismételt speciális mozgások és testhelyzetek, miközben figyeljük a fájdalomra adott reakciót',
      'Egyénre szabott gyakorlatsor összeállítása',
      'Önkezelési stratégia megtanítása: a páciens képessé válik saját panaszai kezelésére',
      'Rendszeres kontroll és a program finomhangolása',
    ],
    conditions: ['Derékfájás (lumbágó)', 'Nyaki fájdalom', 'Porckorongsérv', 'Isiász', 'Végtagba sugárzó fájdalom', 'Gerinceredetű fejfájás'],
  },
  {
    id: 'manualterapia',
    title: 'Manuálterápia',
    image: `${base}images/modszerek/manual.png`,
    description: 'Kézzel végzett diagnosztikai és terápiás fogások összessége, amelyek a mozgásszervrendszer működési zavarainak felismerésére és kezelésére irányulnak.',
    details: 'Sérülések, gyulladások, degeneratív betegségek és az életkorral járó változások esetén alkalmazzuk. A vizsgálat során felmérjük az izom-, a szalag- és a bőrreflexeket, valamint az ízületi mechanikát és az izomfunkciót.',
    subtypes: [
      { name: 'Maitland manuálterápia', desc: 'Páciensközpontú, bizonyítékokon alapuló módszer. Az idegrendszer, az izomzat és az ízületek vizsgálatára épül. Specifikus tesztekkel azonosítjuk a fájdalmat okozó struktúrákat.' },
      { name: 'Mulligan manuálterápia', desc: 'Az ízületek helyzeti eltéréseire épül. A terapeuta egy adott helyzetben tartja az ízületet, miközben a páciens aktívan mozog. A kivitelezés során a fájdalommentességre törekszünk.' },
    ],
    conditions: ['Derékfájás', 'Nyaki és háti fájdalom', 'Vállpanaszok', 'Csípő-, térd-, bokafájdalom', 'Tenisz- és golfkönyök', 'Fagyott váll'],
  },
  {
    id: 'stabilizacio',
    title: 'Stabilizációs tréning',
    image: `${base}images/modszerek/stabilizacio.png`,
    description: 'A gerinc stabilitásának megbomlása esetén a gerinc melletti mély izmok erejének helyreállítására törekszünk, precíz irányítással.',
    details: 'A tréning során a megrövidült izmokat megnyújtjuk, és helyreállítjuk az optimális izom-ízületi egyensúlyt. A mély stabilizáló izmok célzott erősítése segíthet megelőzni a panaszok visszatérését.',
    conditions: ['Porckorongsérv utáni állapot', 'Lumbágó', 'Instabil gerinc', 'Túlterhelt gerinc', 'Csigolyacsúszás (spondylolisthesis)'],
  },
  {
    id: 'stretching',
    title: 'Gyógyászati nyújtás (stretching)',
    image: `${base}images/modszerek/stretching.png`,
    description: 'A fájdalom okozta izomfeszülések terápiás nyújtása és lazítása, valamint az ízületi mozgásterjedelem növelése mechanikus izomnyújtással.',
    details: 'Az enyhe, elnyújtott stretching fenntartja a nyújtás hatását, nyújtja a kötőszövetet, növeli a szövetek hőmérsékletét, és alacsony izom-elektromos aktivitás mellett elősegíti az izmok ellazulását.',
    conditions: ['Izomgörcsök, izomfeszülés', 'Csökkent ízületi mozgásterjedelem', 'Izommerevség', 'Keringési zavarok', 'Regeneráció gyorsítása'],
  },
  {
    id: 'taping',
    title: 'Kineziológiai taping',
    image: `${base}images/modszerek/taping.png`,
    description: 'Speciális ragasztószalag segítségével befolyásoljuk a mozgásszervrendszer működését. A szalag 5-7 napig viselhető, gyógyszert nem tartalmaz.',
    details: 'Japánban, Koreában és Németországban fejlesztették ki. A bőr, az izmok és az ízületi tok receptoraira, valamint a szalagokra és a nyirokrendszerre hat. Hatékonysága a képzett szakember által végzett korrekt felhelyezéstől függ.',
    conditions: ['Sportsérülések', 'Ficamok, rándulások', 'Tenisz- és golfkönyök', 'Tartáshibák', 'Ízületi mozgásproblémák', 'Fejfájás', 'Achilles-ín rehabilitáció'],
  },
  {
    id: 'mutet-utani',
    title: 'Műtét utáni rehabilitáció',
    image: `${base}images/modszerek/mutet_utani_rehab.png`,
    description: 'A cél a mozgásképesség visszaállítása, az izmok erősítése és a szükséges ízületi funkciók helyreállítása, egészen a sportolói szintig.',
    details: 'A műtét előtti terápia felkészíti az ízületeket és az izmokat. A műtét utáni terápia visszaállítja az erőt és a mozgásképességet, valamint megelőzi a szövődményeket. Célunk a maximális felépülés, akár a sérülés előtti szintig.',
    conditions: ['Csonttörések', 'Szalagszakadások', 'Gerinc-, csípő-, térdműtét', 'Sportsérülések', 'Bütyök, kalapácsujj', 'Alagút-szindróma', 'Nyakcsigolya ostor-sérülés'],
  },
  {
    id: 'izuleti-fajdalmak',
    title: 'Ízületi fájdalmak gyógytornája',
    image: `${base}images/modszerek/izuleti_fajdalmak.png`,
    description: 'A fájdalom okainak és eredetének feltárása után egyéni mozgásterápia segítségével javítjuk az ízület mozgását és funkcióját, valamint csökkentjük az ízületi fájdalmat.',
    details: 'Akut sportsérülések és a tartósan helytelen mozgás következményeinek kezelése. Passzív mozgatás, aktív erősítés és nyújtás kombinálása. Kiemelt figyelmet fordítunk az újrasérülés megelőzésére is.',
    conditions: ['Térdfájdalom', 'Vállfájdalom', 'Csípőfájdalom', 'Bokafájdalom', 'Csuklófájdalom', 'Gerinceredetű ízületi panaszok'],
  },
  {
    id: 'tartasjavitas',
    title: 'Tartásjavítás',
    image: `${base}images/modszerek/tartasjavitas.png`,
    description: 'A gerinc melletti izomzat erősítésével, tudatosítással és ergonómiai tanácsokkal érünk el jobb testtartást.',
    details: 'A helytelen testtartás és az egyoldalú terhelés csökkenti a teherbíró képességet. Az ülőmunka, telefon- és laptophasználat okozta tartásproblémák korrekciója gyermekkorban is fontos.',
    conditions: ['Irodai ülőmunka okozta panaszok', 'Váll- és nyakfájdalom', 'Derékfájás', 'Gyermekkori tartáshibák', 'Ergonómiai tanácsadás', 'Munkahelyi gyakorlatok'],
  },
  {
    id: 'schroth',
    title: 'Schroth-terápia',
    image: `${base}images/modszerek/schroth.png`,
    description: 'A gerincferdülés (scoliosis), a Scheuermann-betegség és egyes tartáshibák speciális kezelési módszere, amely jól beilleszthető a mindennapi mozgásba.',
    details: 'A Katharina Schroth által kifejlesztett háromdimenziós scoliosisterápia (3DST). A hagyományos 2D megközelítéssel szemben a csigolyák rotációjából eredő bordapúpot is korrigálja. Aszimmetrikus pozíciókkal aktiválja a törzs izmait, háromdimenziós légzéssel korrigálja a rotációt és a görbületet.',
    conditions: ['Gerincferdülés (scoliosis)', 'Scheuermann-betegség', 'Tartáshibák', 'Bordapúp korrekció'],
  },
];
---

<BaseLayout
  title="Kezelési módszereink | McKenzie Gyógytorna Rendelő Budapest"
  description="9 kezelési módszer: McKenzie-módszer, manuálterápia, stabilizációs tréning, Schroth-terápia, kineziológiai taping és műtét utáni rehabilitáció. Mikor melyiket ajánljuk."
>
  <PageHeader eyebrow="Kezelési módszerek">
    <Fragment slot="title">Kilenc módszer, a kezelést egy vizsgálat előzi meg.</Fragment>
    A McKenzie-módszer a fő szakterületünk. Az első alkalom vizsgálata alapján a terapeuta dönti el, melyik módszert kombinálja vele, ezt nem kell előre kiválasztania.
  </PageHeader>

  <!-- In-page index -->
  <nav class="sticky top-[80px] z-20 bg-[var(--color-paper)]/95 backdrop-blur border-b border-[var(--color-line)]" aria-label="Módszerek">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex gap-6 overflow-x-auto py-3 text-[15px] whitespace-nowrap no-scrollbar [mask-image:linear-gradient(90deg,#000_92%,transparent)]">
      {methods.map((m, i) => (
        <a href={`#${m.id}`} class="text-[var(--color-ink-2)] hover:text-[var(--color-teal-700)]">
          <span class="font-mono text-[0.78rem] text-[var(--color-teal-600)] mr-1.5">{String(i + 1).padStart(2, '0')}</span>{m.title.split('(')[0].trim()}
        </a>
      ))}
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {methods.map((m, i) => (
      <article id={m.id} class="scroll-mt-36 py-14 lg:py-20 border-b border-[var(--color-line)] grid lg:grid-cols-12 gap-10 lg:gap-12">
        <div class={`lg:col-span-5 ${i % 2 ? 'lg:order-2' : ''}`}>
          <div class="aspect-[4/3] overflow-hidden bg-white lg:sticky lg:top-40">
            {m.featured ? (
              <img src={`${base}images/rendelo/mckenzie-gyakorlat.jpg`} alt="Hasra fekvő gerincnyújtó McKenzie-gyakorlat gyógytornász irányításával a rendelőben" class="w-full h-full object-cover" loading="eager" />
            ) : (
              <img src={m.image} alt={m.title} class="w-full h-full object-cover" loading={i < 2 ? 'eager' : 'lazy'} />
            )}
          </div>
        </div>
        <div class={`lg:col-span-7 ${i % 2 ? 'lg:order-1' : ''}`}>
          <p class="eyebrow">{String(i + 1).padStart(2, '0')} &middot; {m.featured ? m.subtitle : 'Módszer'}</p>
          <h2 class="display mt-4 text-3xl lg:text-4xl text-[var(--color-navy-900)]">{m.title}</h2>
          <p class="mt-6 text-lg leading-relaxed text-[var(--color-ink)] measure">{m.description}</p>
          <p class="mt-4 leading-relaxed text-[var(--color-ink-2)] measure">{m.details}</p>

          {m.howItWorks && (
            <ol class="mt-10 border-t border-[var(--color-line)]">
              {m.howItWorks.map((step, j) => (
                <li class="grid grid-cols-[2.5rem_1fr] gap-3 py-4 border-b border-[var(--color-line)]">
                  <span class="font-mono text-[13px] text-[var(--color-teal-600)] pt-1">{String(j + 1).padStart(2, '0')}</span>
                  <span class="text-[var(--color-ink)]">{step}</span>
                </li>
              ))}
            </ol>
          )}

          {m.subtypes && (
            <div class="mt-10 grid sm:grid-cols-2 gap-6">
              {m.subtypes.map((sub) => (
                <div class="border-t-2 border-[var(--color-teal-600)] pt-4">
                  <h3 class="font-heading text-[1.35rem] text-[var(--color-navy-900)]">{sub.name}</h3>
                  <p class="mt-2 text-[15px] leading-relaxed text-[var(--color-ink-2)]">{sub.desc}</p>
                </div>
              ))}
            </div>
          )}

          <h3 class="mt-10 font-mono text-[0.8rem] tracking-wider uppercase text-[var(--color-ink-2)]">Mikor ajánljuk</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {m.conditions.map((c) => (
              <li class="px-3 py-1.5 text-[15px] bg-[var(--color-teal-50)] text-[var(--color-teal-700)] border border-[var(--color-teal-100)]">{c}</li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>

  <ExpertBackground />

  <section class="bg-[var(--color-navy-900)] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 grid lg:grid-cols-12 gap-8 items-end">
      <div class="lg:col-span-8">
        <p class="eyebrow eyebrow-light">Kezelési terv</p>
        <h2 class="display mt-5 text-3xl lg:text-4xl">Az első vizsgálat után a terapeuta állítja össze a kezelési tervet.</h2>
      </div>
      <div class="lg:col-span-4 lg:text-right">
        <a href={`${base}kapcsolat#idopontfoglalas`} class="btn btn-copper">Időpontot kérek <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
