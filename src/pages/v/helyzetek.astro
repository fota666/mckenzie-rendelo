---
// Internal comparison page for the "situations" section variants. Not linked from the site.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SituationsA from '../../components/situations/SituationsA.astro';
import SituationsB from '../../components/situations/SituationsB.astro';
import SituationsC from '../../components/situations/SituationsC.astro';
import SituationsD from '../../components/situations/SituationsD.astro';

const variants = [
  { key: 'A', name: 'Választó fülekkel', note: 'Bal oldalt a négy helyzet, rámutatva vagy kattintva jobbra kerül a videó és a válasz.' },
  { key: 'B', name: 'Szerkesztői lista', note: 'Teljes szélességű, számozott sorok, az egész sor kattintható.' },
  { key: 'C', name: 'Képes kártyák', note: 'Sötét sávon négy fotós kártya, egy sorban.' },
  { key: 'D', name: 'Melyik mondat igaz Önre?', note: 'Első személyű mondatok gombként, a kiválasztott alatt jelenik meg a válasz és a hívás gomb.' },
];
---

<BaseLayout title="Helyzetek szekció, 4 változat">
  {variants.map((v) => (
    <>
      <div class="bg-[var(--color-gold-100)] border-y border-[var(--color-gold-300)]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-wrap gap-x-4 items-baseline">
          <p class="font-mono text-sm font-medium">Változat {v.key}: {v.name}</p>
          <p class="text-sm text-[var(--color-ink-2)]">{v.note}</p>
        </div>
      </div>
      {v.key === 'A' && <SituationsA />}
      {v.key === 'B' && <SituationsB />}
      {v.key === 'C' && <SituationsC />}
      {v.key === 'D' && <SituationsD />}
    </>
  ))}
</BaseLayout>
