---
// Four alternatives for the "Mi a panasza?" section, stacked for comparison. Preview only.
import CalmLayout from '../../../layouts/CalmLayout.astro';
import { chooser } from '../../../data/chooser';
import { clinic } from '../../../data/clinic';
const base = import.meta.env.BASE_URL;
const v = `${base}v/nyugalom/`;
const by = (slug: string) => chooser.find((c) => c.slug === slug)!;
const groups = ['Gerinc', 'Ízületek', 'Műtét után'] as const;
const tabs = [
  { id: 'hat', label: 'Derék és láb', items: ['derekfajas', 'isiasz', 'porckorongserv', 'csipofajdalom', 'terdfajdalom'] },
  { id: 'nyak', label: 'Nyak és váll', items: ['nyakfajas', 'vallfajas', 'ulomunka-tartashibak'] },
  { id: 'gerinc', label: 'Gerinc és tartás', items: ['gerincferdules', 'ulomunka-tartashibak', 'derekfajas'] },
  { id: 'mutet', label: 'Műtét előtt vagy után', items: ['muteti-rehabilitacio', 'porckorongserv', 'terdfajdalom', 'csipofajdalom'] },
];
const poster = (p: string) => `${base}video/rendelo/${p}.jpg`;
---

<CalmLayout title="Mi a panasza? 4 változat | nyugodt dizájn vázlat">

  <!-- A: editorial index by body region -->
  <div class="k-wrap" style="padding-top:28px"><span class="k-vlabel">A változat: tartalomjegyzék testtáj szerint</span></div>
  <section class="k-sec k-sec--sage" style="padding-top:28px">
    <div class="k-wrap k-va">
      <div class="k-va__head">
        <p class="k-eyebrow">Mi a panasza?</p>
        <h2 class="k-h2">Válassza ki, mi fáj, és megmutatjuk, hogyan kezdünk hozzá.</h2>
        <p class="k-lead">Tíz panaszra külön oldalt írtunk: mikor segíthet a gyógytorna, mikor kell előbb orvos, és mi történik az első alkalmon.</p>
      </div>
      <div class="k-va__cols">
        {groups.map((g) => (
          <div>
            <h3 class="k-va__g">{g}<span>{chooser.filter((c) => c.group === g).length}</span></h3>
            <ul>
              {chooser.filter((c) => c.group === g).map((c) => (
                <li><a href={`${v}${c.slug}`}><strong>{c.name}</strong><span>{c.note}</span><i aria-hidden="true">&rarr;</i></a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- B: photo tiles -->
  <div class="k-wrap" style="padding-top:28px"><span class="k-vlabel">B változat: fotós csempék</span></div>
  <section class="k-sec" style="padding-top:28px">
    <div class="k-wrap">
      <div class="k-head">
        <p class="k-eyebrow">Mi a panasza?</p>
        <h2 class="k-h2">Válassza ki, mi fáj, és megmutatjuk, hogyan kezdünk hozzá.</h2>
      </div>
      <div class="k-vb">
        {chooser.map((c) => (
          <a href={`${v}${c.slug}`} class="k-vb__t">
            <img src={poster(c.poster)} alt="" loading="lazy" />
            <span class="k-vb__s"></span>
            <span class="k-vb__x"><strong>{c.name}</strong><small>{c.note}</small></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- C: tabs, "Hol fáj?" (CSS only) -->
  <div class="k-wrap" style="padding-top:28px"><span class="k-vlabel">C változat: hol fáj? (fülek)</span></div>
  <section class="k-sec k-sec--white" style="padding-top:28px">
    <div class="k-wrap k-vc">
      <div class="k-head">
        <p class="k-eyebrow">Mi a panasza?</p>
        <h2 class="k-h2">Hol fáj? Válasszon, és megmutatjuk, hogyan kezdünk hozzá.</h2>
      </div>
      {tabs.map((t, i) => <input type="radio" name="vc" id={`vc-${t.id}`} checked={i === 0} class="k-vc__r" />)}
      <div class="k-vc__tabs" role="tablist">
        {tabs.map((t) => <label for={`vc-${t.id}`} data-for={t.id}>{t.label}</label>)}
      </div>
      {tabs.map((t) => (
        <div class="k-vc__panel" data-p={t.id}>
          {t.items.map((s) => {
            const c = by(s);
            return (
              <a href={`${v}${c.slug}`} class="k-vc__card">
                <img src={poster(c.poster)} alt="" loading="lazy" />
                <span><strong>{c.name}</strong><small>{c.note}</small><em>Tovább az oldalra &rarr;</em></span>
              </a>
            );
          })}
        </div>
      ))}
    </div>
  </section>

  <!-- D: large type index plus a help card -->
  <div class="k-wrap" style="padding-top:28px"><span class="k-vlabel">D változat: nagy típusos lista és segítség kártya</span></div>
  <section class="k-sec k-sec--pine" style="padding-top:28px">
    <div class="k-wrap k-vd">
      <div>
        <p class="k-eyebrow">Mi a panasza?</p>
        <h2 class="k-h2" style="margin:14px 0 28px">Válassza ki, mi fáj, és megmutatjuk, hogyan kezdünk hozzá.</h2>
        <ol class="k-vd__list">
          {chooser.map((c, i) => (
            <li>
              <a href={`${v}${c.slug}`}>
                <span class="k-vd__n">{String(i + 1).padStart(2, '0')}</span>
                <span class="k-vd__t">{c.name}</span>
                <span class="k-vd__note">{c.note}</span>
                <i aria-hidden="true">&rarr;</i>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <aside class="k-vd__help">
        <p class="k-eyebrow" style="color:var(--c-pine-2)">Nem biztos benne?</p>
        <h3 class="k-h3" style="font-size:1.5rem;margin:10px 0">Hívjon, és segítünk kiválasztani a megfelelő terapeutát.</h3>
        <p class="k-small">Telefonon {clinic.bookingHoursShort}. A panasza alapján ajánlunk Önnek valakit a két rendelőből.</p>
        <a href={`tel:${clinic.phone}`} class="k-btn k-btn--clay" style="margin-top:18px">{clinic.phoneDisplay}</a>
      </aside>
    </div>
  </section>
</CalmLayout>
