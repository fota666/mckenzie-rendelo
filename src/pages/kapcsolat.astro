---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { clinic } from '../data/clinic';
import { firstVisit } from '../data/firstVisit';



const mapQuery = (l: (typeof clinic.locations)[number]) =>
  encodeURIComponent(`${l.postalCode} Budapest, ${l.street.split(' I.')[0]}`);
---

<BaseLayout
  title="Kapcsolat és időpontfoglalás | McKenzie Gyógytorna Rendelő Budapest"
  description={`Időpontfoglalás telefonon: ${clinic.phoneDisplay}. Két rendelő: 1051 Budapest, Sas u. 7. és 1111 Budapest, Bartók Béla út 34.`}
>
  <PageHeader eyebrow="Kapcsolat">
    <Fragment slot="title">Időpontot telefonon tud foglalni.</Fragment>
    Hívjon minket, és általában 1-2 napon belül kap időpontot valamelyik rendelőnkbe. Mindkét rendelőben csak előzetes bejelentkezéssel fogadunk pácienseket.
  </PageHeader>

  <section id="idopontfoglalas" class="scroll-mt-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
    <div class="bg-[var(--color-teal-700)] text-white p-8 lg:p-14 grid lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7">
        <p class="eyebrow text-[var(--color-teal-100)]">Időpontfoglalás telefonon</p>
        <a href={`tel:${clinic.phone}`} class="mt-4 block font-heading text-5xl sm:text-6xl lg:text-7xl hover:text-[var(--color-gold-200)]">{clinic.phoneDisplay}</a>
        <p class="mt-4 text-white/80">{clinic.bookingHours}</p>
      </div>
      <div class="lg:col-span-5 lg:text-right">
        <a href={`tel:${clinic.phone}`} class="btn btn-copper">Hívás most <span aria-hidden="true">&rarr;</span></a>
        <p class="mt-4 text-sm text-white/70">E-mail: <a href={`mailto:${clinic.email}`} class="underline underline-offset-2">{clinic.email}</a></p>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 lg:pb-28 grid md:grid-cols-2 gap-6">
    {clinic.locations.map((l) => (
      <article class="bg-white border border-[var(--color-line)] flex flex-col">
        <div class="aspect-[16/10] bg-[var(--color-paper-2)]">
          <iframe
            src={`https://www.google.com/maps?q=${mapQuery(l)}&output=embed`}
            class="w-full h-full border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={`${l.name} térkép`}
          ></iframe>
        </div>
        <div class="p-8 flex-1 flex flex-col">
          <p class="eyebrow">{l.district} &middot; {l.area}</p>
          <h2 class="mt-3 font-heading text-4xl text-[var(--color-navy-900)]">{l.name}</h2>
          <dl class="mt-6 text-sm grid grid-cols-[8rem_1fr] gap-y-3 flex-1">
            <dt class="text-[var(--color-ink-2)]">Cím</dt>
            <dd>{l.postalCode} Budapest, {l.street}{l.bell && <><br />{l.bell}</>}</dd>
            <dt class="text-[var(--color-ink-2)]">Rendelés</dt>
            <dd>{clinic.hoursText[0].toUpperCase() + clinic.hoursText.slice(1)}, előzetes bejelentkezéssel</dd>
            <dt class="text-[var(--color-ink-2)]">Tömegközlekedés</dt>
            <dd>{l.transit}<br />{l.transitMore}</dd>
            <dt class="text-[var(--color-ink-2)]">Parkolás</dt>
            <dd>{l.parking}</dd>
          </dl>
          <a href={l.mapsUrl} target="_blank" rel="noopener" class="link-arrow mt-8 self-start text-[var(--color-navy-800)]">Útvonaltervezés <span aria-hidden="true">&rarr;</span></a>
        </div>
      </article>
    ))}
  </section>

  <section class="bg-[var(--color-navy-900)] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <p class="eyebrow eyebrow-light">Az első alkalom</p>
      <h2 class="display mt-5 text-4xl lg:text-5xl max-w-2xl">Mire számítson az első 55 percben?</h2>
      <ol class="mt-14 grid sm:grid-cols-2 lg:grid-cols-4 gap-8 border-t border-white/15">
        {firstVisit.map((s, i) => (
          <li class="pt-8">
            <p class="font-mono text-xs text-[var(--color-teal-300)]">{String(i + 1).padStart(2, '0')} &middot; {s.min}. perc</p>
            <h3 class="mt-3 font-heading text-2xl">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/65">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
