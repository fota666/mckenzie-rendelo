---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CallbackForm from '../components/CallbackForm.astro';
import CtaCard from '../components/CtaCard.astro';
import { clinic } from '../data/clinic';
import { firstVisit } from '../data/firstVisit';
const base = import.meta.env.BASE_URL;



const mapQuery = (l: (typeof clinic.locations)[number]) =>
  encodeURIComponent(`${l.googleName}, ${l.postalCode} Budapest`) + `&ll=${l.geo.lat},${l.geo.lng}&z=17`;
---

<BaseLayout
  title="Kapcsolat, címek és időpontfoglalás | McKenzie Gyógytorna Rendelő Budapest"
  description={`Két rendelő metró közelében: 1051 Budapest, Sas u. 7. és 1111 Budapest, Bartók Béla út 34. Időpontfoglalás telefonon (${clinic.bookingHoursShort}): ${clinic.phoneDisplay}, vagy visszahívás-kérés.`}
>
  <PageHeader eyebrow="Kapcsolat és címek">
    <Fragment slot="title">Két rendelő, mindkettő metró közelében.</Fragment>
    A Sas utcai rendelő az M3 Arany János utca, a Bartók Béla úti az M4 Móricz Zsigmond körtér megállótól kb. 5 percre van gyalog. Időpontot telefonon vagy visszahívással foglalhat, a visszahívás általában még aznap vagy a következő munkanapon megtörténik. A szabad időpont ezt követően általában 1-2 napon belülre kapható. Mindkét rendelőben csak előzetes bejelentkezéssel fogadunk pácienseket.
  </PageHeader>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
    <img src={`${base}images/csapat/csapat-csoportkep.jpg`} alt="A McKenzie Gyógytorna Rendelő gyógytornász csapata" class="w-full aspect-[16/8] object-cover object-[50%_20%]" width="2000" height="1336" loading="eager" />
  </div>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 lg:pb-16 grid md:grid-cols-2 gap-6">
    {clinic.locations.map((l) => (
      <article id={l.id} class="scroll-mt-28 bg-white border border-[var(--color-line)] flex flex-col">
        <div class="aspect-[16/10] bg-[var(--color-paper-2)]">
          <iframe
            src={`https://www.google.com/maps?q=${mapQuery(l)}&output=embed`}
            class="w-full h-full border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={`${l.name} térkép`}
          ></iframe>
        </div>
        <div class="p-6 flex-1 flex flex-col">
          <p class="eyebrow">{l.district} &middot; {l.area}</p>
          <h2 class="mt-3 font-heading text-3xl text-[var(--color-navy-900)]">{l.name}</h2>
          <dl class="mt-6 text-[15px] grid grid-cols-[8rem_1fr] gap-y-3 flex-1">
            <dt class="text-[var(--color-ink-2)]">Cím</dt>
            <dd>{l.postalCode} Budapest, {l.street}{l.bell && <><br />{l.bell}</>}</dd>
            <dt class="text-[var(--color-ink-2)]">Rendelés</dt>
            <dd>{clinic.hoursText[0].toUpperCase() + clinic.hoursText.slice(1)}, előzetes bejelentkezéssel</dd>
            <dt class="text-[var(--color-ink-2)]">Tömegközlekedés</dt>
            <dd>{l.transit}<br />{l.transitMore}</dd>
            <dt class="text-[var(--color-ink-2)]">Parkolás</dt>
            <dd>{l.parking}</dd>
            <dt class="text-[var(--color-ink-2)]">Fizetés</dt>
            <dd>Készpénzzel vagy banki átutalással</dd>
          </dl>
          <a href={l.mapsUrl} target="_blank" rel="noopener" class="link-arrow mt-8 self-start text-[var(--color-navy-800)]">Útvonaltervezés <span aria-hidden="true">&rarr;</span></a>
        </div>
      </article>
    ))}
  </section>

  <section id="idopontfoglalas" class="scroll-mt-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 lg:pb-28 grid lg:grid-cols-12 gap-6">
    <div class="lg:col-span-5"><CtaCard label="Időpontfoglalás telefonon" email /></div>
    <div class="lg:col-span-7">
      <CallbackForm />
    </div>
  </section>

  <section class="bg-[var(--color-navy-900)] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <p class="eyebrow eyebrow-light">Az első alkalom</p>
      <h2 class="display mt-5 text-3xl lg:text-4xl max-w-2xl">Mire számítson az első 55 percben?</h2>
      <p class="mt-4 text-white/65 max-w-2xl">Az első alkalom 55 perc, a további alkalmak 50-55 percesek, az ár ugyanaz.</p>
      <ol class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-8 border-t border-white/15">
        {firstVisit.map((s, i) => (
          <li class="pt-8">
            <p class="font-mono text-[13px] text-[var(--color-teal-300)]">{String(i + 1).padStart(2, '0')} &middot; {s.min}. perc</p>
            <h3 class="mt-3 font-heading text-[1.65rem]">{s.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-white/65">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
