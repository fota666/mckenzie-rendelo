const relleEva = terapeutak.find(t => t.name === 'Relle Éva')!;
const active = terapeutak.filter(t => !t.status && t.name !== 'Relle Éva');
const onLeave = terapeutak.filter(t => t.status);
const short = (q: string[]) => q.slice(0, 4);
---

<BaseLayout
  title="Csapatunk | McKenzie Gyógytorna Rendelő Budapest"
  description={`${active.length + 1} McKenzie-képzett gyógytornász a V. és XI. kerületi rendelőben, Relle Éva vezetésével. Képesítések, nyelvek, árak terapeutánként.`}
>
  <PageHeader eyebrow="Csapatunk">
    <Fragment slot="title">{active.length + 1} gyógytornász, mindannyian McKenzie-képzésben részesültek.</Fragment>
    Mindkét rendelőben ugyanazzal a vizsgálati módszerrel dolgozunk. Ha valamelyik terapeutánkhoz szeretne időpontot kérni, telefonon jelezze ezt.
  </PageHeader>

  <!-- Lead therapist -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 grid lg:grid-cols-12 gap-12">
    <div class="lg:col-span-5">
      <div class="aspect-[4/5] overflow-hidden bg-white">
        <img src={relleEva.photo} alt={relleEva.name} class="w-full h-[108%] object-cover object-top" loading="eager" />
      </div>
    </div>
    <div class="lg:col-span-7 lg:pl-8">
      <p class="eyebrow">Vezető gyógytornász &middot; diploma {relleEva.diploma}</p>
      <h2 class="display mt-4 text-5xl lg:text-6xl text-[var(--color-navy-900)]">{relleEva.name}</h2>
      <p class="mt-6 text-lg leading-relaxed text-[var(--color-ink-2)] measure">1993 óta vezeti a Magyarországi McKenzie Intézetet.</p>
      <ul class="mt-10 border-t border-[var(--color-line)]">
        {relleEva.quals.map((q, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-3 py-3.5 border-b border-[var(--color-line)]">
            <span class="font-mono text-xs text-[var(--color-teal-600)] pt-1">{String(i + 1).padStart(2, '0')}</span>
            <span>{q}</span>
          </li>
        ))}
      </ul>
      <p class="mt-6 font-mono text-xs uppercase tracking-wider text-[var(--color-ink-2)]">Nyelvek: magyar, {relleEva.langs.join(', ')}</p>
    </div>
  </section>

  <!-- Team grid -->
  <section class="bg-[var(--color-paper-2)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <h2 class="display text-4xl lg:text-5xl text-[var(--color-navy-900)]">Terapeutáink</h2>
        <p class="text-sm text-[var(--color-ink-2)]">A választott terapeutához a {clinic.phoneDisplay}-es telefonszámon kérhet időpontot.</p>
      </div>
      <ul class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-6 gap-y-12">
        {active.map((t) => (
          <li class="flex flex-col">
            <div class="aspect-[4/5] overflow-hidden bg-white">
              <img src={t.photo} alt={t.name} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="mt-4 flex items-baseline justify-between gap-3">
              <h3 class="font-heading text-2xl text-[var(--color-navy-900)]">{t.name}</h3>
              {t.price && <span class="font-mono text-xs text-[var(--color-teal-700)] whitespace-nowrap">{t.price}</span>}
            </div>
            <p class="text-sm text-[var(--color-ink-2)]">{t.title} &middot; diploma {t.diploma}</p>
            <ul class="mt-4 space-y-1.5 text-sm text-[var(--color-ink)]">
              {short(t.quals).map((q) => <li class="pl-3 border-l-2 border-[var(--color-teal-100)]">{q}</li>)}
            </ul>
            {t.quals.length > 4 && (
              <details class="faq mt-2 text-sm">
                <summary class="text-[var(--color-teal-700)] py-1">+ {t.quals.length - 4} további képesítés</summary>
                <ul class="mt-2 space-y-1.5">
                  {t.quals.slice(4).map((q) => <li class="pl-3 border-l-2 border-[var(--color-teal-100)]">{q}</li>)}
                </ul>
              </details>
            )}
            {t.langs.length > 0 && <p class="mt-3 font-mono text-[0.68rem] uppercase tracking-wider text-[var(--color-ink-2)]">Nyelv: {t.langs.join(', ')}</p>}
          </li>
        ))}
      </ul>

      {onLeave.length > 0 && (
        <p class="mt-16 pt-6 border-t border-[var(--color-line)] text-sm text-[var(--color-ink-2)]">
          Jelenleg GYES-en: {onLeave.map((t) => t.name).join(', ')}.
        </p>
      )}
    </div>
  </section>

  <section class="bg-[var(--color-navy-900)] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 grid lg:grid-cols-12 gap-8 items-end">
      <div class="lg:col-span-8">
        <p class="eyebrow eyebrow-light">Időpontfoglalás</p>
        <h2 class="display mt-5 text-4xl lg:text-5xl">Nem tudja, kihez menjen? Az első hívásnál a panasza alapján ajánlunk terapeutát.</h2>
      </div>
      <div class="lg:col-span-4 flex flex-col sm:flex-row lg:justify-end gap-3">
        <a href={`tel:${clinic.phone}`} class="btn btn-copper font-mono">{clinic.phoneDisplay}</a>
      </div>
    </div>
  </section>
</BaseLayout>
