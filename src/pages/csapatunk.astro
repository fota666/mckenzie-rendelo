---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { clinic } from '../data/clinic';
import { terapeutak, locationOf, focusAreas } from '../data/team';
const base = import.meta.env.BASE_URL;
const relleEva = terapeutak.find(t => t.name === 'Relle Éva')!;
const active = terapeutak.filter(t => !t.status && t.name !== 'Relle Éva');
const onLeave = terapeutak.filter(t => t.status);
const short = (q: string[]) => q.slice(0, 3);
const orgRef = { '@id': `${new URL(base, Astro.site).href}#org` };
const teamSchema = {
  '@context': 'https://schema.org',
  '@graph': active.map((t) => ({
    '@type': 'Person',
    name: t.name,
    jobTitle: t.title,
    worksFor: orgRef,
    knowsLanguage: ['hu', ...t.langs.map((l) => ({ angol: 'en', német: 'de', spanyol: 'es' } as Record<string, string>)[l] ?? l)],
    ...(t.quals.some((q) => /minősítővizsga/i.test(q))
      ? { hasCredential: { '@type': 'EducationalOccupationalCredential', name: 'McKenzie nemzetközi minősítővizsga (Credentialing Examination)' } }
      : {}),
  })),
};
const locName = (id: string) => clinic.locations.find((l) => l.id === id)?.name ?? '';
---

<BaseLayout
  title="Csapatunk | McKenzie Gyógytorna Rendelő Budapest"
  description={`${active.length + 1} McKenzie-képzett gyógytornász a V. és XI. kerületi rendelőben, Relle Éva vezetésével. Rendelő, képesítések, nyelvek és ár terapeutánként.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(teamSchema)} />
  </Fragment>

  <PageHeader eyebrow="Csapatunk">
    <Fragment slot="title">{active.length + 1} gyógytornász, mindannyian McKenzie-képzésben részesültek.</Fragment>
    Nem kell előre terapeutát választania: telefonon a panasza alapján ajánlunk Önnek valakit ({clinic.phoneDisplay}, {clinic.bookingHoursShort}). Ha valakihez kifejezetten szeretne menni, a rendelő szerint szűrhet lent.
  </PageHeader>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
    <img src={`${base}images/csapat/csapat-csoportkep-eszkozokkel.jpg`} alt="A McKenzie Gyógytorna Rendelő gyógytornászai a rendelő tornatermében" class="w-full aspect-[16/9] object-cover object-[50%_18%]" width="2000" height="1336" loading="eager" />
  </div>

  <!-- Lead therapist -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20 grid lg:grid-cols-12 gap-10 lg:gap-12">
    <div class="lg:col-span-4">
      <div class="aspect-[4/5] max-w-sm overflow-hidden bg-white">
        <img src={relleEva.photo} alt={relleEva.name} class="w-full h-[108%] object-cover object-top" loading="eager" />
      </div>
    </div>
    <div class="lg:col-span-8 lg:pl-8">
      <p class="eyebrow">Alapító, vezető gyógytornász &middot; diploma {relleEva.diploma} &middot; mindkét rendelő</p>
      <h2 class="display mt-4 text-4xl lg:text-5xl text-[var(--color-navy-900)]">{relleEva.name}</h2>
      <p class="mt-6 text-lg leading-relaxed text-[var(--color-ink-2)] measure">1993-ban alapította a rendelőt. A Magyarországi McKenzie Intézet kuratóriumának tagja, 2000 óta a Semmelweis Egyetem Egészségtudományi Karán is oktat.</p>
      <ul class="mt-8 grid sm:grid-cols-2 gap-x-8 border-t border-[var(--color-line)]">
        {relleEva.quals.map((q) => (
          <li class="py-3 border-b border-[var(--color-line)] text-base">{q}</li>
        ))}
      </ul>
      <p class="mt-6 font-mono text-[13px] uppercase tracking-wider text-[var(--color-ink-2)]">Nyelvek: magyar, {relleEva.langs.join(', ')}</p>
    </div>
  </section>

  <!-- Team grid with clinic filter -->
  <section class="bg-[var(--color-paper-2)]" data-team>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <h2 class="display text-3xl lg:text-4xl text-[var(--color-navy-900)]">Terapeutáink</h2>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Szűrés rendelőre">
          <button data-filter="all" aria-pressed="true" class="px-4 py-2 text-[15px] border border-[var(--color-line)] bg-white aria-pressed:bg-[var(--color-teal-700)] aria-pressed:text-white aria-pressed:border-[var(--color-teal-700)]">Mindkét rendelő</button>
          {clinic.locations.map((l) => (
            <button data-filter={l.id} aria-pressed="false" class="px-4 py-2 text-[15px] border border-[var(--color-line)] bg-white aria-pressed:bg-[var(--color-teal-700)] aria-pressed:text-white aria-pressed:border-[var(--color-teal-700)]">{l.name}</button>
          ))}
        </div>
      </div>

      <ul class="mt-10 grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-4 sm:gap-x-6 gap-y-10">
        {active.map((t) => (
          <li class="flex flex-col" data-loc={locationOf[t.name]}>
            <div class="aspect-[4/5] overflow-hidden bg-[var(--color-paper-2)]">
              <img src={t.photo} alt={t.name} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <p class="mt-3 font-mono text-[0.78rem] uppercase tracking-wider text-[var(--color-teal-700)]">{locName(locationOf[t.name])}</p>
            <h3 class="mt-1 font-heading text-[1.35rem] sm:text-[1.65rem] leading-tight text-[var(--color-navy-900)]">{t.name}</h3>
            <p class="mt-1 text-[13px] sm:text-sm text-[var(--color-ink-2)]">{t.title}{t.diploma && <> &middot; diploma {t.diploma}</>}</p>
            {t.price && <p class="mt-1 text-[15px] font-medium text-[var(--color-ink)] whitespace-nowrap">{t.price} / alkalom</p>}
            <ul class="mt-2 flex flex-wrap gap-1.5">
              {focusAreas(t).map((f) => <li class="px-2 py-0.5 text-[13px] bg-[var(--color-paper)] border border-[var(--color-line)] text-[var(--color-ink-2)]">{f}</li>)}
            </ul>
            <details class="faq mt-3 text-[15px]">
              <summary class="text-[var(--color-teal-700)] py-1">Képesítések ({t.quals.length})</summary>
              <ul class="mt-2 space-y-1.5">
                {t.quals.map((q) => <li class="pl-3 border-l-2 border-[var(--color-teal-100)]">{q}</li>)}
              </ul>
            </details>
                        {t.langs.length > 0 && <p class="mt-2 font-mono text-[0.78rem] uppercase tracking-wider text-[var(--color-ink-2)]">Nyelv: {t.langs.join(', ')}</p>}
          </li>
        ))}
      </ul>

      {onLeave.length > 0 && (
        <p class="mt-10 pt-6 border-t border-[var(--color-line)] text-[15px] text-[var(--color-ink-2)]">
          Jelenleg GYES-en: {onLeave.map((t) => t.name).join(', ')}.
        </p>
      )}
    </div>
  </section>

  <section class="bg-[var(--color-navy-900)] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 grid lg:grid-cols-12 gap-8 items-end">
      <div class="lg:col-span-8">
        <p class="eyebrow eyebrow-light">Időpontfoglalás</p>
        <h2 class="display mt-5 text-3xl lg:text-4xl">Telefonon a panasza alapján ajánlunk Önnek terapeutát.</h2>
      </div>
      <div class="lg:col-span-4 flex flex-col sm:flex-row lg:justify-end gap-3">
        <a href={`tel:${clinic.phone}`} class="btn btn-copper font-mono">{clinic.phoneDisplay}</a>
        <a href={`${base}kapcsolat#visszahivas`} class="btn border border-white/30 hover:border-white">Visszahívást kérek</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-team]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    buttons.forEach((b) => b.addEventListener('click', () => {
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      root.querySelectorAll<HTMLElement>('[data-loc]').forEach((li) => {
        li.hidden = b.dataset.filter !== 'all' && li.dataset.loc !== b.dataset.filter;
      });
    }));
  });
</script>
