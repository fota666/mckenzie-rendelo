---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaCard from '../components/CtaCard.astro';
import { clinic, healthFundNote } from '../data/clinic';
const base = import.meta.env.BASE_URL;

const faqs = [
  {
    q: 'Mikor várható javulás?',
    a: 'A javulás üteme egyénenként eltér, ezért előre nem ígérünk alkalomszámot. Az első vizsgálat után a terapeuta elmondja, mire számíthat, és hány alkalmat javasol. Egy kezelési sor gyakran 4-6 alkalomból áll, és sokat számít, hogy az otthoni gyakorlatokat rendszeresen végzi-e.'
  },
  {
    q: 'Mennyi ideig tart egy kezelés?',
    a: 'Az első alkalom 55 perc, ez tartalmazza a mozgásvizsgálatot és az első kezelést. A további alkalmak 50-55 percesek, az ár az első alkalomra is ugyanaz.'
  },
  {
    q: 'Hogyan foglalhatok időpontot, és mennyit kell várni?',
    a: `Telefonon foglalhat a ${clinic.phoneDisplay} számon, ${clinic.bookingHoursSentence}, vagy kérhet visszahívást a Kapcsolat oldalon. Általában 1-2 napon belül tudunk időpontot adni.`
  },
  {
    q: 'Mennyibe kerül a kezelés?',
    a: `Egyéni kezelés: ${clinic.prices.single.amount} alkalmanként, a terapeutától függően, az egyes terapeuták árát a Csapatunk oldalon találja. 5 alkalmas bérlet: ${clinic.prices.pass.amount} (${clinic.prices.pass.perVisit}). A társadalombiztosítás nem fedezi.`
  },
  {
    q: 'Elszámolható egészségpénztárral?',
    a: `Igen. ${healthFundNote}, a feltételekről előzetesen érdemes egyeztetni a pénztárral.`
  },
  {
    q: 'Kell beutaló a kezeléshez?',
    a: 'Nem, magánrendelés lévén nem szükséges beutaló. Amennyiben rendelkezik korábbi orvosi leletekkel (MRI, röntgen), kérjük, hozza magával.'
  },
  {
    q: 'Mit vigyek magammal az első alkalomra?',
    a: 'Korábbi orvosi leleteket, képalkotó vizsgálatokat (ha vannak), és kényelmes, mozgásra alkalmas ruházatot. Öltöző és mosdó is rendelkezésre áll.'
  },
  {
    q: 'Kaphatok otthoni gyakorlatokat?',
    a: 'Kifejezetten ösztönözzük az otthoni tornát! Minden páciensünk személyre szabott, írásos és/vagy videón rögzített gyakorlatsort kap, amelyet otthon is végezhet.'
  },
  {
    q: 'Melyik rendelőt válasszam?',
    a: 'Mindkét helyszínünkön olyan gyógytornászok dolgoznak, akik mindannyian részesültek McKenzie-képzésben. Válassza az Ön számára könnyebben megközelíthető rendelőt: Belváros (Sas u. 7.) vagy Bel-Buda (Bartók Béla út 34.).'
  },
  {
    q: 'Porckorongsérvvel is lehet gyógytornára jönni?',
    a: 'Igen. A porckorongsérv sok esetben műtét nélkül is kezelhető, de nem minden állapot alkalmas gyógytornára, ezt a vizsgálat dönti el. Ha az orvos nem lát sürgős műtéti okot, a McKenzie-vizsgálattal megnézhető, hogy a gyógytorna Önnek megfelelő-e. Ha vizelet- vagy székletürítési zavar, gáttáji zsibbadás vagy gyorsan erősödő izomgyengeség jelentkezik, ne gyógytornára jöjjön, hanem azonnal forduljon orvoshoz.'
  },
  {
    q: 'Mi a különbség a McKenzie-módszer és a hagyományos gyógytorna között?',
    a: 'A McKenzie-módszer egy részletes mozgásvizsgálattal kezdődik: ismételt mozgások és testhelyzetek alatt figyeljük, hogyan változik a fájdalom. Ebből derül ki, milyen gyakorlatok segíthetnek. A kezelés egyik célja, hogy a páciens megtanulja azokat a gyakorlatokat, amelyekkel otthon is segítheti a javulását.'
  },
  {
    q: 'Mi az a McKenzie-módszer?',
    a: 'A McKenzie-módszer hivatalos magyar nevén Mechanikai Diagnózis és Terápia (MDT): részletes mozgásvizsgálatra épülő gyógytorna gerinc- és végtagpanaszokra. Ismételt mozgásokkal és testhelyzetekkel megnézzük, hogyan változik a fájdalom, ebből áll össze az a gyakorlatsor, amelyet otthon egyedül is végezhet. A módszert Robin McKenzie új-zélandi gyógytornász fejlesztette ki.'
  },
  {
    q: 'Ülőmunka okozta nyak- és derékfájásra is érdemes jönni?',
    a: 'Igen. A vizsgálat megmutatja, mely testhelyzetek váltják ki a panaszt, és tartásjavító gyakorlatokat, ergonómiai tanácsokat is kap az íróasztali munkához.'
  },
  {
    q: 'Gyermeket is kezelnek?',
    a: 'Igen, gerincferdülés (Schroth-terápia) és gyermekkori tartáshibák esetén is. Időpontkéréskor jelezze, hogy gyermeknek kéri, és megfelelő terapeutát ajánlunk.'
  },
  {
    q: 'Fáj a kezelés?',
    a: 'A vizsgálat és a gyakorlatok alatt folyamatosan figyeljük, hogyan változik a fájdalma, és úgy választjuk meg a mozgásokat, hogy ne erősítsék a panaszt. Ha valami kellemetlen, szóljon, és módosítunk.'
  },
  {
    q: 'Mi van, ha le kell mondanom az időpontot?',
    a: 'Kérjük, legalább 24 órával korábban jelezze telefonon.'
  },
  {
    q: 'Beszélnek angolul vagy németül?',
    a: 'Igen, terapeutáink többsége beszél angolul, többen németül is. A Csapatunk oldalon minden terapeutánál feltüntetjük a nyelveket.'
  },
  {
    q: 'Mikor szükséges orvosi vizsgálat a gyógytorna előtt?',
    a: 'Azonnal forduljon orvoshoz, és ne gyógytornára jöjjön, ha vizelet- vagy székletürítési zavar, gáttáji zsibbadás, gyorsan erősödő izomgyengeség, láz vagy éjszaka is fennálló, nyugalomban sem csillapodó fájdalom jelentkezik. Súlyos sérülés vagy baleset után is előbb orvosi vizsgálat javasolt. Ha a fájdalom mechanikus jellegű (bizonyos mozgásoknál fokozódik, nyugalomban csökken), általában közvetlenül megkezdhető a gyógytorna.'
  }
];

// Schema.org FAQ
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
// Answers are plain text (they feed the FAQPage schema); the number becomes a call link when rendered.
const withPhoneLink = (t: string) => t.split(clinic.phoneDisplay).join(`<a href="tel:${clinic.phone}" class="underline underline-offset-4 whitespace-nowrap hover:text-[var(--color-teal-700)]">${clinic.phoneDisplay}</a>`);
---

<BaseLayout
  title="Gyakori kérdések | McKenzie Gyógytorna Rendelő Budapest"
  description="Válaszok a leggyakoribb kérdésekre a gyógytorna kezelésről, árakról, időpontfoglalásról és a McKenzie-módszerről."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Header -->
  <PageHeader eyebrow="Gyakori kérdések">
    <Fragment slot="title">Amit az első alkalom előtt kérdezni szoktak.</Fragment>
    Árak, beutaló, a kezelés hossza és menete, egészségpénztár.
  </PageHeader>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20 grid lg:grid-cols-12 gap-10">
    <aside class="lg:col-span-4">
      <div class="lg:sticky lg:top-28"><CtaCard label="Nem találja a választ?" title="Hívjon, és megválaszoljuk a kérdését." /></div>
    </aside>
    <div class="lg:col-span-8 border-t border-[var(--color-line)]">
      {faqs.map((faq, i) => (
        <details class="faq border-b border-[var(--color-line)]" open={i === 0}>
          <summary class="flex justify-between gap-6 py-6">
            <h2 class="font-heading text-[1.35rem] lg:text-[1.75rem] text-[var(--color-navy-900)]">{faq.q}</h2>
            <span class="plus text-[1.65rem] leading-none text-[var(--color-teal-600)]" aria-hidden="true">+</span>
          </summary>
          <p class="pb-7 -mt-1 text-[var(--color-ink-2)] leading-relaxed measure" set:html={withPhoneLink(faq.a)} />
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
